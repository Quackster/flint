// sort_lib: the std.Sort class (import std.Sort) — in-place array
// sorting plus array queries. Sorting is done on the array itself.
import std.Sort;

int main() {
    int a[] = [5, 2, 9, 1, 7];
    Sort.sort(a);
    print(a[0]); print(" ");
    print(a[1]); print(" ");
    println(a[4]);            // 1 2 9

    int d[] = [3, 8, 1, 6];
    Sort.sortDesc(d);
    print(d[0]); print(" ");
    println(d[3]);            // 8 1

    int q[] = [4, 9, 2, 7];
    print(Sort.min(q)); print(" ");      // 2
    print(Sort.max(q)); print(" ");      // 9
    print(Sort.sum(q)); print(" ");      // 22
    print(Sort.avg(q)); print(" ");      // 5
    print(Sort.contains(q, 7)); print(" "); // 1
    print(Sort.contains(q, 8)); print(" "); // 0
    print(Sort.indexOf(q, 9)); print(" "); // 1
    print(Sort.count(q, 4)); print(" ");  // 1
    println(Sort.argmax(q));   // 1

    // binarySearch needs a sorted array
    int s[] = [1, 3, 5, 7, 9];
    print(Sort.binarySearch(s, 7)); print(" "); // 3
    println(Sort.binarySearch(s, 8)); // -1 (not found)
    return 0;
}
