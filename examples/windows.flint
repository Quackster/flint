// windows: clicking a button opens a second window, and clicking
// another closes it again.
// Build:
//   flintc src/stdlib/widget.flint src/stdlib/gui.flint src/stdlib/image.flint src/stdlib/math.flint src/stdlib/checksum.flint examples/windows.flint -o windows
// Without a Wayland compositor (e.g. headless) it prints "no display"
// and exits. On a desktop it shows a 480x200 window with Open and
// Close buttons: Open opens a second window, Close closes it (Open
// can open a new one). Press Escape to quit (or close the app from
// the compositor).
import std.Window;
import std.Gui;
import std.Image;

int main() {
    Window w = Window.open(480, 200, "flint windows");
    if (w == null) {
        print("no display\n");
        return 0;
    }
    print("opened ok\n");
    Gui gui = new Gui(w);
    Label title = new Label(16, 12, 240, 16, "Flint windows");
    Button openBtn = new Button(16, 48, 120, 30, "Open");
    Button closeBtn = new Button(150, 48, 120, 30, "Close");
    Label status = new Label(16, 100, 448, 16, "window 2: closed");
    gui.addLabel(title);
    gui.addButton(openBtn);
    gui.addButton(closeBtn);
    gui.addLabel(status);
    Window w2 = null;
    Image c2 = null;
    int open2 = 0;
    Image c = new Image(480, 200);
    while (w.running() && gui.running() == 1) {
        gui.step();
        if (w.evType() == Window.KEY() && w.evState() == 1
                && Window.keyChar(w.evKey()) == 27) {
            return 0;   // Escape quits
        }
        if (openBtn.clicked() == 1) {
            openBtn.clearClicked();
            if (open2 == 0) {
                w2 = Window.open(360, 200, "flint window 2");
                if (w2 != null) {
                    open2 = 1;
                    c2 = new Image(360, 200);
                    c2.fill(Image.rgb(16, 16, 32));
                    c2.text(16, 80, "Hello from window 2", 0xFFFFFFFF);
                    print("window 2 opened\n");
                }
            }
        }
        if (closeBtn.clicked() == 1) {
            closeBtn.clearClicked();
            if (open2 == 1) {
                w2.close();
                open2 = 0;
                status.setText("window 2: closed");
                print("window 2 closed\n");
            }
        }
        // Pump and present window 2: its own events (e.g. the close
        // button) and its frames are independent of window 1.
        if (open2 == 1) {
            if (w2.running() == 0) {
                open2 = 0;
                status.setText("window 2: closed");
                print("done.\n");
            } else {
                int e2 = 0;
                while (e2 != 0) {
                    e2 = w2.peekEvent();
                }
                if (w2.width() != c2.w || w2.height() != c2.h) {
                    c2 = new Image(w2.width(), w2.height());
                    c2.fill(Image.rgb(16, 16, 32));
                    c2.text(16, 80, "Hello from window 2", 0xFFFFFFFF);
                }
                w2.present(c2);
            }
        }
        c.fill(Image.rgb(16, 16, 32));
        gui.draw(c);
        w.present(c);
    }
    print("done.\n");
    return 0;
}
