// file_copy: copy the contents of one file to another via std.File.
//
//   $ flintc src/stdlib/file.flint examples/file_copy.flint -o file_copy && ./file_copy
import std.File;

int main() {
    string from = "/tmp/flintc_copy_src.txt";
    string to = "/tmp/flintc_copy_dst.txt";

    // write a known payload to the source file first
    File.write_all(from, "the quick brown fox");

    // copy src -> dst
    File.copy(from, to);

    // verify by reading dst back and printing it
    string data = File.read_all(to);
    if (data != null) {
        print(data);
    }
    print("\n");
    return 0;
}
