// list_life: the full List lifecycle. Every operation, both flavours
// (int and string elements), built up with add() (the stdlib has no
// literals — a collection is grown one element at a time).
// Build: flintc src/stdlib/coll.flint src/stdlib/mem.flint examples/list_life.flint -o list_life
import std.List;
int main() {
    // construction: add() one at a time
    List<int> l = new List<int>();
    l.add(10); l.add(20); l.add(30);
    List<int> e = new List<int>();
    print(e.size());             // 0
    print("\n");
    // add / get / set / size
    l.add(40);
    print(l.size());            // 4
    print("\n");
    print(l.get(1));           // 20
    print("\n");
    l.set(0, 99);
    print(l.get(0));           // 99
    print("\n");
    // contains: int compare; string content compare
    print(l.contains(20));     // 1
    print("\n");
    print(l.contains(77));     // 0
    print("\n");
    // insert at an index (tail shifts right; i >= size appends)
    l.insert(1, 5);
    print(l.size());          // 5
    print("\n");
    print(l.get(1));         // 5
    print("\n");
    print(l.get(2));         // 20 (was shifted)
    print("\n");
    // remove(i): tail shifts left; no-op when i >= size
    l.remove(0);
    print(l.get(0));         // 5
    print("\n");
    print(l.size());         // 4
    print("\n");
    // sort (signed int ascending) and reverse
    l.sort();
    print(l.get(0));         // 5
    print("\n");
    print(l.get(3));         // 40
    print("\n");
    l.reverse();
    print(l.get(0));         // 40
    print("\n");
    // join: ints via itoa, strings verbatim
    string j = l.join("-");
    print(j);               // 40-30-20-5
    print("\n");
    // clear
    l.clear();
    print(l.size());         // 0
    print("\n");
    // string elements (kind = 1): sort by content, join verbatim
    List<string> s = new List<string>();
    s.add("b");
    s.add("a");
    s.add("c");
    print(s.contains("a"));   // 1 (content compare)
    print("\n");
    print(s.contains("z"));   // 0
    print("\n");
    s.sort();
    print(s.join("|"));       // a|b|c
    print("\n");
    // int list
    List<int> t = new List<int>();
    t.add(7); t.add(8); t.add(9);
    print(t.size());         // 3
    print("\n");
    print(t.get(2));       // 9
    print("\n");
    return 0;
}
