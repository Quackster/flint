// list_life: the full list lifecycle. Every operation, both flavours
// (int and string elements), plus construction forms and typed lists.
// Layout: [rc][len][cap][data ptr][elem_release]; cap grows by doubling.
int main() {
    // construction: [] literal and new list()
    list l = [10, 20, 30];
    list e = new list();
    printi(len(e));              // 0
    print("\n");
    // add / get / index / size
    l.add(40);
    printi(len(l));            // 4
    print("\n");
    printi(l.get(1));         // 20
    print("\n");
    l[0] = 99;
    printi(l[0]);             // 99
    print("\n");
    // contains: int compare; string content compare
    printi(l.contains(20));   // 1
    print("\n");
    printi(l.contains(77));   // 0
    print("\n");
    // insert at an index (tail shifts right; i >= len appends)
    l.insert(1, 5);
    printi(len(l));          // 5
    print("\n");
    printi(l.get(1));       // 5
    print("\n");
    printi(l.get(2));       // 20 (was shifted)
    print("\n");
    // remove(i): tail shifts left; no-op when i >= len
    l.remove(0);
    printi(l.get(0));       // 5
    print("\n");
    printi(len(l));         // 4
    print("\n");
    // sort (signed int ascending) and reverse
    l.sort();
    printi(l.get(0));       // 5
    print("\n");
    printi(l.get(3));       // 40
    print("\n");
    l.reverse();
    printi(l.get(0));       // 40
    print("\n");
    // join: ints via itoa, strings verbatim
    string j = l.join("-");
    print(j);               // 40-30-20-5
    print("\n");
    // clear
    l.clear();
    printi(len(l));         // 0
    print("\n");
    // string elements: sort by content, join verbatim
    list<string> s = new list<string>();
    s.add("b");
    s.add("a");
    s.add("c");
    printi(s.contains("a"));   // 1 (content compare)
    print("\n");
    printi(s.contains("z"));   // 0
    print("\n");
    s.sort();
    print(s.join("|"));       // a|b|c
    print("\n");
    // typed list with a constructor seed
    list<int> t = new list<int>(7, 8, 9);
    printi(len(t));          // 3
    print("\n");
    printi(t.get(2));       // 9
    print("\n");
    return 0;
}
