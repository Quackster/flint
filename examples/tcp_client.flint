// tcp_client: connects to the tcp_server on 127.0.0.1:7777 via std.Socket,
// sends a message, and prints the echoed reply.
//
//   $ flintc src/stdlib/net.flint examples/tcp_client.flint -o tcp_client && ./tcp_client
import std.Socket;

int main() {
    int s = Socket.connectHost(127, 0, 0, 1, 7777);
    Socket.sendAll(s, "hello");
    string reply = Socket.recv(s);
    if (reply != null) {
        print(reply);
    }
    print("\n");
    Socket.close(s);
    return 0;
}
