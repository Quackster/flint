// scope: function-level variables. A new `Type name` declaration inside an
// inner block re-declares the SAME variable, overwriting it (there is no
// block-level shadowing); the new value persists after the block ends.
int main() {
    int v = 10;
    if (1) {
        int v = 20;          // re-declares v
        printi(v);         // 20
    }
    printi(v);             // 20 (the re-declaration persists)
    print("\n");
    int total = 0;
    for (int i = 0; i < 3; i = i + 1) {
        int i = 100;        // overwrites the loop variable's slot
        total = total + i;
    }
    printi(total);         // 100 (loop ends after one round: i becomes 101)
    print("\n");
    // range-for: the desugared index loop still iterates every element
    // even when the element variable is re-declared inside the body
    int a[] = [1, 2, 3, 4];
    int u = 0;
    for (int x : a) {
        int x = 100;
        u = u + x;
    }
    printi(u);             // 400 (4 elements, each read as 100)
    print("\n");
    return 0;
}
