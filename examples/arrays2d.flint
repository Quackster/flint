// arrays: arrays are heap blocks of 8-byte slots with a length header
// ([len][elem0][elem1]...); they pass by pointer. len(a) reads the
// header. Arrays can be class fields, can be array-literal call
// arguments, and functions can return fresh arrays. No bounds checks
// in v1.
class Grid {
    int data[];
    public Grid(int d[]) {
        this.data = d;
    }
    public int max3() {
        int m = this.data[0];
        int i = 1;
        while (i < 3) {
            if (this.data[i] > m) {
                m = this.data[i];
            }
            i = i + 1;
        }
        return m;
    }
}

int sum3(int a[]) {             // arrays pass by pointer
    return a[0] + a[1] + a[2];
}

int make() {                   // returns a fresh array
    return [7, 8, 9];
}

int main() {
    int a[] = [10, 20, 30];
    a[1] = 25;
    printi(len(a));              // 3
    print("\n");
    printi(sum3(a));            // 65 (mutated through the pointer)
    print("\n");
    int r[] = make();
    printi(r[0] + r[2]);        // 16
    print("\n");
    // array literal as a constructor argument
    Grid g = new Grid([5, 6, 7]);
    printi(g.max3());           // 7
    print("\n");
    a[0] = 100;
    printi(sum3(a));            // 155 (alias mutates the same block)
    print("\n");
    return 0;
}
