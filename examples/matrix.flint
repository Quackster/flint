// matrix: multi-dimensional arrays. `int g[][]` is a 2-D grid; `a[i][j]`
// chains the index. Range-for `for (int r[] : g)` iterates the rows; a
// nested range-for then iterates the elements of each row.
int main() {
    int g[][] = [[1, 2, 3], [4, 5, 6]];
    printi(g[0][0]);             // 1
    printi(g[1][2]);            // 6
    print("\n");
    // sum every element through the row range-for
    int t = 0;
    for (int r[] : g) {
        for (int y : r) {
            t = t + y;
        }
    }
    printi(t);                 // 21
    print("\n");
    // transpose in place (2x3 -> 3x2)
    int out[][] = [[0, 0, 0], [0, 0, 0], [0, 0, 0]];
    int i = 0;
    while (i < 2) {
        int j = 0;
        while (j < 3) {
            out[j][i] = g[i][j];
            j = j + 1;
        }
        i = i + 1;
    }
    // print the transposed 3x2 grid
    i = 0;
    while (i < 3) {
        int j = 0;
        while (j < 2) {
            printi(out[i][j]);
            if (j + 1 < 2) {
                print(" ");
            }
            j = j + 1;
        }
        print("\n");
        i = i + 1;
    }
    return 0;
}
