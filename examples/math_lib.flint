// math_lib: a tour of the std.Math class (import std.Math).
// Integer helpers plus a little fixed-point (Q48.16) work.
import std.Math;

int main() {
    // ---- integer helpers ----
    printi(Math.abs(-7)); print(" ");      // 7
    printi(Math.min(3, 9)); print(" ");   // 3
    printi(Math.max(3, 9)); print(" ");   // 9
    printi(Math.gcd(48, 18)); print(" "); // 6
    printi(Math.lcm(4, 6)); print(" ");   // 12
    printi(Math.factorial(5)); print(" "); // 120
    printi(Math.is_prime(97)); print(" "); // 1
    printi(Math.sqrt(81)); print(" ");     // 9
    printi(Math.pow(2, 10)); print(" ");  // 1024
    printi(Math.fib(10)); print("\n");     // 55

    // ---- fixed-point (Q48.16) ----
    // math.itof lifts an int into Q48.16; math.ftoi lowers it back.
    int f = math.itof(7);
    printi(math.ftoi(f)); print(" ");      // 7
    // fround rounds half up; 1.5 -> 2, 1.4 -> 1.
    printi(Math.fround(math.itof(1) + math.itof(1))); print(" "); // 2 (2.0)
    // fsqrt of 25.0 -> 5.0 -> ftoi 5.
    printi(math.ftoi(Math.fsqrt(math.itof(25)))); print(" "); // 5
    // ffloor of 1.9 -> 1, fceil of 1.1 -> 2.
    printi(Math.ffloor(math.itof(1) + math.itof(1))); print(" "); // 2
    printi(math.ftoi(Math.fabs(math.itof(0) - math.itof(3)))); print("\n"); // 3
    return 0;
}
