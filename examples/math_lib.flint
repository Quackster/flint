// math_lib: a tour of the std.Math class (import std.Math).
// Integer helpers plus a little fixed-point (Q48.16) work.
import std.Math;

int main() {
    // ---- integer helpers ----
    print(Math.abs(-7)); print(" ");      // 7
    print(Math.min(3, 9)); print(" ");   // 3
    print(Math.max(3, 9)); print(" ");   // 9
    print(Math.gcd(48, 18)); print(" "); // 6
    print(Math.lcm(4, 6)); print(" ");   // 12
    print(Math.factorial(5)); print(" "); // 120
    print(Math.isPrime(97)); print(" "); // 1
    print(Math.sqrt(81)); print(" ");     // 9
    print(Math.pow(2, 10)); print(" ");  // 1024
    println(Math.fib(10));     // 55

    // ---- fixed-point (Q48.16) ----
    // math.itof lifts an int into Q48.16; math.ftoi lowers it back.
    int f = math.itof(7);
    print(math.ftoi(f)); print(" ");      // 7
    // fround rounds half up; 1.5 -> 2, 1.4 -> 1.
    print(Math.fround(math.itof(1) + math.itof(1))); print(" "); // 2 (2.0)
    // fsqrt of 25.0 -> 5.0 -> ftoi 5.
    print(math.ftoi(Math.fsqrt(math.itof(25)))); print(" "); // 5
    // ffloor of 1.9 -> 1, fceil of 1.1 -> 2.
    print(Math.ffloor(math.itof(1) + math.itof(1))); print(" "); // 2
    println(math.ftoi(Math.fabs(math.itof(0) - math.itof(3)))); // 3
    return 0;
}
