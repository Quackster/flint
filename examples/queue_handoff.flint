// queue_handoff: Queue is a FIFO ring buffer (head over its slot
// array). push enqueues at the tail (doubling when full); pop/peek
// return the front value, or 0 when empty.
// Build: flintc src/stdlib/coll.flint src/stdlib/mem.flint examples/queue_handoff.flint -o queue_handoff
import std.Queue;
int next_cmd(Queue q) {
    return q.pop();
}

int main() {
    // built up with push()
    Queue q = new Queue();
    q.push(10); q.push(20); q.push(30);
    printi(q.size());             // 3
    print("\n");
    // peek: front without removing
    printi(q.peek());           // 10
    print("\n");
    // pop: FIFO order
    printi(q.pop());           // 10
    print("\n");
    printi(q.pop());           // 20
    print("\n");
    // push after pops; the ring wraps
    q.push(40);
    printi(q.peek());           // 30
    print("\n");
    printi(q.size());          // 2
    print("\n");
    // pop on the (now) empty queue returns 0
    q.pop();                   // 30
    q.pop();                   // 40
    printi(q.pop());           // 0 (empty)
    print("\n");
    printi(q.peek());           // 0 (empty)
    print("\n");
    // a producer/consumer hand-off through a function
    Queue jobs = new Queue();
    jobs.push(111);
    jobs.push(222);
    printi(next_cmd(jobs));   // 111 (consumed in FIFO order)
    print("\n");
    printi(next_cmd(jobs));   // 222
    print("\n");
    // string elements (kind = 1)
    Queue names = new Queue();
    names.kind = 1;
    names.push("in");
    names.push("out");
    string n1 = names.pop();
    string n2 = names.pop();
    print(n1);               // in
    print(" ");
    print(n2);               // out
    print("\n");
    // clear
    jobs.clear();
    printi(jobs.size());     // 0
    print("\n");
    return 0;
}
