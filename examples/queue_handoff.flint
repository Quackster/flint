// queue_handoff: queue is a FIFO ring buffer (head/cap mask layout).
// push enqueues at the tail (doubling when full); pop/peek return the
// front value, or 0 when empty. Construction: new queue() or
// new queue(a, b, c) with initial elements.
int next_cmd(queue q) {
    return q.pop();
}

int main() {
    // construction with initial elements
    queue q = new queue(10, 20, 30);
    printi(len(q));             // 3
    print("\n");
    // peek: front without removing
    printi(q.peek());         // 10
    print("\n");
    // pop: FIFO order
    printi(q.pop());          // 10
    print("\n");
    printi(q.pop());          // 20
    print("\n");
    // push after pops; the ring wraps
    q.push(40);
    printi(q.peek());         // 30
    print("\n");
    printi(len(q));          // 2
    print("\n");
    // pop on the (now) empty queue returns 0
    q.pop();                  // 30
    q.pop();                  // 40
    printi(q.pop());         // 0 (empty)
    print("\n");
    printi(q.peek());         // 0 (empty)
    print("\n");
    // a producer/consumer hand-off through a function
    queue jobs = new queue();
    jobs.push(111);
    jobs.push(222);
    printi(next_cmd(jobs));   // 111 (consumed in FIFO order)
    print("\n");
    printi(next_cmd(jobs));   // 222
    print("\n");
    // string elements
    queue<string> names = new queue<string>();
    names.push("in");
    names.push("out");
    string n1 = names.pop();
    string n2 = names.pop();
    print(n1);               // in
    print(" ");
    print(n2);               // out
    print("\n");
    // clear
    jobs.clear();
    printi(len(jobs));       // 0
    print("\n");
    return 0;
}
