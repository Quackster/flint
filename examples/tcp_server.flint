// tcp_server: a simple TCP echo server on 0.0.0.0:7777 via std.Socket.
// Accepts connections in a loop, reads a message, and echoes it back.
//
//   $ flintc src/stdlib/net.flint examples/tcp_server.flint -o tcp_server && ./tcp_server
import std.Socket;

int main() {
    int s = Socket.stream();
    Socket.bind_port(s, 7777);
    Socket.listen(s, 5);
    while (1) {
        int c = Socket.accept(s);
        if (c < 0) {
            break;
        }
        string msg = Socket.recv(c);
        while (msg != null) {
            Socket.send_all(c, msg);
            msg = Socket.recv(c);
        }
        Socket.close(c);
    }
    Socket.close(s);
    return 0;
}
