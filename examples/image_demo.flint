// image_demo: the std.Image class (import std.Image) — pixel buffers,
// drawing, transforms, and multi-format I/O. Output is stable 1/0
// checks (pixel values are verified, not the timestamp or filename).
import std.Image;

int main() {
    // A 64x64 RGBA image (4 bytes/pixel, row-major).
    Image im = new Image(64, 64);
    im.fill(Image.rgb(255, 0, 0));            // solid red
    im.fill_circle(32, 32, 20, Image.rgb(0, 255, 0)); // green filled disc
    // The centre is inside the disc -> green; a corner is red.
    int centre = im.get(32, 32);
    int corner = im.get(0, 0);
    printi(Image.cg(centre) > 200 ? 1 : 0); print(" "); // 1 (green centre)
    printi(Image.cr(corner) > 200 ? 1 : 0); print(" "); // 1 (red corner)

    // Grayscale then rotate 90 (dims swap for non-square? 64x64 stays 64x64).
    im.grayscale();
    im.rotate90();
    // After grayscale, all channels are equal; verify.
    int p = im.get(10, 10);
    printi(Image.cr(p) == Image.cb(p) ? 1 : 0); print(" "); // 1

    // Save as BMP (returns the byte count written), load it back, and
    // check a pixel survived the round-trip.
    int r = im.save("/tmp/flint_image_demo.bmp");
    printi(r > 0 ? 1 : 0); print(" ");                    // 1 (saved ok)
    Image back = Image.load("/tmp/flint_image_demo.bmp");
    printi(back != null ? 1 : 0); print(" ");             // 1 (loaded)
    printi(Image.cr(back.get(10, 10)) == Image.cr(p) ? 1 : 0); print("\n"); // 1

    // scale() returns a new image (nearest-neighbor).
    Image big = im.scale(32, 32);
    printi(big != null ? 1 : 0); print("\n");             // 1
    return 0;
}
