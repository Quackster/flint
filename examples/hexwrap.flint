// hexwrap: 0x literals are parsed as unsigned 64-bit values and stored in a
// two's-complement slot. Values up to 0x7FFFFFFFFFFFFFFF stay positive;
// values from 0x8000000000000000 up wrap negative (0xFFFF...FF = -1).
int main() {
    int a = 0xFFFFFFFFFFFFFFFF;
    print(a);                        // -1 (all 64 bits set)
    print("\n");
    int b = 0x7FFFFFFFFFFFFFFF;
    print(b > 0 ? 1 : 0);          // 1 (i64 max stays positive)
    print("\n");
    int c = 0x8000000000000000;
    print(c < 0 ? 1 : 0);         // 1 (i64 min, wraps negative)
    print("\n");
    int d = 0xFFFFFFFF;
    print(d);                      // 4294967295 (fits positive; no wrap)
    print("\n");
    int e = 0x10;
    print(e);                     // 16
    print("\n");
    // wrapped values behave like any other int
    print(a + 1);                 // 0 (two's complement wrap)
    print("\n");
    return 0;
}
