// typed_coll: stdlib collections are generic — the element flavour
// (0 int, 1 string, 2 object) is derived from the type argument
// (List<string>, HashMap<string, int>, ...). The flavour drives
// hashing, compare, sort and join, and the retain/release of object
// elements.
// Build: flintc src/stdlib/coll.flint src/stdlib/mem.flint examples/typed_coll.flint -o typed_coll
import std.List;
import std.Queue;
import std.HashSet;
import std.HashMap;
int main() {
    // int list
    List<int> t = new List<int>();
    t.add(7); t.add(8); t.add(9);
    printi(t.size());             // 3
    print("\n");
    printi(t.get(2));            // 9
    print("\n");
    t.add(10);
    printi(t.get(3));           // 10
    print("\n");
    // string list
    List<string> names = new List<string>();
    names.add("flint");
    names.add("c");
    names.add("rust");
    names.sort();
    print(names.join(","));       // c,flint,rust
    print("\n");
    // int set
    HashSet<int> seen = new HashSet<int>();
    printi(seen.add(5));        // 1
    print("\n");
    printi(seen.add(5));        // 0 (duplicate)
    print("\n");
    printi(seen.size());        // 1
    print("\n");
    // string queue
    Queue<string> q = new Queue<string>();
    q.push("a");
    q.push("b");
    print(q.pop());            // a (FIFO)
    print("\n");
    // map: string key, int value
    HashMap<string, int> scores = new HashMap<string, int>();
    scores.put("a", 15);
    scores.put("b", 20);
    printi(scores.get("b"));   // 20
    print("\n");
    printi(scores.size());     // 2
    print("\n");
    return 0;
}
