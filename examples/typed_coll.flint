// typed_coll: stdlib collections pin the element flavour in a field
// (kind on List/Queue/Hashset, kkind/vkind on Hashmap): 0 int,
// 1 string, 2 object. The flavour drives hashing, compare, sort and
// join, and the retain/release of object elements.
// Build: flintc src/stdlib/coll.flint src/stdlib/mem.flint examples/typed_coll.flint -o typed_coll
import std.List;
import std.Queue;
import std.Hashset;
import std.Hashmap;
int main() {
    // int list
    List t = new List();
    t.add(7); t.add(8); t.add(9);
    printi(t.size());             // 3
    print("\n");
    printi(t.get(2));            // 9
    print("\n");
    t.add(10);
    printi(t.get(3));           // 10
    print("\n");
    // string list (kind = 1)
    List names = new List();
    names.kind = 1;
    names.add("flint");
    names.add("c");
    names.add("rust");
    names.sort();
    print(names.join(","));       // c,flint,rust
    print("\n");
    // int set
    Hashset seen = new Hashset();
    printi(seen.add(5));        // 1
    print("\n");
    printi(seen.add(5));        // 0 (duplicate)
    print("\n");
    printi(seen.size());        // 1
    print("\n");
    // string queue (kind = 1)
    Queue q = new Queue();
    q.kind = 1;
    q.push("a");
    q.push("b");
    print(q.pop());            // a (FIFO)
    print("\n");
    // map: string key, int value
    Hashmap scores = new Hashmap();
    scores.kkind = 1;
    scores.put("a", 15);
    scores.put("b", 20);
    printi(scores.get("b"));   // 20
    print("\n");
    printi(scores.size());     // 2
    print("\n");
    return 0;
}
