// window_demo: the std.Window class (import std.Window) — a window with an
// RGBA canvas, drawing primitives, a 5x7 font, and two backends
// (0 = framebuffer, 1 = X11). The canvas is always available even when the
// backend cannot open (e.g. no /dev/fb), so the checks below are stable.
import std.Window;
import std.Image;

int main() {
    // 128x64 window, framebuffer backend. Opening may fail on headless
    // hosts; the canvas still works, so we verify the canvas, not ok().
    Window w = new Window(128, 64, 0);
    printi(w.width() == 128 ? 1 : 0); print(" ");  // 1
    printi(w.height() == 64 ? 1 : 0); print(" ");  // 1

    // Clear to a solid background, then paint a filled disc and a frame.
    w.clear();
    w.fill(0x00101020);
    w.fill_circle(64, 32, 20, 0x0000FF00);        // green disc
    w.rect(2, 2, 123, 59, 0x00FF0000);            // red frame
    int centre = w.get(64, 32);
    int corner = w.get(2, 2);
    printi((centre >> 8) & 0xFF > 200 ? 1 : 0); print(" ");  // 1 (green centre, G=255)
    printi((corner >> 16) & 0xFF > 200 ? 1 : 0); print(" "); // 1 (red frame corner, R=255)

    // Draw text (5x7 font, 6 px advance per glyph).
    w.text(10, 10, "FLINT", 0x00FFFFFF);
    // 'F' row0 = 11111 sets cols 0-4, so (10,10) is the first glyph's top row.
    printi(w.get(10, 10) != 0 ? 1 : 0); print(" ");      // 1 (text pixel set)
    int tw = w.text(10, 20, "hi", 0x00FFFFFF);
    printi(tw == 12 ? 1 : 0); print(" ");               // 1 (2 glyphs * 6 px)

    // Blit an image (alpha-tested) onto the canvas.
    Image im = new Image(8, 8);
    im.set(0, 0, 0xFF0000FF);
    im.set(7, 7, 0xFFFF0000);
    w.clear();
    w.blit(40, 40, im);
    printi(w.get(40, 40) == 0xFF0000FF ? 1 : 0); print(" "); // 1
    printi(w.get(47, 47) == 0xFFFF0000 ? 1 : 0); print(" "); // 1
    printi(w.get(41, 41) == 0 ? 1 : 0); print("\n");         // 1 (transparent)
    return 0;
}
