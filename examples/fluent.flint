// fluent: a method that returns `this` makes calls chainable, so
// p.move(1, 1).scale(2).sum() runs left to right on the same object.
class Point {
    int x;
    int y;
    public Point(int a, int b) {
        this.x = a;
        this.y = b;
    }
    public Point move(int dx, int dy) {
        this.x = this.x + dx;
        this.y = this.y + dy;
        return this;          // enables chaining
    }
    public Point scale(int k) {
        this.x = this.x * k;
        this.y = this.y * k;
        return this;
    }
    public int sum() {
        return this.x + this.y;
    }
}

int main() {
    Point p = new Point(1, 2);
    print(p.sum());                          // 3
    print("\n");
    print(p.move(1, 1).sum());              // 5 (chained call)
    print("\n");
    print(p.move(2, 2).scale(10).sum());   // (4*10)+(5*10) = 90
    print("\n");
    return 0;
}
