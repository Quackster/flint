// multifile/main.flint — uses the Stats class from util.flint.
// This file has no `package` clause (it is the entry point).
import demo.stats.Stats;
import std.List;

int main() {
    List<int> xs = new List<int>();
    xs.add(4);
    xs.add(9);
    xs.add(1);
    xs.add(7);
    print(Stats.sum(xs)); print(" ");   // 21
    print(Stats.max(xs)); print(" ");   // 9
    println(Stats.mean(xs)); // 5
    return 0;
}
