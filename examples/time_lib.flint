// time_lib: the std.Time class (import std.Time) — clock access.
// The actual timestamps are not printed (they vary every run); instead
// we print stable 1/0 checks that the clock is sane.
import std.Time;

int main() {
    // millis() is monotonic increasing; two reads should differ by >= 0.
    int m1 = Time.millis();
    int m2 = Time.millis();
    print(m2 >= m1 ? 1 : 0); print(" ");      // 1
    // seconds() should be a plausible magnitude (year 2000..3000).
    int s = Time.seconds();
    print(s > 1000000000 && s < 100000000000 ? 1 : 0); print(" "); // 1
    // nanos() is a large positive value.
    print(Time.nanos() > 0 ? 1 : 0); print(" "); // 1
    // date() returns "YYYY-MM-DD HH:MM:SS" (19 chars); check the length
    // only, to stay deterministic.
    string d = Time.date();
    println(strlen(d) == 19 ? 1 : 0); // 1
    return 0;
}
