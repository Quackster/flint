// strings: NUL-terminated byte sequences, passed and stored by pointer.
// `string + int` is POINTER arithmetic (an offset), not concatenation;
// `+` of two strings concatenates. `(string)N` is a fresh single-char
// string for byte value N. A literal stored into a string variable is a
// fresh writable copy: `w[0] = 65` writes an 8-byte little-endian slot,
// yielding "A" (0x41 00 ...). For multi-char builds, concatenate
// single-char strings: `(string)65 + (string)66` is "AB".
int main() {
    // pointer arithmetic: offset into the byte sequence
    string p = "hello";
    print(sys.byteLoad(p + 1));  // 101 ('e')
    print("\n");
    print(strlen(p));             // 5
    print("\n");
    // concatenation with + of two strings
    string s = "hello" + " world";
    print(s);                     // hello world
    print("\n");
    print(strlen(s));            // 11
    print("\n");
    // (string)N single-char construction, then concatenate
    string c = (string)72;         // 'H'
    print(c + (string)73);        // HI
    print("\n");
    // writable literal copy: the 8-byte slot write yields "A"
    string w = "";
    w[0] = 65;
    print(w);                    // A
    print("\n");
    // multi-char construction: concatenate single-char strings
    string m = (string)65 + (string)66;   // AB
    print(m);                    // AB
    print("\n");
    print(str.cmp(m, "AB") == 0 ? 1 : 0);  // 1
    print("\n");
    // str.* builtin tour
    string cc = str.concat("ab", "cd");
    print(str.cmp(cc, "abcd") == 0 ? 1 : 0);   // 1
    print("\n");
    string ci = str.concati("answer: ", 42);
    print(str.cmp(ci, "answer: 42") == 0 ? 1 : 0);  // 1
    print("\n");
    print(conv.atoi(str.itoa(-17)) == -17 ? 1 : 0);  // 1
    print("\n");
    string cp = str.copy("same");
    print(str.cmp(cp, "same") == 0 ? 1 : 0);   // 1
    print("\n");
    string sub = str.substring("hello world", 6, 5);
    print(str.cmp(sub, "world") == 0 ? 1 : 0);   // 1
    print("\n");
    print(str.indexOf("hello world", "world"));  // 6
    print("\n");
    string rp = str.replace("aaa", "a", "b");
    print(str.cmp(rp, "bbb") == 0 ? 1 : 0);   // 1 (all occurrences)
    print("\n");
    return 0;
}
