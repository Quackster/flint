// window_gui: open a real on-screen X11 window with interactive widgets and
// hold it open so you can click / type in it.
//
// Build & run:
//   flintc src/stdlib/*.flint examples/window_gui.flint -o /tmp/gui && /tmp/gui
//
// Requires a working X server ($DISPLAY). It shows a label, a button, a
// checkbox and a text box. Click the button, tick the checkbox, and click the
// text box then type. The window closes when you click its title-bar X
// (ClientMessage) or after you press Enter in the text box.
import std.Window;
import std.Gui;
import std.Sync;

int main() {
    print("opening X11 window (backend 1)...\n");
    Window w = new Window(320, 200, 1);
    if (w.ok() == 0) {
        print("could not open the X11 window (err=");
        printi(w.err());
        print(")\n");
        return 1;
    }
    print("window open; building widgets...\n");

    Gui gui = new Gui(w);
    Label title = new Label(16, 12, 200, 16, "Flint std.Gui demo");
    Button button = new Button(16, 44, 130, 30, "Click me");
    CheckBox check = new CheckBox(16, 90, 160, 24, "Enable option");
    TextBox box = new TextBox(16, 130, 200, 30, 32);
    gui.add_label(title);
    gui.add_button(button);
    gui.add_check(check);
    gui.add_box(box);

    int clicks = 0;
    print("interacting; click the button, tick the box, type in the field...\n");
    while (gui.running() == 1) {
        gui.step();
        if (button.clicked() == 1) {
            clicks = clicks + 1;
            button.clear_clicked();
            print("button clicked (total ");
            printi(clicks);
            print(")\n");
        }
        if (box.entered() == 1) {
            print("text box: [");
            print(box.text());
            print("]\n");
            box.clear_entered();
            gui.running_set(0);   // stop after Enter
        }
        w.clear();
        w.fill(0x00101020);
        gui.draw();
        w.refresh();
        Sync.nanosleep(0, 10000000);   // ~10 ms, avoid a busy loop
    }
    print("done. checkbox was ");
    printi(check.checked());
    print("\n");
    return 0;
}
