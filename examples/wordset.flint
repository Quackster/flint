// wordset: Hashset deduplicates a stream of values. add returns 1 when
// inserted and 0 when already present; contains matches by value
// (string content compare); remove leaves a tombstone; the bucket array
// rehashes (doubles) when the load factor is reached.
// Build: flintc src/stdlib/coll.flint src/stdlib/mem.flint examples/wordset.flint -o wordset
import std.Hashset;
int main() {
    Hashset s = new Hashset();
    // int elements: duplicates collapse
    printi(s.add(5));        // 1 (inserted)
    print("\n");
    printi(s.add(10));      // 1
    print("\n");
    printi(s.add(15));      // 1
    print("\n");
    printi(s.add(10));      // 0 (already present)
    print("\n");
    printi(s.size());       // 3
    print("\n");
    printi(s.contains(10)); // 1
    print("\n");
    printi(s.contains(99)); // 0
    print("\n");
    // remove (tombstone) then re-add
    printi(s.remove(10));   // 1 (removed)
    print("\n");
    printi(s.contains(10)); // 0
    print("\n");
    printi(s.size());       // 2
    print("\n");
    printi(s.add(10));      // 1 (re-inserted over the tombstone slot)
    print("\n");
    printi(s.size());       // 3
    print("\n");
    // string elements (kind = 1): content dedup of a word stream
    Hashset words = new Hashset();
    words.kind = 1;
    words.add("the");
    words.add("quick");
    words.add("brown");
    words.add("fox");
    words.add("the");        // duplicate
    words.add("quick");      // duplicate
    printi(words.size());     // 4 (unique)
    print("\n");
    printi(words.contains("fox")); // 1
    print("\n");
    printi(words.contains("dog")); // 0
    print("\n");
    // built up with add() (no literals in the stdlib world)
    Hashset lit = new Hashset();
    lit.add(3);
    lit.add(4);
    printi(lit.size());        // 2
    print("\n");
    printi(lit.contains(4));  // 1
    print("\n");
    s.clear();
    words.clear();
    printi(s.size() + words.size()); // 0
    print("\n");
    return 0;
}
