// wordset: HashSet deduplicates a stream of values. add returns 1 when
// inserted and 0 when already present; contains matches by value
// (string content compare); remove leaves a tombstone; the bucket array
// rehashes (doubles) when the load factor is reached.
// Build: flintc src/stdlib/coll.flint src/stdlib/mem.flint examples/wordset.flint -o wordset
import std.HashSet;
int main() {
    HashSet<int> s = new HashSet<int>();
    // int elements: duplicates collapse
    print(s.add(5));        // 1 (inserted)
    print("\n");
    print(s.add(10));      // 1
    print("\n");
    print(s.add(15));      // 1
    print("\n");
    print(s.add(10));      // 0 (already present)
    print("\n");
    print(s.size());       // 3
    print("\n");
    print(s.contains(10)); // 1
    print("\n");
    print(s.contains(99)); // 0
    print("\n");
    // remove (tombstone) then re-add
    print(s.remove(10));   // 1 (removed)
    print("\n");
    print(s.contains(10)); // 0
    print("\n");
    print(s.size());       // 2
    print("\n");
    print(s.add(10));      // 1 (re-inserted over the tombstone slot)
    print("\n");
    print(s.size());       // 3
    print("\n");
    // string elements: content dedup of a word stream
    HashSet<string> words = new HashSet<string>();
    words.add("the");
    words.add("quick");
    words.add("brown");
    words.add("fox");
    words.add("the");        // duplicate
    words.add("quick");      // duplicate
    print(words.size());     // 4 (unique)
    print("\n");
    print(words.contains("fox")); // 1
    print("\n");
    print(words.contains("dog")); // 0
    print("\n");
    // built up with add() (no literals in the stdlib world)
    HashSet<int> lit = new HashSet<int>();
    lit.add(3);
    lit.add(4);
    print(lit.size());        // 2
    print("\n");
    print(lit.contains(4));  // 1
    print("\n");
    s.clear();
    words.clear();
    print(s.size() + words.size()); // 0
    print("\n");
    return 0;
}
