// num_lib: the std.Num class (import std.Num) — base conversion and
// digit math.
import std.Num;

int main() {
    print(Num.toHex(255)); print(" ");    // ff
    print(Num.toUpperHex(255)); print(" "); // FF
    print(Num.fromHex("ff")); print(" ");   // 255
    print(Num.toBin(5)); print(" ");         // 101
    print(Num.fromBin("101")); print(" ");  // 5
    print(Num.toOct(8)); print(" ");         // 10
    print(Num.fromOct("10")); print(" ");   // 8
    print(Num.sumDigits(1234)); print(" "); // 10
    print(Num.digitCount(1000)); print(" "); // 4
    print(Num.reverseDigits(1234)); print(" "); // 4321
    println(Num.isPalindrome(1221)); // 1
    return 0;
}
