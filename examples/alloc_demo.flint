// alloc_demo: use the heap (via std.Mem) for a dynamic array. Builds a
// Fibonacci table of length n, then prints the sum.
//
//   $ flintc src/stdlib/mem.flint examples/alloc_demo.flint -o alloc_demo && ./alloc_demo
import std.Mem;

int main() {
    int n = 10;
    *int fib = Mem.intArray(n);
    fib[0] = 0;
    fib[1] = 1;
    for (int i = 2; i < n; i = i + 1) {
        fib[i] = fib[i - 1] + fib[i - 2];
    }
    // print the table
    int j = 0;
    int sum = 0;
    while (j < n) {
        print(fib[j]);
        if (j + 1 < n) {
            print(" ");
        }
        sum = sum + fib[j];
        j = j + 1;
    }
    print("\nsum=");
    print(sum);
    print("\n");
    Mem.freeInt(fib);
    return 0;
}
