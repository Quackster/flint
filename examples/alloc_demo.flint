// alloc_demo: heap arrays with typed syntax. Builds a Fibonacci table of
// length n, then prints the sum.
//
// Ownership: `fibs` returns a fresh owner (moved to the caller); indexing
// borrows; the buffer frees itself when `fib` goes out of scope.
//
//   $ flintc examples/alloc_demo.flint -o alloc_demo && ./alloc_demo

// A fresh array of the first n Fibonacci numbers (moved to the caller).
int[] fibs(int n) {
    int f[n];
    f[0] = 0;
    f[1] = 1;
    for (int i = 2; i < n; i = i + 1) {
        f[i] = f[i - 1] + f[i - 2];
    }
    return f;
}

int main() {
    int n = 10;
    int fib[] = fibs(n);
    // print the table
    int j = 0;
    int sum = 0;
    while (j < n) {
        print(fib[j]);
        if (j + 1 < n) {
            print(" ");
        }
        sum = sum + fib[j];
        j = j + 1;
    }
    print("\nsum=");
    print(sum);
    print("\n");
    return 0;
}
