// alloc_demo: use the heap (via std.Mem) for a dynamic array. Builds a
// Fibonacci table of length n, then prints the sum.
//
// Ownership: `fibs` returns a fresh owner (moved to the caller), indexing
// and `Mem.copy` borrow, and `Mem.freeInt` consumes — using `fib` after
// the free is a compile error.
//
//   $ flintc src/stdlib/mem.flint examples/alloc_demo.flint -o alloc_demo && ./alloc_demo
import std.Mem;

// A fresh array of the first n Fibonacci numbers (moved to the caller).
*int fibs(int n) {
    *int f = Mem.intArray(n);
    f[0] = 0;
    f[1] = 1;
    for (int i = 2; i < n; i = i + 1) {
        f[i] = f[i - 1] + f[i - 2];
    }
    return f;
}

int main() {
    int n = 10;
    *int fib = fibs(n);
    // print the table
    int j = 0;
    int sum = 0;
    while (j < n) {
        print(fib[j]);
        if (j + 1 < n) {
            print(" ");
        }
        sum = sum + fib[j];
        j = j + 1;
    }
    print("\nsum=");
    print(sum);
    print("\n");
    Mem.freeInt(fib);
    return 0;
}
