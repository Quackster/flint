// bit_lib: the std.Bit class (import std.Bit) — bit-level operations
// on 64-bit ints. (Flint has no 0b… binary literals, so values are
// written in decimal/hex.)
import std.Bit;

int main() {
    print(Bit.popcount(255)); print(" ");       // 8 (255 = 0xFF, eight set bits)
    print(Bit.nlz(1)); print(" ");             // 63 (single bit at position 0)
    print(Bit.ntz(8)); print(" ");            // 3 (8 = 1<<3)
    print(Bit.setBit(0, 3)); print(" ");     // 8
    print(Bit.testBit(42, 5)); print(" ");   // 1 (42 = 0b101010, bit 5 set)
    print(Bit.toggleBit(8, 2)); print(" ");  // 12 (0b1000 with bit 2 toggled = 0b1100)
    print(Bit.isPowerOfTwo(64)); print(" "); // 1
    print(Bit.isPowerOfTwo(65)); print(" "); // 0
    print(Bit.nextPowerOfTwo(100)); print(" "); // 128
    println(Bit.byteSwap(0x1234));   // 0x3412000000000000 (all 8 bytes swapped)
    return 0;
}
