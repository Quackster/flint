// obj_coll: collections holding class objects (the object flavour,
// derived from the type argument) refcount their elements. Storing an
// object retains a reference; clearing or destroying the collection
// releases it, but an object referenced elsewhere survives. Hold each
// object in a local first: a `new` passed straight into `put`/`push`
// has no owner to release it, so it never frees.
// Build: flintc src/stdlib/coll.flint src/stdlib/mem.flint examples/obj_coll.flint -o obj_coll
import std.List;
import std.HashMap;
import std.Queue;
class Box {
    int n;
    public Box(int x) {
        this.n = x;
    }
}

int main() {
    // a list of objects
    List<Box> b = new List<Box>();
    Box a = new Box(1);
    Box b2 = new Box(2);
    b.add(a);
    b.add(b2);
    print(b.size());             // 2
    print("\n");
    // reading back: the collection's reference keeps the object alive
    Box r1 = b.get(0);
    print(r1.n);              // 1
    print("\n");
    Box r2 = b.get(1);
    print(r2.n);              // 2
    print("\n");
    // the original references still work alongside the collection's
    print(a.n);              // 1
    print("\n");
    print(b2.n);             // 2
    print("\n");
    // a map of objects, keyed by int (locals own the boxes; the map
    // borrows and retains its own references)
    HashMap<int, Box> m = new HashMap<int, Box>();
    Box b3 = new Box(3);
    Box b4 = new Box(4);
    m.put(10, b3);
    m.put(20, b4);
    print(m.size());             // 2
    print("\n");
    Box v = m.get(20);
    print(v.n);              // 4
    print("\n");
    // a queue of objects
    Queue<Box> q = new Queue<Box>();
    Box b5 = new Box(5);
    Box b6 = new Box(6);
    q.push(b5);
    q.push(b6);
    Box f = q.pop();
    print(f.n);              // 5 (FIFO)
    print("\n");
    Box s = q.pop();
    print(s.n);              // 6
    print("\n");
    return 0;
}
