// config: a HashMap as a settings table — string keys mapped to
// string values, the usual configuration shape.
// Build: flintc src/stdlib/coll.flint src/stdlib/mem.flint examples/config.flint -o config
import std.HashMap;
class Config {
    HashMap<string, string> table;
    public Config() {
        this.table = new HashMap<string, string>();
    }
    public string get(string key, string dflt) {
        string v = this.table.get(key);
        if (v == null) {
            return dflt;
        }
        return v;
    }
    public void set(string key, string v) {
        this.table.put(key, v);
    }
}

int main() {
    Config c = new Config();
    c.set("host", "localhost");
    c.set("port", "8080");
    c.set("debug", "1");
    printi(c.table.size());      // 3
    print("\n");
    print(c.get("host", "?"));   // localhost
    print("\n");
    print(c.get("port", "?"));   // 8080
    print("\n");
    print(c.get("missing", "dflt"));  // dflt (get returns 0 -> default)
    print("\n");
    c.set("debug", "0");        // update over an existing key
    print(c.get("debug", "?"));  // 0
    print("\n");
    printi(c.table.contains("port"));   // 1
    print("\n");
    c.table.remove("host");
    printi(c.table.contains("host"));   // 0
    print("\n");
    printi(c.table.size());      // 2
    print("\n");
    return 0;
}
