// config: `dictionary` is an alias of hashmap — same API, different
// name. Here it stores string keys mapped to string values, the usual
// settings-table shape.
class Config {
    dictionary table;
    public Config() {
        this.table = new dictionary();
    }
    public string get(string key, string dflt) {
        string v = this.table.get(key);
        if (v == null) {
            return dflt;
        }
        return v;
    }
    public void set(string key, string v) {
        this.table.put(key, v);
    }
}

int main() {
    Config c = new Config();
    c.set("host", "localhost");
    c.set("port", "8080");
    c.set("debug", "1");
    printi(len(c.table));         // 3
    print("\n");
    print(c.get("host", "?"));   // localhost
    print("\n");
    print(c.get("port", "?"));   // 8080
    print("\n");
    print(c.get("missing", "dflt"));  // dflt (get returns 0 -> default)
    print("\n");
    c.set("debug", "0");        // update over an existing key
    print(c.get("debug", "?"));  // 0
    print("\n");
    printi(c.table.contains("port"));   // 1
    print("\n");
    c.table.remove("host");
    printi(c.table.contains("host"));   // 0
    print("\n");
    printi(len(c.table));         // 2
    print("\n");
    return 0;
}
