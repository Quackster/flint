// wordfreq: hashmap as a frequency counter. put inserts or updates;
// get returns the stored value (0 when absent, or when the value
// flavour does not match); keys() / values() return fresh lists in
// insertion order; {k: v} is the map literal.
int bump(hashmap m, string k) {
    int c = m.get(k);
    m.put(k, c + 1);
}

int main() {
    hashmap m = new hashmap();
    bump(m, "the");
    bump(m, "quick");
    bump(m, "fox");
    bump(m, "the");
    bump(m, "the");
    printi(len(m));                 // 3 (unique keys)
    print("\n");
    printi(m.get("the"));          // 3
    print("\n");
    printi(m.get("quick"));        // 1
    print("\n");
    printi(m.get("fox"));          // 1
    print("\n");
    printi(m.get("dog"));          // 0 (absent)
    print("\n");
    printi(m.contains("the"));     // 1
    print("\n");
    // keys() / values(): fresh lists, insertion order
    list k = m.keys();
    list v = m.values();
    printi(len(k) + len(v));        // 6
    print("\n");
    // int keys too (a map holds one flavour per entry)
    hashmap n = new hashmap();
    n.put(1, 100);
    n.put(2, 200);
    n.put(1, 150);                 // update, not insert
    printi(len(n));               // 2
    print("\n");
    printi(n.get(1));             // 150
    print("\n");
    printi(n.get(2));             // 200
    print("\n");
    n.remove(1);
    printi(n.get(1));             // 0 (removed)
    print("\n");
    printi(len(n));               // 1
    print("\n");
    // map literal construction
    hashmap lit = {1: "a", 2: "b"};
    printi(len(lit));            // 2
    print("\n");
    print(lit.get(2));            // b
    print("\n");
    // clear
    n.clear();
    printi(len(n));               // 0
    print("\n");
    return 0;
}
