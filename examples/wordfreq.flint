// wordfreq: HashMap as a frequency counter. put inserts or updates;
// get returns the stored value (0 when absent); keys() / values()
// return fresh Lists in insertion order.
// Build: flintc src/stdlib/coll.flint src/stdlib/mem.flint examples/wordfreq.flint -o wordfreq
import std.HashMap;
import std.List;
int bump(HashMap<string, int> m, string k) {
    int c = m.get(k);
    m.put(k, c + 1);
}

int main() {
    HashMap<string, int> m = new HashMap<string, int>();
    bump(m, "the");
    bump(m, "quick");
    bump(m, "fox");
    bump(m, "the");
    bump(m, "the");
    printi(m.size());                 // 3 (unique keys)
    print("\n");
    printi(m.get("the"));          // 3
    print("\n");
    printi(m.get("quick"));        // 1
    print("\n");
    printi(m.get("fox"));          // 1
    print("\n");
    printi(m.get("dog"));          // 0 (absent)
    print("\n");
    printi(m.contains("the"));     // 1
    print("\n");
    // keys() / values(): fresh Lists, insertion order
    List<string> k = m.keys();
    List<int> v = m.values();
    printi(k.size() + v.size());        // 6
    print("\n");
    // int keys and int values
    HashMap<int, int> n = new HashMap<int, int>();
    n.put(1, 100);
    n.put(2, 200);
    n.put(1, 150);                 // update, not insert
    printi(n.size());             // 2
    print("\n");
    printi(n.get(1));             // 150
    print("\n");
    printi(n.get(2));             // 200
    print("\n");
    n.remove(1);
    printi(n.get(1));             // 0 (removed)
    print("\n");
    printi(n.size());             // 1
    print("\n");
    // built up with put() (no literals in the stdlib world)
    HashMap<int, string> lit = new HashMap<int, string>();
    lit.put(1, "a");
    lit.put(2, "b");
    printi(lit.size());            // 2
    print("\n");
    print(lit.get(2));             // b
    print("\n");
    // clear
    n.clear();
    printi(n.size());             // 0
    print("\n");
    return 0;
}
