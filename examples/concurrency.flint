// concurrency: locks and atomics via the std.Sync wrapper. `Sync.lock` /
// `Sync.unlock` guard a mutex (an int: 0 = unlocked, 1 = locked); `Sync.cas`
// is an atomic compare-and-swap returning 1 on success / 0 on failure and
// leaving the cell updated on success.
//
//   $ flintc src/stdlib/sync.flint examples/concurrency.flint -o concurrency && ./concurrency
import std.Sync;

class State {
    int counter;
    int mutex;
    void State() {
        this.counter = 0;
        this.mutex = 0;
    }
}

int main() {
    State s = new State();
    // mutex lock/unlock on a fresh (unlocked) mutex
    Sync.lock(&s.mutex);
    Sync.unlock(&s.mutex);
    printi(s.mutex == 0 ? 1 : 0);   // 1 (back to unlocked)
    print("\n");
    // atomic CAS: 5 -> 10 succeeds
    int val = 5;
    int r1 = Sync.cas(&val, 5, 10);
    printi(r1 == 1 ? 1 : 0);       // 1 (success)
    printi(val == 10 ? 1 : 0);     // 1 (updated)
    print("\n");
    // a CAS that does not match the current value fails
    int r2 = Sync.cas(&val, 5, 20);
    printi(r2 == 0 ? 1 : 0);       // 1 (failed: val is 10, not 5)
    printi(val == 10 ? 1 : 0);     // 1 (unchanged)
    print("\n");
    return 0;
}
