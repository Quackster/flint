// checksum_lib: the std.Checksum class (import std.Checksum) —
// several checksums/hashes of a byte buffer.
import std.Checksum;

int main() {
    string s = "hello";
    print(Checksum.sum32(s)); print(" ");    // 104+101+108+108+111 = 532
    print(Checksum.crc32(s) & 0xFFFF); print(" ");  // crc32("hello") low 16 bits
    print(Checksum.djb2(s) & 0xFFFF); print(" ");
    print(Checksum.fnv1a32(s) & 0xFFFF); print(" ");
    println(Checksum.adler32(s));
    return 0;
}
