// gui: the std.App class (import std.App) — a Wayland window with
// drawing and basic input events. Build:
//   flintc src/stdlib/gui.flint src/stdlib/image.flint src/stdlib/math.flint src/stdlib/checksum.flint examples/gui.flint -o gui
// Without a Wayland compositor (e.g. headless) it prints "no display" and
// exits. On a desktop it shows a 320x200 window: a moving dot leaves a
// green trail, mouse motion draws yellow marks, mouse buttons draw red
// squares. Press 'q' to quit (or close the app from the compositor).
import std.App;
import std.Image;
import std.Window;

class Demo implements OnDraw, OnKey, OnButton, OnMotion {
    App app;
    int t;
    void draw(Image c) {
        if (this.t < 3) {
            print("iter ");
            print(this.t);
            print(" running=");
            print(this.app.running());
            print("\n");
        }
        this.t = this.t + 1;
        int px = (this.t * 7) % c.w;
        c.set(px, 100, Image.rgb(0, 255, 0));
        c.set(px + 1, 100, Image.rgb(0, 255, 0));
        c.set(px, 101, Image.rgb(0, 255, 0));
    }
    void key(int code, int mods) {
        if (Window.keyChar(code) == 113) {
            this.app.stop();   // 'q' quits
        }
    }
    void button(int state, int x, int y) {
        if (state == 1) {
            this.app.canvas().fillRect(x - 4, y - 4, 8, 8, Image.rgb(255, 64, 64));
        }
    }
    void motion(int x, int y) {
        this.app.canvas().set(x, y, Image.rgb(255, 200, 0));
    }
}

int main() {
    Demo d = new Demo();
    d.app = App.open(320, 200, "flint gui");
    if (d.app == null) {
        print("no display\n");
        return 0;
    }
    print("opened ok\n");
    d.app.canvas().fill(Image.rgb(10, 10, 20));
    d.app.draw += d;
    d.app.key += d;
    d.app.button += d;
    d.app.motion += d;
    return d.app.run();
}
