// gui: the std.Window class (import std.Window) — a Wayland window with
// drawing and basic input events. Build:
//   flintc src/stdlib/gui.flint src/stdlib/image.flint src/stdlib/math.flint src/stdlib/checksum.flint examples/gui.flint -o gui
// Without a Wayland compositor (e.g. headless) it prints "no display" and
// exits. On a desktop it shows a 320x200 window: a moving dot leaves a
// green trail, mouse motion draws yellow marks, mouse buttons draw red
// squares. Press 'q' to quit (or close the app from the compositor).
import std.Window;
import std.Image;

int main() {
    Window w = Window.open(320, 200, "flint gui");
    if (w == null) {
        print("no display\n");
        return 0;
    }
    print("opened ok\n");
    Image c = new Image(320, 200);
    c.fill(Image.rgb(10, 10, 20));
    int t = 0;
    while (w.running()) {
        if (t < 3) {
            print("iter ");
            printi(t);
            print(" running=");
            printi(w.running());
            print("\n");
        }
        int e = w.peekEvent();
        while (e != 0) {
            if (e == Window.KEY() && Window.keyChar(w.evKey()) == 113) {
                return 0;   // 'q' quits
            }
            if (e == Window.BUTTON() && w.evState() == 1) {
                c.fillRect(w.evX() - 4, w.evY() - 4, 8, 8, Image.rgb(255, 64, 64));
            }
            if (e == Window.MOTION()) {
                c.set(w.evX(), w.evY(), Image.rgb(255, 200, 0));
            }
            e = w.peekEvent();
        }
        t = t + 1;
        int px = (t * 7) % 320;
        c.set(px, 100, Image.rgb(0, 255, 0));
        c.set(px + 1, 100, Image.rgb(0, 255, 0));
        c.set(px, 101, Image.rgb(0, 255, 0));
        w.present(c);
    }
    return 0;
}
