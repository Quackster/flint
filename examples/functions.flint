// functions: function definitions, arguments, return values, recursion, and
// the @ operator (function address, used for threads).
int doubleIt(int x) {
    return x * 2;
}

// Recursion: factorial.
int factorial(int n) {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

// A void function that mutates its caller's world via a pointer argument.
void increment(*int p) {
    *p = *p + 1;
}

// Default parameter values: trailing parameters may carry defaults; an
// omitted trailing argument is taken from its default.
int add(int a, int b = 10) {
    return a + b;
}

int main() {
    // basic call
    print(doubleIt(21)); print(" ");        // 42
    // recursion
    print(factorial(5)); print(" ");        // 120
    // void function with a pointer argument
    int x = 10;
    increment(&x);
    print(x); print(" ");                  // 11
    // @ yields a function's address (an int); std.Thread.spawn takes it
    // int tid = Thread.spawn(@doubleIt, 0);
    // default parameter values (trailing parameters)
    print(add(5)); print(" ");            // 15 (b defaults to 10)
    print(add(5, 7));                    // 12 (explicit b overrides the default)
    return 0;
}
