// Test: multi-threading support with @ operator for function addresses
package test;

void thread_fn(int arg) {
    // Write "hello from thread\n" to stdout
    sys.write(1, "hello from thread", 19);
    sys.write(1, "\n", 1);
}

int main() {
    // Create a thread using @ to get the function address
    int tid = sys.threadCreate(@thread_fn, 0);
    // Join the thread
    sys.threadJoin(tid);
    // Write "main done\n" to stdout
    sys.write(1, "main done", 9);
    sys.write(1, "\n", 1);
    return 0;
}
