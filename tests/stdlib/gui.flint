// std.Gui test: Image 5x7 font text, widget hit-testing, label and
// textbox behaviour, textbox key mapping, the form inputs (button,
// checkbox, radio, slider, number, password, textarea, dropdown),
// Gui dispatch + draw. No window is opened, so every check is
// deterministic and safe headless.
import std.Gui;
import std.App;
import std.Image;
import std.Label;
import std.Button;
import std.TextBox;
import std.PasswordBox;
import std.NumberBox;
import std.TextArea;
import std.Checkbox;
import std.RadioButton;
import std.Slider;
import std.Dropdown;
import std.OnSetup;
import std.OnDraw;
import std.OnKey;

class AppH implements OnSetup, OnDraw, OnKey {
    App app;
    int setupCount;
    int drawCount;
    int keyCount;
    void setup() { this.setupCount = this.setupCount + 1; }
    void draw(Image c) { this.drawCount = this.drawCount + 1; }
    void key(int code, int mods) { this.keyCount = this.keyCount + 1; }
}

int main() {
    // ---- Image: 5x7 font text ----
    Image im = new Image(32, 16);
    print(im.text(0, 0, "Hi", 0xFFFFFFFF)); print(" ");     // 12
    print(im.textWidth("abc")); print(" ");                // 18
    print(im.get(0, 0) != 0 ? 1 : 0); print(" ");          // 1 (H col 0)
    print(im.get(5, 0) == 0 ? 1 : 0); print(" ");          // 1 (1px gap)
    println(im.get(8, 1) != 0 ? 1 : 0);         // 1 (i stem)
    // out-of-range drawing must be a no-op
    Image im2 = new Image(32, 16);
    im2.text(30, 0, "abc", 0xFF000000);
    println(im2.get(31, 0) != 0 ? 1 : 0);       // 1 (a col 1)

    // ---- Label ----
    Label l = new Label(0, 0, 16, 8, "Hi");
    print(str.cmp(l.text(), "Hi") == 0 ? 1 : 0); print(" ");
    Image lim = new Image(32, 16);
    l.draw(lim);
    print(lim.get(0, 0) != 0 ? 1 : 0); print(" ");         // 1 (H top-left)
    l.setText("Hi");
    println(str.cmp(l.text(), "Hi") == 0 ? 1 : 0);

    // ---- Widget: hit (right/bottom edges exclusive) ----
    Label w = new Label(10, 10, 20, 10, "x");
    print(w.hit(15, 15)); print(" ");                     // 1
    print(w.hit(5, 15)); print(" ");                     // 0
    print(w.hit(30, 15)); print(" ");                    // 0
    print(w.hit(29, 19)); print(" ");                    // 1
    println(w.hit(15, 20));                   // 0

    // ---- TextBox: focus, type, backspace, return, capacity ----
    TextBox tb = new TextBox(0, 0, 40, 16, 8);
    print(tb.claimFocus(5, 8)); print(" ");              // 1
    tb.onKey(16, 0);                                     // 'q'
    tb.onKey(17, 0);                                     // 'w'
    print(tb.length()); print(" ");                     // 2
    print(tb.text()); print(" ");                        // qw
    tb.onKey(14, 0);                                     // backspace -> "q"
    print(tb.length()); print(" ");                     // 1
    tb.onKey(28, 0);                                     // return
    print(tb.entered()); print(" ");                    // 1
    tb.clearEntered();
    println(tb.entered());                   // 0
    int i = 0;
    while (i < 10) {
        tb.append(97);                                   // 'a' x10
        i = i + 1;
    }
    print(tb.length()); print(" ");                     // 8 (capped at max)
    tb.backspace();
    print(tb.length()); print(" ");                     // 7
    tb.clear();
    print(tb.length()); print(" ");                     // 0
    println(tb.entered());                   // 0
    // an unfocused box ignores keys
    TextBox tb2 = new TextBox(100, 0, 40, 16, 8);
    tb2.onKey(30, 0);
    println(tb2.length());                   // 0

    // ---- TextBox: key mapping (US layout, shift/caps) ----
    print(TextBox.keyChar(30, 0) == 97 ? 1 : 0); print(" ");   // a
    print(TextBox.keyChar(30, 1) == 65 ? 1 : 0); print(" ");   // A (Shift_L)
    print(TextBox.keyChar(30, 2) == 65 ? 1 : 0); print(" ");   // A (Caps_L)
    print(TextBox.keyChar(2, 1) == 33 ? 1 : 0); print(" ");    // ! (shifted 1)
    print(TextBox.keyChar(14, 0) == 0 ? 1 : 0); print(" ");    // Backspace
    print(TextBox.keyChar(28, 0) == 0 ? 1 : 0); print(" ");    // Return
    println(TextBox.keyChar(42, 0) == 0 ? 1 : 0);   // Shift key

    // ---- TextBox: draw (fill + border) ----
    Image im3 = new Image(48, 24);
    tb.draw(im3);
    print(im3.get(5, 8) != 0 ? 1 : 0); print(" ");     // 1 (fill)
    println(im3.get(0, 0) != 0 ? 1 : 0);    // 1 (border corner)

    // ---- Gui: capacity, draw, focus flow ----
    Gui gui = new Gui(null);
    gui.step();                                        // no-op without a window
    print(gui.running()); print(" ");                 // 1
    gui.addLabel(l);
    gui.addBox(tb);
    print(gui.nLabels()); print(" ");                // 1
    print(gui.nBoxes()); print(" ");                 // 1
    Image im4 = new Image(64, 32);
    gui.drawWidgets(im4);
    print(im4.get(5, 8) != 0 ? 1 : 0); print(" ");   // 1 (box fill drawn)
    println(im4.get(0, 0) != 0 ? 1 : 0);  // 1 (box border)
    i = 0;
    while (i < 10) {
        gui.addLabel(new Label(0, 0, 8, 8, "x"));
        i = i + 1;
    }
    print(gui.nLabels()); print(" ");                // 8 (capacity)
    gui.dispatchPress(5, 8);                         // focuses tb
    gui.dispatchKey(30, 0);                          // 'a'
    print(tb.text()); print(" ");                    // a
    print(tb.length()); print(" ");                 // 1
    gui.setRunning(0);
    println(gui.running());              // 0

    // ---- Button: press arms, release-inside fires ----
    Gui gui2 = new Gui(null);
    Button btn = new Button(0, 0, 60, 20, "Go");
    gui2.addButton(btn);
    print(gui2.nButtons()); print(" ");             // 1
    gui2.dispatchPress(30, 10);
    gui2.dispatchRelease(30, 10);
    print(btn.clicked()); print(" ");               // 1
    btn.clearClicked();
    gui2.dispatchPress(30, 10);
    gui2.dispatchRelease(200, 200);
    print(btn.clicked()); print(" ");               // 0 (outside)
    gui2.dispatchKey(28, 0);
    println(btn.clicked());              // 1 (Return)
    btn.clearClicked();

    // ---- Checkbox: click and Space toggle ----
    Checkbox cb = new Checkbox(0, 30, 120, 20, "Mail");
    gui2.addCheck(cb);
    gui2.dispatchPress(5, 40);
    print(cb.checked()); print(" ");                // 1
    gui2.dispatchPress(5, 40);
    print(cb.checked()); print(" ");                // 0
    gui2.dispatchKey(57, 0);
    println(cb.checked());               // 1 (Space)

    // ---- RadioButton: groups are exclusive ----
    RadioButton r1 = new RadioButton(0, 60, 100, 20, "Red");
    r1.setGroup(1);
    RadioButton r2 = new RadioButton(0, 90, 100, 20, "Green");
    r2.setGroup(1);
    RadioButton r3 = new RadioButton(0, 120, 100, 20, "Blue");
    r3.setGroup(2);
    gui2.addRadio(r1);
    gui2.addRadio(r2);
    gui2.addRadio(r3);
    print(gui2.nRadios()); print(" ");              // 3
    gui2.dispatchPress(5, 70);
    print(r1.selected()); print(" ");
    print(r2.selected()); print(" ");
    print(r3.selected()); print(" ");               // 1 0 0
    gui2.dispatchPress(5, 100);
    print(r1.selected()); print(" ");
    print(r2.selected()); print(" ");
    print(r3.selected()); print(" ");               // 0 1 0
    gui2.dispatchPress(5, 130);
    print(r1.selected()); print(" ");
    print(r2.selected()); print(" ");
    println(r3.selected());              // 0 1 1
    gui2.dispatchKey(57, 0);
    print(r1.selected()); print(" ");
    print(r2.selected()); print(" ");
    println(r3.selected());              // 0 1 1 (Space)

    // ---- NumberBox: digits only, value, steppers ----
    NumberBox nb = new NumberBox(0, 180, 80, 20, 8);
    gui2.addNum(nb);
    gui2.dispatchPress(5, 190);
    gui2.dispatchKey(2, 0);                          // '1'
    gui2.dispatchKey(3, 0);                          // '2'
    gui2.dispatchKey(30, 0);                         // 'a' ignored
    gui2.dispatchKey(12, 0);                         // '-' ignored (not first)
    gui2.dispatchKey(14, 0);                         // backspace
    print(nb.text()); print(" ");                    // 1
    print(nb.value()); print(" ");                  // 1
    nb.setValue(-5);
    print(nb.text()); print(" ");                    // -5
    gui2.dispatchKey(103, 0);                        // Up
    print(nb.value()); print(" ");                  // -4
    gui2.dispatchKey(108, 0);                        // Down
    print(nb.value()); print(" ");                  // -5
    gui2.dispatchKey(28, 0);
    println(nb.entered());               // 1

    // ---- PasswordBox: text kept, bullets drawn ----
    PasswordBox pw = new PasswordBox(0, 210, 80, 20, 8);
    gui2.addPass(pw);
    gui2.dispatchPress(5, 220);
    gui2.dispatchKey(16, 0);                         // q
    gui2.dispatchKey(17, 1);                         // W (shift)
    print(pw.text()); print(" ");                    // qW
    println(pw.length());                // 2

    // ---- TextArea: Return is a newline, not entered ----
    TextArea ta = new TextArea(0, 240, 120, 40, 64);
    gui2.addArea(ta);
    gui2.dispatchPress(5, 250);
    gui2.dispatchKey(30, 0);                         // a
    gui2.dispatchKey(28, 0);                         // newline
    gui2.dispatchKey(31, 0);                         // s
    print(ta.entered()); print(" ");                // 0
    print(ta.lines()); print(" ");                  // 2
    println(ta.length());                // 3

    // ---- Dropdown: open, pick, keyboard ----
    Dropdown dd = new Dropdown(0, 290, 120, 24);
    gui2.addDrop(dd);
    print(dd.addOption("red")); print(" ");         // 1
    print(dd.addOption("green")); print(" ");       // 1
    print(dd.addOption("blue")); print(" ");        // 1
    print(dd.nOptions()); print(" ");               // 3
    print(dd.selectedText()); print("\n");           // red
    gui2.dispatchPress(5, 300);
    print(dd.isOpen()); print(" ");                 // 1
    gui2.dispatchPress(5, 348);
    print(dd.selected()); print(" ");               // 1
    print(dd.isOpen()); print(" ");                 // 0
    print(dd.selectedText()); print("\n");           // green
    gui2.dispatchKey(57, 0);                         // Space opens
    print(dd.isOpen()); print(" ");                 // 1
    gui2.dispatchKey(108, 0);                        // down
    gui2.dispatchKey(28, 0);                         // enter picks
    print(dd.selected()); print(" ");               // 2
    print(dd.selectedText()); print("\n");           // blue
    gui2.dispatchPress(5, 300);
    gui2.dispatchKey(1, 0);                          // Escape closes
    print(dd.isOpen()); print(" ");                 // 0
    println(dd.selected());              // 2

    // ---- Slider: click, drag, keys, clamp ----
    Slider sl = new Slider(0, 150, 100, 20, 100);
    gui2.addSlider(sl);
    sl.setMin(10);
    print(sl.value()); print(" ");                  // 10 (clamped up)
    gui2.dispatchPress(0, 155);
    print(sl.value()); print(" ");                  // 10 (left edge)
    gui2.dispatchPress(99, 155);
    print(sl.value()); print(" ");                  // 99
    gui2.dispatchMotion(50, 155);
    print(sl.value()); print(" ");                  // 55 (drag)
    gui2.dispatchRelease(50, 155);
    gui2.dispatchMotion(90, 155);
    print(sl.value()); print(" ");                  // 55 (released)
    gui2.dispatchKey(106, 0);
    print(sl.value()); print(" ");                  // 56
    gui2.dispatchKey(106, 1);
    print(sl.value()); print(" ");                  // 66 (shift x10)
    gui2.dispatchKey(105, 0);
    print(sl.value()); print(" ");                  // 65
    sl.setValue(1000);
    print(sl.value()); print(" ");                  // 100 (clamped)
    sl.setValue(-5);
    print(sl.value()); print(" ");                  // 10 (clamped)
    gui2.dispatchPress(50, 155);
    gui2.dispatchRelease(50, 155);
    println(sl.value());                 // 55

    // ---- Gui draw covers every kind ----
    Image im5 = new Image(240, 400);
    gui2.drawWidgets(im5);
    print(im5.get(5, 10) != 0 ? 1 : 0); print(" ");    // 1 (button fill)
    print(im5.get(2, 35) != 0 ? 1 : 0); print(" ");    // 1 (check fill)
    print(im5.get(5, 100) != 0 ? 1 : 0); print(" ");   // 1 (radio dot)
    println(im5.get(50, 155) != 0 ? 1 : 0); // 1 (slider knob)

    // ---- App: a null window makes run() a no-op; += registration and
    // interface dispatch (C#-style) ----
    App app = new App();
    print(app.running()); print(" ");           // 1
    print(app.run()); print(" ");              // 0 (no window)
    AppH ah = new AppH();
    ah.app = app;
    app.setup += ah;
    app.draw += ah;
    app.key += ah;
    app.setup.setup();
    print(ah.setupCount); print(" ");          // 1
    Image imA = new Image(8, 8);
    app.draw.draw(imA);
    print(ah.drawCount); print(" ");           // 1
    app.key.key(30, 0);
    print(ah.keyCount); print(" ");            // 1
    app.stop();
    println(app.running());        // 0

    // ---- Gui: a null window makes run() a no-op ----
    Gui g3 = new Gui(null);
    print(g3.running()); print(" ");           // 1
    println(g3.run());             // 0 (no window)
    return 0;
}
