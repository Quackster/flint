// std.Image test: pixel model, color, transforms, drawing, and
// multi-format save/load round-trips. Fully deterministic (no time/rand).
import std.Image;

int main() {
    // ---- pixel model + color ----
    Image im = new Image(8, 4);
    im.fill(Image.rgb(255, 0, 0));
    print(im.r(0, 0)); print(" ");
    print(im.g(0, 0)); print(" ");
    print(im.b(0, 0)); print(" ");
    print(im.a(0, 0)); print(" ");
    im.set(3, 2, Image.rgba(10, 20, 30, 255));
    print(Image.cr(im.get(3, 2))); print(" ");
    print(Image.cg(im.get(3, 2))); print(" ");
    print(Image.cb(im.get(3, 2))); print(" ");
    println(im.get(9, 0));

    // ---- drawing ----
    Image c = new Image(10, 10);
    c.clear();
    c.rect(2, 2, 6, 6, Image.rgb(0, 255, 0));
    print(c.r(2, 2)); print(" ");
    print(c.g(2, 2)); print(" ");
    print(c.g(5, 2)); print(" ");
    println(c.g(5, 5));
    c.line(0, 0, 9, 9, Image.rgb(255, 0, 255));
    print(c.r(4, 4)); print(" ");
    println(c.b(4, 4));
    c.fillCircle(5, 5, 3, Image.rgb(0, 0, 255));
    print(c.b(5, 5)); print(" ");
    println(c.b(2, 5));

    // ---- transforms ----
    Image t = new Image(4, 2);
    t.set(0, 0, 100);
    t.set(3, 1, 200);
    t.flipH();
    print(t.get(3, 0)); print(" ");
    print(t.get(0, 1)); print(" ");
    t.flipV();
    print(t.get(3, 1)); print(" ");
    t.invert();
    print(t.get(3, 1)); print(" ");
    t.grayscale();
    print(t.r(3, 1)); print(" ");
    println(t.g(3, 1));
    Image big = t.scale(8, 4);
    print(big.w); print(" ");
    println(big.h);

    // ---- blur (solid region stays solid) ----
    Image bl = new Image(5, 5);
    bl.fill(Image.rgb(255, 0, 0));   // solid red
    bl.blur();
    print(bl.r(2, 2)); print(" ");   // 255 (all neighbors red)
    println(bl.r(0, 0));  // 255 (corner, clamped, all red)

    // ---- multi-format round-trips ----
    Image rt = new Image(8, 4);
    rt.fill(Image.rgb(1, 2, 3));
    rt.set(0, 0, Image.rgb(9, 8, 7));
    rt.set(7, 3, Image.rgb(5, 6, 5));

    print(rt.toPpm("/tmp/img_t.ppm") > 0 ? 1 : 0); print(" ");
    Image l1 = Image.load("/tmp/img_t.ppm");
    print(l1 == null ? 0 : 1); print(" ");
    print(l1.get(0, 0) == Image.rgb(9, 8, 7) ? 1 : 0); print(" ");
    println(l1.get(7, 3) == Image.rgb(5, 6, 5) ? 1 : 0);

    print(rt.toPgm("/tmp/img_t.pgm") > 0 ? 1 : 0); print(" ");
    Image l2 = Image.load("/tmp/img_t.pgm");
    print(l2 == null ? 0 : 1); print(" ");
    print(l2.r(0, 0) == l2.g(0, 0) ? 1 : 0); print(" ");
    println(l2.r(7, 3) == l2.g(7, 3) ? 1 : 0);

    print(rt.toBmp("/tmp/img_t.bmp") > 0 ? 1 : 0); print(" ");
    Image l3 = Image.load("/tmp/img_t.bmp");
    print(l3 == null ? 0 : 1); print(" ");
    print(l3.get(0, 0) == Image.rgb(9, 8, 7) ? 1 : 0); print(" ");
    print(l3.get(7, 3) == Image.rgb(5, 6, 5) ? 1 : 0); print(" ");
    println(l3.w == 8 && l3.h == 4 ? 1 : 0);

    // ---- save() dispatcher + setAlpha ----
    int ws = rt.save("/tmp/img_t2.bmp");
    Image ls = Image.load("/tmp/img_t2.bmp");
    print(ws > 0 && ls.get(0, 0) == Image.rgb(9, 8, 7) ? 1 : 0); print(" ");
    Image sa = new Image(2, 2);
    sa.fill(Image.rgb(10, 20, 30));
    sa.setAlpha(1, 1, 5);
    print(sa.a(1, 1)); print(" ");
    println(sa.r(1, 1));
    return 0;
}
