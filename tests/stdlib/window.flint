// std.Window test: the pure helpers (fixed-point conversion, key-code
// map, display-name parsing, string comparison). Fully deterministic —
// never opens a display, so it is stable headless and on a desktop.
import std.Window;

int main() {
    // ---- fixed-point (24.8) ----
    print(Window.fixed(256)); print(" ");
    print(Window.fixed(1023)); print(" ");
    print(Window.fixed(-256)); print(" ");
    println(Window.fixed(0));

    // ---- key-code map (Linux evdev keycodes, US layout) ----
    print(Window.keyChar(16) == 113 ? 1 : 0); print(" ");   // 'q'
    print(Window.keyChar(1) == 27 ? 1 : 0); print(" ");    // Escape
    print(Window.keyChar(11) == 48 ? 1 : 0); print(" ");   // '0'
    print(Window.keyChar(28) == 13 ? 1 : 0); print(" ");   // Return
    print(Window.keyChar(57) == 32 ? 1 : 0); print(" ");   // Space
    print(Window.keyChar(14) == 8 ? 1 : 0); print(" ");    // Backspace
    println(Window.keyChar(99) == 0 ? 1 : 0);   // unmapped

    // ---- display-name parsing ----
    print(Window.parseDisplay("wayland-2")); print(" ");
    print(Window.parseDisplay("wayland-0")); print(" ");
    print(Window.parseDisplay("wayland-12")); print(" ");
    println(Window.parseDisplay("no digits") == 0 ? 1 : 0);

    // ---- string helpers ----
    print(Window.strEq("wayland-0", "wayland-0") ? 1 : 0); print(" ");
    print(Window.strEq("a", "b") ? 1 : 0); print(" ");
    print(str.cmp(Window.xdgPath("/run/user/1000", "wayland-3"),
                   "/run/user/1000/wayland-3") == 0 ? 1 : 0); print("\n");
    return 0;
}
