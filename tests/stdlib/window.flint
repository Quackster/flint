// std.Window test: canvas model + drawing primitives + font.
// Uses the framebuffer backend (backend 0), whose open may succeed or fail
// depending on the host; the canvas primitives below are backend-independent
// and deterministic, so we do not assert on ok()/err().
import std.Window;
import std.Image;

int main() {
    Window w = new Window(32, 16, 0);
    // ---- canvas model ----
    w.clear();
    w.set(5, 3, 0x00010203);
    printi(w.get(5, 3) == 0x00010203 ? 1 : 0); print(" ");
    printi(w.width() == 32 ? 1 : 0); print(" ");
    printi(w.height() == 16 ? 1 : 0); print("\n");
    // out-of-range set is a no-op
    w.set(99, 99, 0x00FFFFFF);
    printi(w.get(99, 99) == 0 ? 1 : 0); print("\n");

    // ---- primitives ----
    w.clear();
    w.fill_rect(2, 2, 4, 3, 0x00FF0000);
    printi(w.get(3, 3) == 0x00FF0000 ? 1 : 0); print(" ");   // 1
    printi(w.get(0, 0) == 0 ? 1 : 0); print(" ");          // 1
    w.pixel(10, 5, 0x0000FF00);
    printi(w.get(10, 5) == 0x0000FF00 ? 1 : 0); print(" "); // 1
    w.fill_circle(8, 8, 3, 0x000000FF);
    printi(w.get(8, 8) == 0x000000FF ? 1 : 0); print(" ");  // 1
    w.line(0, 0, 5, 5, 0x00FF00FF);
    printi(w.get(2, 2) == 0x00FF00FF ? 1 : 0); print(" ");  // 1
    w.rect(1, 1, 4, 4, 0x00FFFF00);
    printi(w.get(1, 1) == 0x00FFFF00 ? 1 : 0); print(" ");  // 1 corner
    printi(w.get(2, 2) == 0x00FF00FF ? 1 : 0); print(" ");  // 1 interior (line)

    // ---- blit (Image, alpha-tested) ----
    Image im = new Image(4, 4);
    im.set(0, 0, 0xFF00FF00);
    im.set(3, 3, 0xFFFF0000);
    w.clear();
    w.blit(0, 0, im);
    printi(w.get(0, 0) == 0xFF00FF00 ? 1 : 0); print(" ");  // 1
    printi(w.get(3, 3) == 0xFFFF0000 ? 1 : 0); print(" ");  // 1
    printi(w.get(1, 1) == 0 ? 1 : 0); print(" ");          // 1 (transparent)

    // ---- text (5x7 font): 'A' row0 = 01110 sets cols 1,2,3 ----
    w.clear();
    w.text(0, 0, "A", 0x00FFFFFF);
    printi(w.get(1, 0) == 0x00FFFFFF ? 1 : 0); print(" ");  // 1 (col1 row0 set)
    printi(w.get(0, 0) == 0 ? 1 : 0); print(" ");          // 1 (col0 row0 unset)
    printi(w.text(0, 0, "AB", 0x00000000) == 12 ? 1 : 0);  // 1 (2*6 px wide)
    print("\n");
    return 0;
}
