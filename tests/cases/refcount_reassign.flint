class Inner { int x; public Inner(int n){this.x=n;} }
class C { Inner a; public C(){} }

int main() {
    // 1. field reassignment (the original double-assignment bug)
    C c = new C();
    c.a = new Inner(1);
    println(c.a.x);
    c.a = new Inner(2);
    println(c.a.x);
    c.a = new Inner(3);
    println(c.a.x);

    // 2. heap local reassignment
    Inner x = new Inner(10);
    println(x.x);
    x = new Inner(20);
    println(x.x);

    // 3. reassignment in a loop (exercises stack-region reuse)
    int i = 0;
    while (i < 3) {
        c.a = new Inner(i * 100);
        println(c.a.x);
        i = i + 1;
    }

    // 4. field access on a temporary base (new)
    int t = new Inner(99).x;
    println(t);
    return 0;
}
