// Object elements (kind = 2): storing retains, clearing/destroying
// releases. While a Box is also held by a local, the collections that
// retain it can be dropped without destroying the Box.
import std.List;
import std.HashMap;
import std.Queue;
class Box {
    static int destroyed;
    int id;
    public Box(int i) { this.id = i; }
    public int id() { return this.id; }
    void destroy() { Box.destroyed = Box.destroyed + 1; }
}
int main() {
    Box a = new Box(10);
    Box b = new Box(20);
    if (1) {
        List<Box> l = new List<Box>();
        l.add(a);
        l.set(0, a);
        l.remove(0);
        HashMap<int, Box> m = new HashMap<int, Box>();
        m.put(1, a);
        Queue<Box> q = new Queue<Box>();
        q.push(b);
    }
    printi(a.id());
    print("\n");                   // 10
    printi(b.id());
    print("\n");                   // 20
    printi(Box.destroyed);
    print("\n");                   // 0: both still referenced by main
    return 0;
}
