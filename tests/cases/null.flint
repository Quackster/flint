// null literal: class and pointer locals start as null, compare, reassign.
class Point {
    int x;
    int y;
}
int main() {
    Point p = null;
    if (p == null) {
        print(0);
    } else {
        print(1);
    }
    print("\n");
    p = new Point(1, 2);
    if (p != null) {
        print(p.x + p.y);
    }
    print("\n");
    *byte b = null;
    if (b == null) {
        print(7);
    }
    print("\n");
    return 0;
}
