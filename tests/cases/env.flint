int main() {
    // PATH is set in the test environment
    *byte p = env.get("PATH");
    printi(p != null ? 1 : 0); print("\n");
    printi(strlen(p) > 0 ? 1 : 0); print("\n");
    // missing variable returns null
    *byte m = env.get("BOX_TEST_NONEXISTENT_XYZ");
    printi(m == null ? 1 : 0); print("\n");
    return 0;
}
