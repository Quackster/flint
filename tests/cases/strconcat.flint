int main() {
    // `+` on two string literals is concatenation
    string a = "hello" + " world";
    print(a);
    print("\n");
    // `+` with a string builtin result (itoa returns a *byte string)
    string b = "val=" + itoa(42);
    print(b);
    print("\n");
    // chained concatenation
    string c = "a" + "b" + "c";
    print(c);
    print("\n");
    // pointer arithmetic is preserved: *byte + int
    string buf[8];
    buf[0] = 65;
    print(buf[1]);
    print("\n");
    // string + int is pointer arithmetic (byte at offset 1 of "hello")
    string s = "hello";
    print(s[1]);
    print("\n");
    return 0;
}
