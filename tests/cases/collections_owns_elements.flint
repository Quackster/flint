// Object-element collections (kind = 2) retain on store and release on
// clear/destroy. A Box that is also held by a local survives the
// destruction of the collection(s) that retained it, so its destroy()
// hook (refcount zero) must not have fired.
import std.List;
import std.HashMap;
class Box {
    static int destroyed;
    int id;
    public Box(int i) { this.id = i; }
    public int id() { return this.id; }
    void destroy() { Box.destroyed = Box.destroyed + 1; }
}
int main() {
    Box a = new Box(1);
    if (1) {
        List<Box> l = new List<Box>();
        l.add(a);                 // retains a
    }
    print(a.id());
    print("\n");                   // 1: a survived l's destruction
    print(Box.destroyed);
    print("\n");                   // 0: a is still referenced, not destroyed
    if (1) {
        HashMap<int, Box> m = new HashMap<int, Box>();
        m.put(1, a);
        List<Box> v = m.values(); // values() retains a
    }
    print(a.id());
    print("\n");                   // 1: a survived m's and v's destruction
    print(Box.destroyed);
    print("\n");                   // 0: still referenced by main
    return 0;
}
