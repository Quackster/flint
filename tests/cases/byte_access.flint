int main() {
    // byteLoad / byteStore
    *byte buf = alloc(16);
    sys.byteStore(buf, 0xAB);
    int b = sys.byteLoad(buf);
    println(b == 0xAB ? 1 : 0);

    // shortLoad / shortStore
    sys.shortStore(buf, 0x1234);
    int s = sys.shortLoad(buf);
    println(s == 0x1234 ? 1 : 0);

    // intLoad / intStore
    sys.intStore(buf, 0xDEADBEEF);
    int i = sys.intLoad(buf);
    println(i == 0xDEADBEEF ? 1 : 0);

    // byte-level wire encoding: pack 3 bytes into a slot, read them back
    sys.byteStore(buf, 0x01);
    sys.byteStore(buf + 1, 0x02);
    sys.byteStore(buf + 2, 0x03);
    int b0 = sys.byteLoad(buf);
    int b1 = sys.byteLoad(buf + 1);
    int b2 = sys.byteLoad(buf + 2);
    println(b0 == 1 && b1 == 2 && b2 == 3 ? 1 : 0);

    free(buf);
    return 0;
}
