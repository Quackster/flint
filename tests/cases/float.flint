int main() {
    // itof: convert int to fixed-point
    int a = math.itof(3);
    int b = math.itof(2);

    // fadd: 3.0 + 2.0 = 5.0
    int c = math.fadd(a, b);
    int ci = math.ftoi(c);
    println(ci == 5 ? 1 : 0);

    // fsub: 3.0 - 2.0 = 1.0
    int d = math.fsub(a, b);
    int di = math.ftoi(d);
    println(di == 1 ? 1 : 0);

    // fmul: 3.0 * 2.0 = 6.0
    int e = math.fmul(a, b);
    int ei = math.ftoi(e);
    println(ei == 6 ? 1 : 0);

    // fdiv: 6.0 / 2.0 = 3.0
    int f = math.fdiv(e, b);
    int fi = math.ftoi(f);
    println(fi == 3 ? 1 : 0);

    // fcmp: 3.0 > 2.0
    int g = math.fcmp(a, b);
    println(g == 1 ? 1 : 0);

    // fcmp: 2.0 < 3.0
    int h = math.fcmp(b, a);
    println(h == -1 ? 1 : 0);

    // fcmp: 3.0 == 3.0
    int i = math.fcmp(a, a);
    println(i == 0 ? 1 : 0);

    // Fractional: 0.5 + 0.5 = 1.0
    // 0.5 in Q48.16 = 32768
    int half = 32768;
    int sum = math.fadd(half, half);
    int si = math.ftoi(sum);
    println(si == 1 ? 1 : 0);

    return 0;
}
