class Cnt {
    static int n;
}
int bump() {
    Cnt.n = Cnt.n + 1;
    return 1;
}
int main() {
    println(0 && bump());
    println(0 || bump());
    println(1 || bump());
    println(1 && bump());
    println(Cnt.n);
    println(5 && 7);
    println(0 || 0);
    println(3 || 0);
    return 0;
}
