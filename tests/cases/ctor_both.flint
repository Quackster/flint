class Point {
    int x;
    int y;
    public Point(int a, int b) {
        this.x = a + 1;
        this.y = b + 2;
    }
}
class Raw {
    int x;
    int y;
}
class Counter {
    int n;
    public Counter() {
        this.n = 42;
    }
}
int main() {
    Point p = new Point(3, 4);
    print(p.x);
    print(",");
    print(p.y);
    print("\n");
    Raw r = new Raw(10, 20);
    print(r.x);
    print(",");
    print(r.y);
    print("\n");
    Counter c = new Counter();
    print(c.n);
    print("\n");
    Counter c2 = new Counter();
    c2.n = 100;
    print(c2.n);
    print("\n");
    return 0;
}
