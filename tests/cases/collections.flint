import std.List;
import std.Queue;
import std.HashSet;
import std.HashMap;
int main() {
    // ---- list (int) ----
    List<int> l = new List<int>();
    l.add(10); l.add(20); l.add(30);
    print(l.size()); print(" ");
    print(l.get(1)); print(" ");
    l.add(40);
    print(l.size()); print(" ");
    l.set(0, 99);
    print(l.get(0)); print(" ");
    print(l.contains(20)); print(" ");
    print(l.contains(77)); print(" ");
    l.remove(1);
    println(l.get(1));
    l.clear();
    println(l.size());

    // ---- queue ----
    Queue<int> q = new Queue<int>();
    q.push(1); q.push(2); q.push(3);
    print(q.size()); print(" ");
    print(q.peek()); print(" ");
    print(q.pop()); print(" ");
    print(q.pop()); print(" ");
    print(q.size()); print(" ");
    q.clear();
    println(q.size());

    // ---- hashset (int) ----
    HashSet<int> s = new HashSet<int>();
    s.add(5); s.add(10); s.add(15); s.add(10);
    print(s.size()); print(" ");
    print(s.contains(10)); print(" ");
    print(s.contains(99)); print(" ");
    s.remove(10);
    print(s.contains(10)); print(" ");
    println(s.size());
    s.clear();
    println(s.size());

    // ---- hashmap (int keys) ----
    HashMap<int, int> m = new HashMap<int, int>();
    m.put(1, 100); m.put(2, 200); m.put(1, 150);
    print(m.size()); print(" ");
    print(m.get(1)); print(" ");
    print(m.get(2)); print(" ");
    print(m.get(3)); print(" ");
    print(m.contains(2)); print(" ");
    print(m.contains(9)); print(" ");
    m.remove(1);
    println(m.size());
    m.clear();
    println(m.size());

    // ---- hashmap (string keys) ----
    HashMap<string, int> d = new HashMap<string, int>();
    d.put("apple", 1); d.put("banana", 2); d.put("cherry", 3);
    print(d.size()); print(" ");
    print(d.get("banana")); print(" ");
    print(d.get("apple")); print(" ");
    print(d.get("grape")); print(" ");
    print(d.contains("cherry")); print(" ");
    print(d.contains("melon")); print(" ");
    d.remove("banana");
    print(d.contains("banana")); print(" ");
    println(d.size());
    d.clear();
    println(d.size());

    return 0;
}
