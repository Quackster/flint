int main() {
    // ---- list ----
    list l = [10, 20, 30];
    printi(len(l)); print(" ");
    printi(l.get(1)); print(" ");
    l.add(40);
    printi(l.size()); print(" ");
    l[0] = 99;
    printi(l[0]); print(" ");
    printi(l.contains(20)); print(" ");
    printi(l.contains(77)); print(" ");
    l.remove(1);
    printi(l.get(1)); print("\n");
    l.clear();
    printi(l.size()); print("\n");

    // ---- queue ----
    queue q = new queue();
    q.push(1); q.push(2); q.push(3);
    printi(len(q)); print(" ");
    printi(q.peek()); print(" ");
    printi(q.pop()); print(" ");
    printi(q.pop()); print(" ");
    printi(q.size()); print(" ");
    q.clear();
    printi(q.size()); print("\n");

    // ---- hashset ----
    hashset s = new hashset();
    s.add(5); s.add(10); s.add(15); s.add(10);
    printi(len(s)); print(" ");
    printi(s.contains(10)); print(" ");
    printi(s.contains(99)); print(" ");
    s.remove(10);
    printi(s.contains(10)); print(" ");
    printi(len(s)); print("\n");
    s.clear();
    printi(len(s)); print("\n");

    // ---- hashmap (int keys) ----
    hashmap m = new hashmap();
    m.put(1, 100); m.put(2, 200); m.put(1, 150);
    printi(len(m)); print(" ");
    printi(m.get(1)); print(" ");
    printi(m.get(2)); print(" ");
    printi(m.get(3)); print(" ");
    printi(m.contains(2)); print(" ");
    printi(m.contains(9)); print(" ");
    m.remove(1);
    printi(len(m)); print("\n");
    m.clear();
    printi(len(m)); print("\n");

    // ---- dictionary (string keys) ----
    dictionary d = new dictionary();
    d.put("apple", 1); d.put("banana", 2); d.put("cherry", 3);
    printi(len(d)); print(" ");
    printi(d.get("banana")); print(" ");
    printi(d.get("apple")); print(" ");
    printi(d.get("grape")); print(" ");
    printi(d.contains("cherry")); print(" ");
    printi(d.contains("melon")); print(" ");
    d.remove("banana");
    printi(d.contains("banana")); print(" ");
    printi(len(d)); print("\n");
    d.clear();
    printi(len(d)); print("\n");

    return 0;
}
