import std.List;
import std.Queue;
import std.HashSet;
import std.HashMap;
int main() {
    // ---- list (int) ----
    List<int> l = new List<int>();
    l.add(10); l.add(20); l.add(30);
    printi(l.size()); print(" ");
    printi(l.get(1)); print(" ");
    l.add(40);
    printi(l.size()); print(" ");
    l.set(0, 99);
    printi(l.get(0)); print(" ");
    printi(l.contains(20)); print(" ");
    printi(l.contains(77)); print(" ");
    l.remove(1);
    printi(l.get(1)); print("\n");
    l.clear();
    printi(l.size()); print("\n");

    // ---- queue ----
    Queue<int> q = new Queue<int>();
    q.push(1); q.push(2); q.push(3);
    printi(q.size()); print(" ");
    printi(q.peek()); print(" ");
    printi(q.pop()); print(" ");
    printi(q.pop()); print(" ");
    printi(q.size()); print(" ");
    q.clear();
    printi(q.size()); print("\n");

    // ---- hashset (int) ----
    HashSet<int> s = new HashSet<int>();
    s.add(5); s.add(10); s.add(15); s.add(10);
    printi(s.size()); print(" ");
    printi(s.contains(10)); print(" ");
    printi(s.contains(99)); print(" ");
    s.remove(10);
    printi(s.contains(10)); print(" ");
    printi(s.size()); print("\n");
    s.clear();
    printi(s.size()); print("\n");

    // ---- hashmap (int keys) ----
    HashMap<int, int> m = new HashMap<int, int>();
    m.put(1, 100); m.put(2, 200); m.put(1, 150);
    printi(m.size()); print(" ");
    printi(m.get(1)); print(" ");
    printi(m.get(2)); print(" ");
    printi(m.get(3)); print(" ");
    printi(m.contains(2)); print(" ");
    printi(m.contains(9)); print(" ");
    m.remove(1);
    printi(m.size()); print("\n");
    m.clear();
    printi(m.size()); print("\n");

    // ---- hashmap (string keys) ----
    HashMap<string, int> d = new HashMap<string, int>();
    d.put("apple", 1); d.put("banana", 2); d.put("cherry", 3);
    printi(d.size()); print(" ");
    printi(d.get("banana")); print(" ");
    printi(d.get("apple")); print(" ");
    printi(d.get("grape")); print(" ");
    printi(d.contains("cherry")); print(" ");
    printi(d.contains("melon")); print(" ");
    d.remove("banana");
    printi(d.contains("banana")); print(" ");
    printi(d.size()); print("\n");
    d.clear();
    printi(d.size()); print("\n");

    return 0;
}
