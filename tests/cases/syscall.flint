int main() {
    // getpid via the escape hatch (1st syscall arg in rdi)
    int pid = sys.syscall(39, 0, 0, 0, 0, 0);
    println(pid > 0 ? 1 : 0);
    // open /dev/null (2nd syscall arg in rsi)
    *byte devnull = "/dev/null";
    int fd = sys.syscall(2, devnull, 0, 0, 0, 0);
    println(fd >= 0 ? 1 : 0);
    // select: 4th arg (exceptfds) must land in r10, 5th (timeout) in r8
    *byte tv = alloc(16); // zeroed struct timeval
    int r = sys.syscall(23, fd, 0, 0, 0, tv);
    println(r == 0 ? 1 : 0);
    // close (1st syscall arg)
    int c = sys.syscall(3, fd, 0, 0, 0, 0);
    println(c == 0 ? 1 : 0);
    return 0;
}
