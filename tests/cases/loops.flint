// break/continue in while and for; break exits only the innermost loop.
int main() {
    int i = 0;
    int s = 0;
    while (true) {
        i = i + 1;
        if (i == 10) {
            break;
        }
        if (i % 2 == 0) {
            continue;
        }
        s = s + i;
    }
    printi(s);
    print("\n");

    int t = 0;
    for (int j = 0; j < 100; j = j + 1) {
        if (j == 5) {
            break;
        }
        t = t + j;
    }
    printi(t);
    print("\n");

    int u = 0;
    for (int k = 0; k < 10; k = k + 1) {
        if (k % 3 == 0) {
            continue;
        }
        u = u + k;
    }
    printi(u);
    print("\n");

    int outer = 0;
    for (int a = 0; a < 3; a = a + 1) {
        for (int b = 0; b < 5; b = b + 1) {
            if (b == 1) {
                break;
            }
            outer = outer + 1;
        }
    }
    printi(outer);
    print("\n");
    return 0;
}
