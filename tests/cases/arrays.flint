// Arrays: 1D/2D/3D literals, element access, pass-by-pointer, array return,
// array class fields. Arrays are raw pointers to 8-byte slots: no refcount,
// no bounds checks (v1).
class Mat {
    int data[];
    int rows;
    public Mat(int r) { this.rows = r; }
}
int sum(int a[]) {
    int s = 0;
    int i = 0;
    while (i < 4) {
        s = s + a[i];
        i = i + 1;
    }
    return s;
}

*int make() {
    return [7, 8, 9];
}

int grid(int g[][]) {
    return g[1][2] + g[0][0];
}

int main() {
    int a[] = [10, 20, 30, 40];
    print(sum(a));
    print("\n");

    a[1] = 99;
    print(a[1]);
    print("\n");

    a[2]++;
    print(a[2]);
    print("\n");

    *int p = &a[0];
    *p = 5;
    print(a[0]);
    print("\n");

    int g[][] = [[1, 2, 3], [4, 5, 6]];
    print(g[1][2]);
    print("\n");
    print(grid(g));
    print("\n");

    int t[][][] = [[[1, 2], [3, 4]]];
    print(t[0][1][0]);
    print("\n");

    int b[] = make();
    print(b[1]);
    print("\n");

    Mat m = new Mat(2);
    m.data = [10, 20, 30];
    print(m.data[1]);
    print("\n");
    m.data[0] = 1;
    print(m.data[0] + m.rows);
    print("\n");
    return 0;
}
