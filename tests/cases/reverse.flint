// List.reverse must swap every pair; regression for the missing loop
// back-edge that left even-length lists' middle pair unswapped.
import std.List;
int main() {
    List<int> l = new List<int>();
    l.add(1); l.add(2); l.add(3); l.add(4);
    l.reverse();
    print(l.get(0)); print(" ");
    print(l.get(1)); print(" ");
    print(l.get(2)); print(" ");
    println(l.get(3));

    // odd length still works
    List<int> o = new List<int>();
    o.add(1); o.add(2); o.add(3);
    o.reverse();
    print(o.get(0)); print(" ");
    print(o.get(1)); print(" ");
    println(o.get(2));

    // single element: no-op
    List<int> s = new List<int>();
    s.add(9);
    s.reverse();
    println(s.get(0));
    return 0;
}
