class Node {
    int val;
    public Node(int v) { this.val = v; }
}
int main() {
    Node a = new Node(1);
    Node b = a;
    Node c = b;
    print(a.val);
    print("\n");
    print(b.val);
    print("\n");
    print(c.val);
    print("\n");
    a.val = 10;
    print(b.val);
    print("\n");
    // many allocations to stress refcount
    for (int i = 0; i < 100; i++) {
        Node n = new Node(i);
        print(n.val);
        print(",");
    }
    print("\n");
    return 0;
}
