// compound assignment += -= *= /= on locals, array elements, and for-updates.
int main() {
    int a = 10;
    a += 5;
    print(a);
    print("\n");
    a -= 3;
    print(a);
    print("\n");
    a *= 4;
    print(a);
    print("\n");
    a /= 7;
    print(a);
    print("\n");

    int b[] = [2, 3, 4];
    b[0] += 10;
    b[1] *= 3;
    b[2] -= 1;
    print(b[0] + b[1] + b[2]);
    print("\n");

    int c = 100;
    for (int i = 0; i < 5; i += 1) {
        c -= i;
    }
    print(c);
    print("\n");
    return 0;
}
