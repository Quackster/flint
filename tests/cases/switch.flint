// switch: case hits, default, break inside a switch, fallthrough.
int main() {
    int n = 2;
    switch (n) {
        case 1:
            print(10);
            break;
        case 2:
            print(20);
            break;
        default:
            print(99);
    }
    print("\n");

    int m = 7;
    switch (m) {
        case 5:
            print(50);
            break;
        case 6:
            print(60);
            break;
        default:
            print(70);
            break;
    }
    print("\n");

    // break inside a switch inside a loop exits only the switch
    int acc = 0;
    for (int i = 0; i < 4; i = i + 1) {
        switch (i % 2) {
            case 0:
                acc = acc + 10;
                break;
            case 1:
                acc = acc + 1;
                break;
        }
    }
    print(acc);
    print("\n");

    // fallthrough: no break on case 1
    int f = 1;
    switch (f) {
        case 1:
            print(100);
        case 2:
            print(200);
            break;
        default:
            print(300);
    }
    print("\n");
    return 0;
}
