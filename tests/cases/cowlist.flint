// cowlist: std.CopyOnWriteList — copy-on-write semantics: every
// mutator (add/insert/set/remove/removeObject/clear) installs a fresh
// slot array under a lock; readers (get/contains/indexOf/…) never
// lock, and snapshot() — the COW "iterator" — is a plain List<T> that
// later mutations do not affect.
import std.CopyOnWriteList;
import std.List;
import std.Thread;

class Holder {
    static CopyOnWriteList<int> shared;
}

// A worker appends 25 values to the shared list
int worker(int tid) {
    int k = 0;
    while (k < 25) {
        Holder.shared.add(tid * 1000 + k);
        k = k + 1;
    }
    return tid;
}

class Box {
    static int destroyed;
    int id;
    public Box(int i) { this.id = i; }
    public int id() { return this.id; }
    void destroy() { Box.destroyed = Box.destroyed + 1; }
}

int main() {
    // ---- int semantics ----
    CopyOnWriteList<int> l = new CopyOnWriteList<int>();
    println(l.size());               // 0
    println(l.isEmpty());           // 1
    l.add(10); l.add(20); l.add(30);
    println(l.size());             // 3
    println(l.get(1));            // 20
    l.insert(1, 5);
    println(l.get(1));           // 5
    println(l.get(5));           // 0 (out of range)
    int old = l.set(0, 99);
    println(old);                // 10
    println(l.set(9, 7));        // 0 (out of range: no change)
    println(l.get(0));           // 99
    int gone = l.remove(1);
    println(gone);               // 5
    println(l.remove(9));        // 0 (out of range)
    println(l.size());           // 3
    println(l.contains(99));     // 1
    println(l.contains(77));     // 0
    println(l.indexOf(20));      // 1
    println(l.indexOf(77));      // -1
    println(l.lastIndexOf(30));   // 2
    println(l.lastIndexOf(99));   // 0
    println(l.lastIndexOf(77));   // -1
    println(l.removeObject(20)); // 1
    println(l.contains(20));     // 0
    println(l.removeObject(77)); // 0
    print(l.join("-")); print("\n");         // 99-30
    // snapshot: later mutations do not affect it
    List<int> snap = l.snapshot();
    l.add(40);
    println(snap.size());         // 2
    println(l.size());           // 3
    l.clear();
    println(l.size());           // 0
    println(l.isEmpty());        // 1
    println(l.get(0));           // 0 (now empty)
    // ---- string elements ----
    CopyOnWriteList<string> s = new CopyOnWriteList<string>();
    s.add("b"); s.add("a"); s.add("c");
    print(s.join("|")); print("\n");          // b|a|c
    print(s.get(1)); print("\n");             // a
    println(s.contains("a"));     // 1
    println(s.contains("z"));     // 0
    println(s.indexOf("c"));      // 2
    println(s.lastIndexOf("b"));  // 0
    string displaced = s.set(0, "z");
    print(displaced); print("\n");            // b (displaced, returned)
    print(s.get(0)); print("\n");             // z
    println(s.removeObject("a")); // 1
    print(s.join("|")); print("\n");          // z|c
    // ---- object elements (kind 2): retained on store, released on
    // remove; the Box must survive while a local still holds it ----
    Box x = new Box(7);
    if (1) {
        CopyOnWriteList<Box> o = new CopyOnWriteList<Box>();
        o.add(x);
        Box old2 = o.set(0, x);
        println(old2.id() == 7 ? 1 : 0);  // 1
        List<Box> osnap = o.snapshot();
        println(osnap.size());            // 1
        o.remove(0);
        println(o.size());               // 0
    }
    println(x.id());                     // 7
    println(Box.destroyed);             // 0 (still referenced by main)
    // ---- four workers append 25 values each ----
    Holder.shared = new CopyOnWriteList<int>();
    int k = 0;
    while (k < 4) {
        Thread.spawn(@worker, k);
        k = k + 1;
    }
    k = 0;
    while (k < 4) {
        Thread.join(k);
        k = k + 1;
    }
    println(Holder.shared.size());      // 100
    int ok = 1;
    k = 0;
    while (k < 4) {
        int j = 0;
        while (j < 25) {
            if (Holder.shared.contains(k * 1000 + j) == 0) {
                ok = 0;
            }
            j = j + 1;
        }
        k = k + 1;
    }
    println(ok);                        // 1
    return 0;
}
