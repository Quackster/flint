enum Color {
    Red,
    Green,
    Blue,
}

enum Status {
    Active = 10,
    Inactive,
}

int main() {
    // sequential values start at 0
    println(Color.Red == 0 ? 1 : 0);
    println(Color.Green == 1 ? 1 : 0);
    println(Color.Blue == 2 ? 1 : 0);
    // explicit value, then sequential from there
    println(Status.Active == 10 ? 1 : 0);
    println(Status.Inactive == 11 ? 1 : 0);
    // usable in expressions
    int x = Color.Blue + 1;
    println(x == 3 ? 1 : 0);
    // typed declaration
    Color c = Color.Green;
    println(c == 1 ? 1 : 0);
    return 0;
}
