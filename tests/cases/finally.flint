int fin_ret() {
    try {
        return 5;
    } catch (int e) {
        return e;
    } finally {
        println(3);
    }
}
int main() {
    try {
        println(1);
    } catch (int e) {
        println(2);
    } finally {
        println(3);
    }
    try {
        throw 42;
    } catch (int e) {
        println(e);
    } finally {
        println(3);
    }
    int x = fin_ret();
    println(x);
    return 0;
}
