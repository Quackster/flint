// The stdlib collections carry a per-collection flavour, pinned by the
// type parameter (baked into `kind`, or `kkind`/`vkind` on HashMap):
// 0 int, 1 string, 2 object. This test exercises each flavour.
import std.List;
import std.Queue;
import std.HashSet;
import std.HashMap;
int main() {
    // ---- List of ints ----
    List<int> li = new List<int>();
    li.add(10); li.add(20); li.add(30);
    print(li.size()); print(" ");
    print(li.get(1)); print(" ");
    li.add(40);
    print(li.size()); print(" ");
    li.set(0, 99);
    print(li.get(0)); print(" ");
    print(li.contains(20)); print(" ");
    print(li.contains(77)); print(" ");
    li.remove(1);
    println(li.get(1));
    li.clear();
    println(li.size());

    // ---- List of strings ----
    List<string> ls = new List<string>();
    ls.add("a"); ls.add("b"); ls.add("a");
    print(ls.size()); print(" ");
    print(ls.contains("a")); print(" ");
    print(ls.contains("z")); print(" ");
    print(ls.get(1)); print("\n");

    // ---- HashMap int -> int ----
    HashMap<int, int> m = new HashMap<int, int>();
    m.put(1, 100); m.put(2, 200); m.put(1, 150);
    print(m.size()); print(" ");
    print(m.get(1)); print(" ");
    print(m.get(2)); print(" ");
    print(m.get(3)); print(" ");
    print(m.contains(2)); print(" ");
    print(m.contains(9)); print(" ");
    m.remove(1);
    println(m.size());
    m.clear();
    println(m.size());

    // ---- HashMap string -> int ----
    HashMap<string, int> d = new HashMap<string, int>();
    d.put("apple", 1); d.put("banana", 2); d.put("cherry", 3);
    print(d.size()); print(" ");
    print(d.get("banana")); print(" ");
    print(d.get("apple")); print(" ");
    print(d.get("grape")); print(" ");
    print(d.contains("cherry")); print(" ");
    d.remove("banana");
    print(d.contains("banana")); print(" ");
    println(d.size());
    d.clear();
    println(d.size());

    // ---- HashSet of ints ----
    HashSet<int> s = new HashSet<int>();
    s.add(5); s.add(10); s.add(15); s.add(10);
    print(s.size()); print(" ");
    print(s.contains(10)); print(" ");
    print(s.contains(99)); print(" ");
    s.remove(10);
    print(s.contains(10)); print(" ");
    println(s.size());
    s.clear();
    println(s.size());

    // ---- HashSet of strings ----
    HashSet<string> ss = new HashSet<string>();
    ss.add("one"); ss.add("two"); ss.add("one");
    print(ss.size()); print(" ");
    print(ss.contains("two")); print(" ");
    print(ss.contains("nine")); print(" ");
    ss.remove("two");
    print(ss.contains("two")); print(" ");
    println(ss.size());
    ss.clear();
    println(ss.size());

    // ---- Queue of ints ----
    Queue<int> q = new Queue<int>();
    q.push(1); q.push(2); q.push(3);
    print(q.size()); print(" ");
    print(q.peek()); print(" ");
    print(q.pop()); print(" ");
    print(q.pop()); print(" ");
    print(q.size()); print(" ");
    q.clear();
    println(q.size());

    return 0;
}
