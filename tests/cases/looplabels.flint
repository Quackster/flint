int main() {
    int i = 0;
    int j = 0;
    outer:
    for (i = 0; i < 3; i = i + 1) {
        for (j = 0; j < 3; j = j + 1) {
            if (j == 1) {
                break outer;
            }
        }
    }
    printi(i); print("\n");
    int n = 0;
    int k = 0;
    outer2:
    for (n = 0; n < 4; n = n + 1) {
        for (k = 0; k < 2; k = k + 1) {
            if (n == 2) {
                continue outer2;
            }
            printi(n * 10 + k); print("\n");
        }
    }
    int m = 0;
    lbl:
    while (m < 10) {
        m = m + 1;
        if (m == 3) {
            break lbl;
        }
    }
    printi(m); print("\n");
    return 0;
}
