class Counter {
    static int n;
    int id;
    void Counter(int i) { this.id = i; }
}

int main() {
    Counter.n = 5;
    Counter c = new Counter(1);
    println(Counter.n == 5 ? 1 : 0);
    Counter.n = Counter.n + 3;
    println(Counter.n == 8 ? 1 : 0);
    // instance fields still work alongside statics
    println(c.id == 1 ? 1 : 0);
    return 0;
}
