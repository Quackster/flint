class Point {
    int x;
    int y;
    public Point(int a, int b) { this.x = a; this.y = b; }
    public int sum() { return x + y; }
}
int foo() {
    Point p = new Point(3, 4);
    // p does not escape this function; compiler may stack-allocate
    return p.sum();
}
int main() {
    print(foo());
    print("\n");
    // loop with stack-local objects
    for (int i = 0; i < 5; i++) {
        Point q = new Point(i, i*2);
        print(q.sum());
        print("\n");
    }
    return 0;
}
