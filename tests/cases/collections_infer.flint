// Each collection pins its element flavour in its type parameter (the
// compiler bakes it into the `kind` field: 0 int, 1 string, 2 object;
// HashMap has `kkind`/`vkind`). This test drives string sets,
// string-keyed maps, string-valued maps, and the keys()/values()
// accessors.
import std.List;
import std.HashSet;
import std.HashMap;
int main() {
    // hashset with string elements (kind = 1)
    HashSet<string> s = new HashSet<string>();
    s.add("hello"); s.add("world"); s.add("hello");
    print(s.size()); print(" ");
    print(s.contains("world")); print(" ");
    print(s.contains("nope")); print(" ");
    s.remove("world");
    println(s.contains("world"));

    // int-keyed map
    HashMap<int, int> m = new HashMap<int, int>();
    m.put(1, 10);
    m.put(2, 20);
    print(m.size()); print(" ");
    print(m.get(1)); print(" ");
    print(m.get(2)); print(" ");
    print(m.contains(2)); print(" ");
    println(m.contains(1));

    // string values (vkind = 1); get() returns a string
    HashMap<int, string> d = new HashMap<int, string>();
    d.put(1, "one");
    d.put(2, "two");
    string w = d.get(2);
    print(w); print(" ");
    int missing = d.get(9);
    println(missing);

    // {...} equivalent: build a set of ints
    HashSet<int> ls = new HashSet<int>();
    ls.add(3); ls.add(4); ls.add(5);
    print(ls.size()); print(" ");
    println(ls.contains(4));

    // build a string-keyed map (int values)
    HashMap<string, int> lm = new HashMap<string, int>();
    lm.put("seven", 7); lm.put("eight", 8);
    print(lm.size()); print(" ");
    print(lm.get("eight")); print(" ");
    println(lm.get("seven"));

    // [...] equivalent: build a list of ints
    List<int> li = new List<int>();
    li.add(10); li.add(20); li.add(30);
    print(li.size()); print(" ");
    println(li.get(2));

    // keys() / values() return a fresh List
    List<int> ks = m.keys();
    println(ks.size());
    List<int> vs = m.values();
    println(vs.size());
    return 0;
}
