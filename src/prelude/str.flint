// prelude/str — string operations on NUL-terminated (*u8) strings.
//
//   strlen(s) -> int   byte length (up to the first NUL)
//   str.concat(a, b) -> *byte   a + b (both strings)
//   str.concati(s, n) -> *byte  s + itoa(n) (string + int)
//   str.itoa(n) -> *byte        decimal string for an int
//
// String literals lower to `.asciz` in .rodata; `print(s)` writes one.
int main() {
    println(strlen("flint"));
    println(strlen("hello, world"));
    println(str.concati("answer: ", 42));
    println(str.itoa(-17));
    return 0;
}
