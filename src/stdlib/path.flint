// std/path — string path utilities (import std.Path).
package std;
class Path {
    static int lastSlash(string p) {
        int n = strlen(p);
        int last = -1;
        for (int i = 0; i < n; i = i + 1) {
            if (sys.byteLoad(p + i) == 47) {
                last = i;
            }
        }
        return last;
    }
    static int lastDot(string p) {
        int n = strlen(p);
        int last = -1;
        for (int i = 0; i < n; i = i + 1) {
            if (sys.byteLoad(p + i) == 46) {
                last = i;
            }
        }
        return last;
    }
    // "a/b/c.txt" -> "c.txt" (the whole string when there is no slash).
    static string base(string p) {
        int i = Path.lastSlash(p);
        int n = strlen(p);
        if (i < 0) {
            return str.copy(p);
        }
        if (i == n - 1) {
            return "";
        }
        return str.substring(p, i + 1, n - i - 1);
    }
    // "a/b/c.txt" -> "a/b" ("" for a top-level path).
    static string dir(string p) {
        int i = Path.lastSlash(p);
        if (i <= 0) {
            return "";
        }
        return str.substring(p, 0, i);
    }
    // "a/b/c.txt" -> "txt"; "" when there is no extension.
    static string ext(string p) {
        string b = Path.base(p);
        int n = strlen(b);
        int i = Path.lastDot(b);
        if (i < 1 || i == n - 1) {
            return "";
        }
        return str.substring(b, i + 1, n - i - 1);
    }
    // Joins with exactly one slash between parts.
    static string join(string a, string b) {
        int na = strlen(a);
        if (na == 0) {
            return str.copy(b);
        }
        if (sys.byteLoad(a + na - 1) == 47) {
            return a + b;
        }
        return a + "/" + b;
    }
    static string parent(string p) { return Path.dir(p); }
    // 1 when the path starts with a slash.
    static int isAbsolute(string p) {
        return strlen(p) > 0 && sys.byteLoad(p) == 47 ? 1 : 0;
    }
    // Split p into its slash-separated parts.
    static list<string> split(string p) {
        list<string> out = new list<string>();
        int n = strlen(p);
        int start = 0;
        int i = 0;
        while (i < n) {
            if (sys.byteLoad(p + i) == 47) {
                out.add(str.substring(p, start, i - start));
                i = i + 1;
                start = i;
            } else {
                i = i + 1;
            }
        }
        out.add(str.substring(p, start, n - start));
        return out;
    }
    // Collapse ".", ".." and repeated slashes (returns the relative form).
    static string normalize(string p) {
        list<string> parts = Path.split(p);
        list<string> stack = new list<string>();
        int i = 0;
        int n = len(parts);
        while (i < n) {
            string s = parts.get(i);
            if (str.cmp(s, ".") != 0 && str.cmp(s, "") != 0) {
                if (str.cmp(s, "..") == 0) {
                    if (len(stack) > 0) {
                        stack.remove(len(stack) - 1);
                    }
                } else {
                    stack.add(s);
                }
            }
            i = i + 1;
        }
        if (len(stack) == 0) {
            return ".";
        }
        string out = "";
        int j = 0;
        int ns = len(stack);
        while (j < ns) {
            if (j > 0) {
                out = out + "/";
            }
            out = out + stack.get(j);
            j = j + 1;
        }
        return out;
    }
}
