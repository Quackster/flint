    // PasswordBox, NumberBox and TextArea have their own slots: they
    // override TextBox methods, so sharing TextBox slots would dispatch
    // to the wrong method. Only plain TextBox objects go in addBox.
    public void addPass(PasswordBox t) {
        if (this.npass == 0) { this.pass0 = t; }
        else if (this.npass == 1) { this.pass1 = t; }
        else if (this.npass == 2) { this.pass2 = t; }
