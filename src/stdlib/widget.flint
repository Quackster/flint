    }
    // Pump and dispatch all pending events for this frame. Button
    // presses (state 1) dispatch presses, releases (state 0) dispatch
    // releases so buttons fire on release-inside and sliders ungrab.
    public void step() {
        if (this.win == null) {
            return;
        }
        int e = this.win.peekEvent();
        while (e != 0) {
            if (e == Window.CLOSE()) {
                // Quitting (or a dead connection, which also reads as
                // CLOSE): stop pumping at once. (A dead connection
                // reports CLOSE at most once; further peeks return 0.)
                this.running = 0;
                return;
            } else if (e == Window.BUTTON()) {
                if (this.win.evState() == 1) {
                    this.dispatchPress(this.win.evX(), this.win.evY());
                } else {
                    this.dispatchRelease(this.win.evX(), this.win.evY());
                }
            } else if (e == Window.MOTION()) {
                this.dispatchMotion(this.win.evX(), this.win.evY());
            } else if (e == Window.KEY()) {
                if (this.win.evState() == 1) {
                    this.dispatchKey(this.win.evKey(), this.win.evMods());
                }
            }
            e = this.win.peekEvent();
        }
    }
