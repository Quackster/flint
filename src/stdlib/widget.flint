// std/widget — small widgets for std.Window: Label, TextBox and the
// form inputs PasswordBox, NumberBox, TextArea, Button, Checkbox,
// RadioButton, Slider and Dropdown, held in a Gui container that pumps
// input events and dispatches them to the widgets (import std.Gui,
// std.Label, std.TextBox, std.Widget).
//
// Widgets draw into a std.Image canvas which the application blits to
// the window with Window.present. A typical program:
//
//   import std.Window;
//   import std.Gui;
//   import std.Image;
//   Window w = Window.open(480, 200, "flint gui");
//   if (w == null) { print("no display\n"); return 0; }
//   Gui gui = new Gui(w);
//   Label label = new Label(16, 12, 200, 16, "Hello");
//   TextBox box = new TextBox(16, 44, 240, 30, 32);
//   gui.addLabel(label);
//   gui.addBox(box);
//   Image c = new Image(480, 200);
//   while (w.running() && gui.running() == 1) {
//       gui.step();                 // pump + dispatch pending events
//       if (box.entered() == 1) {  // ... use box.text() ...
//           box.clearEntered();
//       }
//       c.fill(Image.rgb(16, 16, 32));
//       gui.draw(c);
//       w.present(c);
//   }
//
// Note: the compiler has a refcount bug for object arrays (re-reading
// an element underflows a refcount and segfaults at exit), so Gui
// holds fixed-capacity named fields per widget kind (8 of each) rather
// than an object array.
package std;

// Shared widget geometry.
//
// NOTE on method calls: flintc dispatches every method call through
// the static type's vtable, whose slots follow declaration order
// (own methods first, then inherited ones). A subclass that declares
// methods in a different order gets different slots, so calling a
// method through a base-typed reference holding a subclass object
// runs the WRONG method. This file therefore never does that: every
// Gui slot, local and focused reference uses the concrete widget
// type, subclass objects live only in concretely-typed slots, and
// overrides talk to their parent via super (which bypasses the
// vtable). Keep it that way.
class Widget {
    int x; int y; int w; int h;
    public Widget(int x, int y, int w, int h) {
        this.x = x; this.y = y; this.w = w; this.h = h;
    }
    // 1 when (px, py) is inside the widget (right/bottom edge excluded).
    public int hit(int px, int py) {
        return (px >= this.x && px < this.x + this.w
                && py >= this.y && py < this.y + this.h) ? 1 : 0;
    }
}

// A non-interactive text label.
class Label extends Widget {
    string str;
    int color;
    public Label(int x, int y, int w, int h, string str) {
        super(x, y, w, h);
        this.str = str;
        this.color = 0xFFFFFFFF;
    }
    public string text() { return this.str; }
    public void setText(string t) { this.str = t; }
    public void draw(Image im) {
        im.text(this.x, this.y, this.str, this.color);
    }
}

// A single-line text input. Takes keyboard focus; printable keys
// append, Backspace deletes, Return sets the `entered` flag.
class TextBox extends Widget {
    string buf;   // max+1 bytes, always NUL-terminated
    int max;
    int len;
    int focused;
    int entered;
    public TextBox(int x, int y, int w, int h, int max) {
        super(x, y, w, h);
        this.max = max;
        this.buf = alloc(max + 1);
        sys.byteStore(this.buf, 0);
        this.len = 0;
        this.focused = 0;
        this.entered = 0;
    }
    public string text() { return this.buf; }
    public int length() { return this.len; }
    public int entered() { return this.entered; }
    public void clear() {
        this.len = 0;
        sys.byteStore(this.buf, 0);
        this.entered = 0;
    }
    public void clearEntered() { this.entered = 0; }
    public void onPress(int px, int py) {
        if (this.hit(px, py)) {
            this.focused = 1;
        }
    }
    // 1 when (px, py) hits this box; claims keyboard focus.
    public int claimFocus(int px, int py) {
        if (this.hit(px, py)) {
            this.focused = 1;
            return 1;
        }
        return 0;
    }
    public void blur() { this.focused = 0; }
    // Handle a key press (evdev key code, modifier mask from
    // Window.evMods).
    public void onKey(int code, int mods) {
        if (this.focused != 1) {
            return;
        }
        if (code == 14) {
            this.backspace();
            return;
        }
        if (code == 28) {
            this.entered = 1;
            return;
        }
        int c = TextBox.keyChar(code, mods);
        if (c > 0) {
            this.append(c);
        }
    }
    // Map (evdev key code, modifier mask) to an ASCII character for a
    // US keyboard, or 0 when the key produces no character. Shift
    // (bits 1 and 4) upper-cases letters and picks shifted symbols;
    // Caps Lock (bits 2 and 32) toggles letter case.
    static int keyChar(int code, int mods) {
        int shifted = (mods & 1) != 0 || (mods & 4) != 0;
        int caps = (mods & 2) != 0 || (mods & 32) != 0;
        int c = Window.keyChar(code);
        if (c < 32 || c > 126) {
            return 0;
        }
        if (c >= 97 && c <= 122) {
            if (shifted == 1 || caps == 1) {
                return c - 32;
            }
            return c;
        }
        if (shifted == 1) {
            return TextBox.shifted(c);
        }
        return c;
    }
    // The shifted symbol for an unshifted US punctuation/digit code.
    static int shifted(int c) {
        if (c == 49) { return 33; }    // 1 !
        if (c == 50) { return 64; }    // 2 @
        if (c == 51) { return 35; }    // 3 #
        if (c == 52) { return 36; }    // 4 $
        if (c == 53) { return 37; }    // 5 %
        if (c == 54) { return 94; }    // 6 ^
        if (c == 55) { return 38; }    // 7 &
        if (c == 56) { return 42; }    // 8 *
        if (c == 57) { return 40; }    // 9 (
        if (c == 48) { return 41; }    // 0 )
        if (c == 45) { return 95; }    // - _
        if (c == 61) { return 43; }    // = +
        if (c == 91) { return 123; }   // [ {
        if (c == 93) { return 125; }   // ] }
        if (c == 92) { return 124; }   // \ |
        if (c == 59) { return 58; }    // ; :
        if (c == 39) { return 34; }    // apostrophe "
        if (c == 44) { return 60; }    // , <
        if (c == 46) { return 62; }    // . >
        if (c == 47) { return 63; }    // / ?
        return c;
    }
    public void append(int c) {
        if (this.len >= this.max) {
            return;
        }
        sys.byteStore(this.buf + this.len, c);
        this.len = this.len + 1;
        sys.byteStore(this.buf + this.len, 0);
    }
    public void backspace() {
        if (this.len <= 0) {
            return;
        }
        this.len = this.len - 1;
        sys.byteStore(this.buf + this.len, 0);
    }
    public void draw(Image im) {
        int border = this.focused == 1 ? 0xFFFFFF00 : 0xFF666688;
        im.fillRect(this.x, this.y, this.w, this.h, 0xFF222233);
        im.rect(this.x, this.y, this.w, this.h, border);
        im.text(this.x + 4, this.y + (this.h - 7) / 2, this.buf, 0xFFFFFFFF);
    }
}

// A password box: a TextBox that draws bullets instead of its text.
class PasswordBox extends TextBox {
    string mask;   // max+1 bytes of '*' shadowing buf, NUL-terminated
    public PasswordBox(int x, int y, int w, int h, int max) {
        super(x, y, w, h, max);
        this.mask = alloc(max + 1);
        sys.byteStore(this.mask, 0);
    }
    public void append(int c) {
        int was = this.len;
        super.append(c);
        if (this.len > was) {
            sys.byteStore(this.mask + this.len - 1, 42);
            sys.byteStore(this.mask + this.len, 0);
        }
    }
    public void backspace() {
        super.backspace();
        sys.byteStore(this.mask + this.len, 0);
    }
    public void clear() {
        super.clear();
        sys.byteStore(this.mask, 0);
    }
    // TextBox.onPress/claimFocus call this.hit(), which would dispatch
    // to the wrong slot on a PasswordBox object, so test geometry inline
    // here (same rule as NumberBox/TextArea below).
    public void onPress(int px, int py) {
        if (px >= this.x && px < this.x + this.w
                && py >= this.y && py < this.y + this.h) {
            this.focused = 1;
        }
    }
    public int claimFocus(int px, int py) {
        if (px >= this.x && px < this.x + this.w
                && py >= this.y && py < this.y + this.h) {
            this.focused = 1;
            return 1;
        }
        return 0;
    }
    public void onKey(int code, int mods) {
        if (this.focused != 1) {
            return;
        }
        if (code == 14) {
            this.backspace();
            return;
        }
        if (code == 28) {
            this.entered = 1;
            return;
        }
        int c = TextBox.keyChar(code, mods);
        if (c > 0) {
            this.append(c);
        }
    }
    public void draw(Image im) {
        int border = this.focused == 1 ? 0xFFFFFF00 : 0xFF666688;
        im.fillRect(this.x, this.y, this.w, this.h, 0xFF222233);
        im.rect(this.x, this.y, this.w, this.h, border);
        im.text(this.x + 4, this.y + (this.h - 7) / 2, this.mask, 0xFFFFFFFF);
    }
}

// A single-line integer input. Only digits (and a leading minus) are
// accepted; Up/Down step the value. value() parses with atoi.
class NumberBox extends TextBox {
    public NumberBox(int x, int y, int w, int h, int max) {
        super(x, y, w, h, max);
    }
    // Inline geometry: inherited onPress/claimFocus call this.hit(),
    // which misdispatches on subclass objects (see PasswordBox).
    public void onPress(int px, int py) {
        if (px >= this.x && px < this.x + this.w
                && py >= this.y && py < this.y + this.h) {
            this.focused = 1;
        }
    }
    public int claimFocus(int px, int py) {
        if (px >= this.x && px < this.x + this.w
                && py >= this.y && py < this.y + this.h) {
            this.focused = 1;
            return 1;
        }
        return 0;
    }
    public void onKey(int code, int mods) {
        if (this.focused != 1) {
            return;
        }
        if (code == 14) {
            this.backspace();
            return;
        }
        if (code == 28) {
            this.entered = 1;
            return;
        }
        if (code == 103) {
            this.setValue(this.value() + 1);
            return;
        }
        if (code == 108) {
            this.setValue(this.value() - 1);
            return;
        }
        int c = TextBox.keyChar(code, mods);
        if (c >= 48 && c <= 57) {
            this.append(c);
            return;
        }
        if (c == 45 && this.len == 0) {
            this.append(c);
            return;
        }
    }
    public int value() { return atoi(this.buf); }
    public void setValue(int v) {
        this.clear();
        string s = str.itoa(v);
        int i = 0;
        while (i < strlen(s)) {
            this.append(sys.byteLoad(s + i));
            i = i + 1;
        }
    }
}

// A multi-line text input. Return inserts a newline instead of setting
// the entered flag; lines draw top-down, 8 pixels apart.
class TextArea extends TextBox {
    public TextArea(int x, int y, int w, int h, int max) {
        super(x, y, w, h, max);
    }
    // Inline geometry: inherited onPress/claimFocus call this.hit(),
    // which misdispatches on subclass objects (see PasswordBox).
    public void onPress(int px, int py) {
        if (px >= this.x && px < this.x + this.w
                && py >= this.y && py < this.y + this.h) {
            this.focused = 1;
        }
    }
    public int claimFocus(int px, int py) {
        if (px >= this.x && px < this.x + this.w
                && py >= this.y && py < this.y + this.h) {
            this.focused = 1;
            return 1;
        }
        return 0;
    }
    public void onKey(int code, int mods) {
        if (this.focused != 1) {
            return;
        }
        if (code == 14) {
            this.backspace();
            return;
        }
        if (code == 28) {
            this.append(10);
            return;
        }
        int c = TextBox.keyChar(code, mods);
        if (c > 0) {
            this.append(c);
        }
    }
    public int lines() {
        int n = 1;
        int i = 0;
        while (i < this.len) {
            if (sys.byteLoad(this.buf + i) == 10) {
                n = n + 1;
            }
            i = i + 1;
        }
        return n;
    }
    public void draw(Image im) {
        int border = this.focused == 1 ? 0xFFFFFF00 : 0xFF666688;
        im.fillRect(this.x, this.y, this.w, this.h, 0xFF222233);
        im.rect(this.x, this.y, this.w, this.h, border);
        int y = this.y + 4;
        int ls = 0;
        int i = 0;
        while (i <= this.len) {
            int c = 10;
            if (i < this.len) {
                c = sys.byteLoad(this.buf + i);
            }
            if (c == 10) {
                if (y + 7 < this.y + this.h) {
                    sys.byteStore(this.buf + i, 0);
                    im.text(this.x + 4, y, this.buf + ls, 0xFFFFFFFF);
                    sys.byteStore(this.buf + i, c);
                }
                y = y + 8;
                ls = i + 1;
            }
            i = i + 1;
        }
    }
}

// A push button: pressing inside arms it, releasing inside fires
// clicked(). Space/Return also clicks it while focused.
class Button extends Widget {
    string str;
    int focused;
    int pressed;
    int clicked;
    public Button(int x, int y, int w, int h, string str) {
        super(x, y, w, h);
        this.str = str;
        this.focused = 0;
        this.pressed = 0;
        this.clicked = 0;
    }
    public string text() { return this.str; }
    public void setText(string t) { this.str = t; }
    public int clicked() { return this.clicked; }
    public void clearClicked() { this.clicked = 0; }
    public void onPress(int px, int py) {
        if (this.hit(px, py)) {
            this.pressed = 1;
        }
    }
    public void onRelease(int px, int py) {
        if (this.pressed == 1 && this.hit(px, py)) {
            this.clicked = 1;
        }
        this.pressed = 0;
    }
    public int claimFocus(int px, int py) {
        if (this.hit(px, py)) {
            this.focused = 1;
            return 1;
        }
        return 0;
    }
    public void blur() { this.focused = 0; }
    public void onKey(int code, int mods) {
        if (this.focused != 1) {
            return;
        }
        if (code == 28 || code == 57) {
            this.clicked = 1;
        }
    }
    public void draw(Image im) {
        int bg = 0xFF222233;
        if (this.pressed == 1) {
            bg = 0xFF111122;
        }
        int border = 0xFF666688;
        if (this.focused == 1) {
            border = 0xFFFFFF00;
        }
        im.fillRect(this.x, this.y, this.w, this.h, bg);
        im.rect(this.x, this.y, this.w, this.h, border);
        int tw = im.textWidth(this.str);
        int tx = this.x + 4;
        if (tw < this.w - 8) {
            tx = this.x + (this.w - tw) / 2;
        }
        im.text(tx, this.y + (this.h - 7) / 2, this.str, 0xFFFFFFFF);
    }
}

// A labeled checkbox: click or Space toggles it.
class Checkbox extends Widget {
    string str;
    int checked;
    int focused;
    public Checkbox(int x, int y, int w, int h, string str) {
        super(x, y, w, h);
        this.str = str;
        this.checked = 0;
        this.focused = 0;
    }
    public string text() { return this.str; }
    public int checked() { return this.checked; }
    public void setChecked(int v) { this.checked = v == 0 ? 0 : 1; }
    public void toggle() { this.checked = 1 - this.checked; }
    public void onPress(int px, int py) {
        if (this.hit(px, py)) {
            this.toggle();
        }
    }
    public int claimFocus(int px, int py) {
        if (this.hit(px, py)) {
            this.focused = 1;
            return 1;
        }
        return 0;
    }
    public void blur() { this.focused = 0; }
    public void onKey(int code, int mods) {
        if (this.focused != 1) {
            return;
        }
        if (code == 57) {
            this.toggle();
        }
    }
    public void draw(Image im) {
        int border = 0xFF666688;
        if (this.focused == 1) {
            border = 0xFFFFFF00;
        }
        int by = this.y + (this.h - 9) / 2;
        im.fillRect(this.x, by, 9, 9, 0xFF222233);
        im.rect(this.x, by, 9, 9, border);
        if (this.checked == 1) {
            im.text(this.x + 2, by + 1, "X", 0xFFFFFFFF);
        }
        im.text(this.x + 14, this.y + (this.h - 7) / 2, this.str, 0xFFFFFFFF);
    }
}

// A labeled radio button. Buttons sharing a group id are exclusive:
// selecting one deselects the rest (Gui enforces this on press).
class RadioButton extends Widget {
    string str;
    int group;
    int selected;
    int focused;
    public RadioButton(int x, int y, int w, int h, string str) {
        super(x, y, w, h);
        this.str = str;
        this.group = 0;
        this.selected = 0;
        this.focused = 0;
    }
    public string text() { return this.str; }
    public int group() { return this.group; }
    public void setGroup(int g) { this.group = g; }
    public int selected() { return this.selected; }
    public void setSelected(int v) { this.selected = v == 0 ? 0 : 1; }
    public void onPress(int px, int py) {
        if (this.hit(px, py)) {
            this.selected = 1;
        }
    }
    public int claimFocus(int px, int py) {
        if (this.hit(px, py)) {
            this.focused = 1;
            return 1;
        }
        return 0;
    }
    public void blur() { this.focused = 0; }
    public void onKey(int code, int mods) {
        if (this.focused != 1) {
            return;
        }
        if (code == 57) {
            this.selected = 1;
        }
    }
    public void draw(Image im) {
        int border = 0xFF666688;
        if (this.focused == 1) {
            border = 0xFFFFFF00;
        }
        int cx = this.x + 5;
        int cy = this.y + this.h / 2;
        im.circle(cx, cy, 4, border);
        if (this.selected == 1) {
            im.fillCircle(cx, cy, 2, 0xFFFFFFFF);
        }
        im.text(this.x + 12, this.y + (this.h - 7) / 2, this.str, 0xFFFFFFFF);
    }
}

// A horizontal slider: click or drag the track, or Left/Right (+Shift
// for x10) while focused. Up adds 10, Down subtracts 10.
class Slider extends Widget {
    int min;
    int max;
    int value;
    int grabbed;
    int focused;
    public Slider(int x, int y, int w, int h, int max) {
        super(x, y, w, h);
        this.min = 0;
        this.max = max;
        this.value = 0;
        this.grabbed = 0;
        this.focused = 0;
    }
    public int value() { return this.value; }
    public void setMin(int m) {
        this.min = m;
        this.setValue(this.value);
    }
    public void setMax(int m) {
        this.max = m;
        this.setValue(this.value);
    }
    public void setValue(int v) {
        if (v < this.min) {
            v = this.min;
        }
        if (v > this.max) {
            v = this.max;
        }
        this.value = v;
    }
    public void setFromX(int px) {
        if (this.w <= 0 || this.max <= this.min) {
            return;
        }
        this.setValue(this.min + (px - this.x) * (this.max - this.min) / this.w);
    }
    public void onPress(int px, int py) {
        if (this.hit(px, py)) {
            this.grabbed = 1;
            this.setFromX(px);
        }
    }
    public void onDrag(int px) {
        if (this.grabbed == 1) {
            this.setFromX(px);
        }
    }
    public void onRelease() { this.grabbed = 0; }
    public int claimFocus(int px, int py) {
        if (this.hit(px, py)) {
            this.focused = 1;
            return 1;
        }
        return 0;
    }
    public void blur() { this.focused = 0; }
    public void onKey(int code, int mods) {
        if (this.focused != 1) {
            return;
        }
        int step = 1;
        if (mods == 1 || mods == 4) {
            step = 10;
        }
        if (code == 105 || code == 108) {
            this.setValue(this.value - step);
        } else if (code == 106 || code == 103) {
            this.setValue(this.value + step);
        }
    }
    public void draw(Image im) {
        int border = 0xFF666688;
        if (this.focused == 1) {
            border = 0xFFFFFF00;
        }
        im.fillRect(this.x, this.y, this.w, this.h, 0xFF222233);
        im.rect(this.x, this.y, this.w, this.h, border);
        im.fillRect(this.x + 4, this.y + this.h / 2 - 1, this.w - 8, 3, 0xFF666688);
        int kx = this.x + 4;
        if (this.max > this.min) {
            kx = this.x + 4 + (this.value - this.min) * (this.w - 8) / (this.max - this.min);
        }
        im.fillRect(kx - 3, this.y + 2, 7, this.h - 4, 0xFFFFFFFF);
    }
}

// A drop-down select: closed it shows the chosen option; click to open
// the list, click an option (or press Return) to pick it, Escape closes.
class Dropdown extends Widget {
    string opt0; string opt1; string opt2; string opt3;
    string opt4; string opt5; string opt6; string opt7;
    int nopts;
    int selected;
    int highlight;
    int open;
    int focused;
    public Dropdown(int x, int y, int w, int h) {
        super(x, y, w, h);
        this.opt0 = null; this.opt1 = null; this.opt2 = null; this.opt3 = null;
        this.opt4 = null; this.opt5 = null; this.opt6 = null; this.opt7 = null;
        this.nopts = 0;
        this.selected = -1;
        this.highlight = 0;
        this.open = 0;
        this.focused = 0;
    }
    // 1 when the option was stored, 0 when the list (8) is full.
    public int addOption(string s) {
        if (this.nopts == 0) { this.opt0 = s; }
        else if (this.nopts == 1) { this.opt1 = s; }
        else if (this.nopts == 2) { this.opt2 = s; }
        else if (this.nopts == 3) { this.opt3 = s; }
        else if (this.nopts == 4) { this.opt4 = s; }
        else if (this.nopts == 5) { this.opt5 = s; }
        else if (this.nopts == 6) { this.opt6 = s; }
        else if (this.nopts == 7) { this.opt7 = s; }
        else { return 0; }
        if (this.selected == -1) {
            this.selected = 0;
        }
        this.nopts = this.nopts + 1;
        return 1;
    }
    public int nOptions() { return this.nopts; }
    public int selected() { return this.selected; }
    public int isOpen() { return this.open; }
    public string opt(int i) {
        if (i == 0) { return this.opt0; }
        if (i == 1) { return this.opt1; }
        if (i == 2) { return this.opt2; }
        if (i == 3) { return this.opt3; }
        if (i == 4) { return this.opt4; }
        if (i == 5) { return this.opt5; }
        if (i == 6) { return this.opt6; }
        return this.opt7;
    }
    public string selectedText() {
        if (this.selected < 0 || this.selected >= this.nopts) {
            return "";
        }
        return this.opt(this.selected);
    }
    // 1 when the option was picked, 0 for an out-of-range index.
    public int select(int i) {
        if (i < 0 || i >= this.nopts) {
            return 0;
        }
        this.selected = i;
        this.highlight = i;
        return 1;
    }
    public void openList() { this.open = 1; }
    public void closeList() { this.open = 0; }
    public void toggle() { this.open = 1 - this.open; }
    public void focus() { this.focused = 1; }
    // Option row under (px, py), or -1 (rows are h pixels tall).
    public int rowAt(int px, int py) {
        if (px < this.x || px >= this.x + this.w) {
            return -1;
        }
        int r = (py - (this.y + this.h)) / this.h;
        if (r < 0 || r >= this.nopts) {
            return -1;
        }
        return r;
    }
    public void onPress(int px, int py) {
        if (this.hit(px, py)) {
            this.toggle();
            return;
        }
        if (this.open == 1) {
            int r = this.rowAt(px, py);
            if (r >= 0) {
                this.select(r);
            }
            this.closeList();
        }
    }
    public int claimFocus(int px, int py) {
        if (this.hit(px, py)) {
            this.focused = 1;
            return 1;
        }
        if (this.open == 1 && this.rowAt(px, py) >= 0) {
            this.focused = 1;
            return 1;
        }
        return 0;
    }
    public void blur() { this.focused = 0; }
    public void onKey(int code, int mods) {
        if (this.focused != 1) {
            return;
        }
        if (this.open == 0) {
            if (code == 28 || code == 57) {
                this.openList();
            }
            return;
        }
        if (code == 108 && this.highlight < this.nopts - 1) {
            this.highlight = this.highlight + 1;
        } else if (code == 103 && this.highlight > 0) {
            this.highlight = this.highlight - 1;
        } else if (code == 28) {
            this.select(this.highlight);
            this.closeList();
        } else if (code == 1) {
            this.closeList();
        }
    }
    public void draw(Image im) {
        int border = 0xFF666688;
        if (this.focused == 1) {
            border = 0xFFFFFF00;
        }
        im.fillRect(this.x, this.y, this.w, this.h, 0xFF222233);
        im.rect(this.x, this.y, this.w, this.h, border);
        im.text(this.x + 4, this.y + (this.h - 7) / 2, this.selectedText(), 0xFFFFFFFF);
        string arrow = "v";
        if (this.open == 1) {
            arrow = "^";
        }
        im.text(this.x + this.w - 12, this.y + (this.h - 7) / 2, arrow, 0xFFFFFFFF);
        if (this.open == 1) {
            int i = 0;
            while (i < this.nopts) {
                int ry = this.y + this.h * (i + 1);
                int bg = 0xFF222233;
                if (i == this.highlight) {
                    bg = 0xFF444466;
                }
                im.fillRect(this.x, ry, this.w, this.h, bg);
                im.rect(this.x, ry, this.w, this.h, border);
                im.text(this.x + 4, ry + (this.h - 7) / 2, this.opt(i), 0xFFFFFFFF);
                i = i + 1;
            }
        }
    }
}

// Container that owns a window and a set of widgets. Fixed-capacity
// named fields (8 of each kind) keep field access refcount-safe.
class Gui {
    Window win;
    Label label0; Label label1; Label label2; Label label3;
    Label label4; Label label5; Label label6; Label label7;
    int nlabels;
    TextBox box0; TextBox box1; TextBox box2; TextBox box3;
    TextBox box4; TextBox box5; TextBox box6; TextBox box7;
    int nboxes;
    Button button0; Button button1; Button button2; Button button3;
    Button button4; Button button5; Button button6; Button button7;
    int nbuttons;
    Checkbox check0; Checkbox check1; Checkbox check2; Checkbox check3;
    Checkbox check4; Checkbox check5; Checkbox check6; Checkbox check7;
    int nchecks;
    RadioButton radio0; RadioButton radio1; RadioButton radio2; RadioButton radio3;
    RadioButton radio4; RadioButton radio5; RadioButton radio6; RadioButton radio7;
    int nradios;
    Slider slider0; Slider slider1; Slider slider2; Slider slider3;
    Slider slider4; Slider slider5; Slider slider6; Slider slider7;
    int nsliders;
    Dropdown drop0; Dropdown drop1; Dropdown drop2; Dropdown drop3;
    Dropdown drop4; Dropdown drop5; Dropdown drop6; Dropdown drop7;
    int ndrops;
    PasswordBox pass0; PasswordBox pass1; PasswordBox pass2; PasswordBox pass3;
    PasswordBox pass4; PasswordBox pass5; PasswordBox pass6; PasswordBox pass7;
    int npass;
    NumberBox num0; NumberBox num1; NumberBox num2; NumberBox num3;
    NumberBox num4; NumberBox num5; NumberBox num6; NumberBox num7;
    int nnum;
    TextArea area0; TextArea area1; TextArea area2; TextArea area3;
    TextArea area4; TextArea area5; TextArea area6; TextArea area7;
    int narea;
    // Keyboard focus, one live reference per kind at most (concrete
    // types only, so every call below dispatches to the right method).
    TextBox focusedBox;
    PasswordBox focusedPass;
    NumberBox focusedNum;
    TextArea focusedArea;
    Button focusedBtn;
    Checkbox focusedChk;
    RadioButton focusedRad;
    Slider focusedSld;
    Dropdown focusedDrp;
    int running;
    public Gui(Window win) {
        this.win = win;
        this.label0 = null; this.label1 = null; this.label2 = null; this.label3 = null;
        this.label4 = null; this.label5 = null; this.label6 = null; this.label7 = null;
        this.nlabels = 0;
        this.box0 = null; this.box1 = null; this.box2 = null; this.box3 = null;
        this.box4 = null; this.box5 = null; this.box6 = null; this.box7 = null;
        this.nboxes = 0;
        this.button0 = null; this.button1 = null; this.button2 = null; this.button3 = null;
        this.button4 = null; this.button5 = null; this.button6 = null; this.button7 = null;
        this.nbuttons = 0;
        this.check0 = null; this.check1 = null; this.check2 = null; this.check3 = null;
        this.check4 = null; this.check5 = null; this.check6 = null; this.check7 = null;
        this.nchecks = 0;
        this.radio0 = null; this.radio1 = null; this.radio2 = null; this.radio3 = null;
        this.radio4 = null; this.radio5 = null; this.radio6 = null; this.radio7 = null;
        this.nradios = 0;
        this.slider0 = null; this.slider1 = null; this.slider2 = null; this.slider3 = null;
        this.slider4 = null; this.slider5 = null; this.slider6 = null; this.slider7 = null;
        this.nsliders = 0;
        this.drop0 = null; this.drop1 = null; this.drop2 = null; this.drop3 = null;
        this.drop4 = null; this.drop5 = null; this.drop6 = null; this.drop7 = null;
        this.ndrops = 0;
        this.pass0 = null; this.pass1 = null; this.pass2 = null; this.pass3 = null;
        this.pass4 = null; this.pass5 = null; this.pass6 = null; this.pass7 = null;
        this.npass = 0;
        this.num0 = null; this.num1 = null; this.num2 = null; this.num3 = null;
        this.num4 = null; this.num5 = null; this.num6 = null; this.num7 = null;
        this.nnum = 0;
        this.area0 = null; this.area1 = null; this.area2 = null; this.area3 = null;
        this.area4 = null; this.area5 = null; this.area6 = null; this.area7 = null;
        this.narea = 0;
        this.focusedBox = null;
        this.focusedPass = null;
        this.focusedNum = null;
        this.focusedArea = null;
        this.focusedBtn = null;
        this.focusedChk = null;
        this.focusedRad = null;
        this.focusedSld = null;
        this.focusedDrp = null;
        this.running = 1;
    }
    public void addLabel(Label l) {
        if (this.nlabels == 0) { this.label0 = l; }
        else if (this.nlabels == 1) { this.label1 = l; }
        else if (this.nlabels == 2) { this.label2 = l; }
        else if (this.nlabels == 3) { this.label3 = l; }
        else if (this.nlabels == 4) { this.label4 = l; }
        else if (this.nlabels == 5) { this.label5 = l; }
        else if (this.nlabels == 6) { this.label6 = l; }
        else if (this.nlabels == 7) { this.label7 = l; }
        else { return; }
        this.nlabels = this.nlabels + 1;
    }
    public void addBox(TextBox t) {
        if (this.nboxes == 0) { this.box0 = t; }
