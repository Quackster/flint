    public void dispatchKey(int code, int mods) {
        if (this.focusedBox != null) { this.focusedBox.onKey(code, mods); }
        else if (this.focusedPass != null) { this.focusedPass.onKey(code, mods); }
        else if (this.focusedNum != null) { this.focusedNum.onKey(code, mods); }
        else if (this.focusedArea != null) { this.focusedArea.onKey(code, mods); }
        else if (this.focusedBtn != null) { this.focusedBtn.onKey(code, mods); }
        else if (this.focusedChk != null) { this.focusedChk.onKey(code, mods); }
        else if (this.focusedRad != null) { this.focusedRad.onKey(code, mods); }
        else if (this.focusedSld != null) { this.focusedSld.onKey(code, mods); }
        else if (this.focusedDrp != null) { this.focusedDrp.onKey(code, mods); }
    }
    // Motion goes to grabbed sliders so dragging works.
    public void dispatchMotion(int x, int y) {
        if (this.slider0 != null) { Slider s = this.slider0; s.onDrag(x); }
        if (this.slider1 != null) { Slider s = this.slider1; s.onDrag(x); }
        if (this.slider2 != null) { Slider s = this.slider2; s.onDrag(x); }
        if (this.slider3 != null) { Slider s = this.slider3; s.onDrag(x); }
        if (this.slider4 != null) { Slider s = this.slider4; s.onDrag(x); }
        if (this.slider5 != null) { Slider s = this.slider5; s.onDrag(x); }
        if (this.slider6 != null) { Slider s = this.slider6; s.onDrag(x); }
        if (this.slider7 != null) { Slider s = this.slider7; s.onDrag(x); }
    }
    // Release ends button presses (firing click on release-inside)
    // and slider grabs.
    public void dispatchRelease(int x, int y) {
        if (this.button0 != null) { Button b = this.button0; b.onRelease(x, y); }
        if (this.button1 != null) { Button b = this.button1; b.onRelease(x, y); }
        if (this.button2 != null) { Button b = this.button2; b.onRelease(x, y); }
        if (this.button3 != null) { Button b = this.button3; b.onRelease(x, y); }
        if (this.button4 != null) { Button b = this.button4; b.onRelease(x, y); }
        if (this.button5 != null) { Button b = this.button5; b.onRelease(x, y); }
        if (this.button6 != null) { Button b = this.button6; b.onRelease(x, y); }
        if (this.button7 != null) { Button b = this.button7; b.onRelease(x, y); }
        if (this.slider0 != null) { Slider s = this.slider0; s.onRelease(); }
        if (this.slider1 != null) { Slider s = this.slider1; s.onRelease(); }
        if (this.slider2 != null) { Slider s = this.slider2; s.onRelease(); }
        if (this.slider3 != null) { Slider s = this.slider3; s.onRelease(); }
        if (this.slider4 != null) { Slider s = this.slider4; s.onRelease(); }
        if (this.slider5 != null) { Slider s = this.slider5; s.onRelease(); }
        if (this.slider6 != null) { Slider s = this.slider6; s.onRelease(); }
        if (this.slider7 != null) { Slider s = this.slider7; s.onRelease(); }
    }
