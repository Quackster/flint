    // Deselect every selected radio in group g except slot keep.
    public void clearGroup(int g, int keep) {
        if (this.radio0 != null && 0 != keep && this.radio0.group() == g) {
            this.radio0.setSelected(0);
        }
        if (this.radio1 != null && 1 != keep && this.radio1.group() == g) {
            this.radio1.setSelected(0);
        }
        if (this.radio2 != null && 2 != keep && this.radio2.group() == g) {
            this.radio2.setSelected(0);
        }
        if (this.radio3 != null && 3 != keep && this.radio3.group() == g) {
            this.radio3.setSelected(0);
        }
        if (this.radio4 != null && 4 != keep && this.radio4.group() == g) {
            this.radio4.setSelected(0);
        }
        if (this.radio5 != null && 5 != keep && this.radio5.group() == g) {
            this.radio5.setSelected(0);
        }
        if (this.radio6 != null && 6 != keep && this.radio6.group() == g) {
            this.radio6.setSelected(0);
        }
        if (this.radio7 != null && 7 != keep && this.radio7.group() == g) {
            this.radio7.setSelected(0);
        }
    }
    // Press dispatch, topmost layer first (drops, sliders, radios,
    // checks, buttons, boxes). The first widget claiming focus wins it.
    // Blur every focused widget (focus is single: one live reference
    // per kind at most, all cleared here before a new claim).
    public void blurAll() {
        if (this.focusedBox != null) { this.focusedBox.blur(); this.focusedBox = null; }
        if (this.focusedPass != null) { this.focusedPass.blur(); this.focusedPass = null; }
        if (this.focusedNum != null) { this.focusedNum.blur(); this.focusedNum = null; }
        if (this.focusedArea != null) { this.focusedArea.blur(); this.focusedArea = null; }
        if (this.focusedBtn != null) { this.focusedBtn.blur(); this.focusedBtn = null; }
        if (this.focusedChk != null) { this.focusedChk.blur(); this.focusedChk = null; }
        if (this.focusedRad != null) { this.focusedRad.blur(); this.focusedRad = null; }
        if (this.focusedSld != null) { this.focusedSld.blur(); this.focusedSld = null; }
        if (this.focusedDrp != null) { this.focusedDrp.blur(); this.focusedDrp = null; }
    }
    // Each press helper returns 1 when the widget claimed the press
    // (topmost claimant consumes it, so lower layers never see it).
    public int pressBox(TextBox t, int x, int y) {
        if (t.hit(x, y) == 0) {
            return 0;
        }
        t.onPress(x, y);
        this.blurAll();
        t.claimFocus(x, y);
        this.focusedBox = t;
        return 1;
    }
    public int pressPass(PasswordBox t, int x, int y) {
        if (t.hit(x, y) == 0) {
            return 0;
        }
        t.onPress(x, y);
        this.blurAll();
        t.claimFocus(x, y);
        this.focusedPass = t;
        return 1;
    }
    public int pressNum(NumberBox t, int x, int y) {
        if (t.hit(x, y) == 0) {
            return 0;
        }
        t.onPress(x, y);
        this.blurAll();
        t.claimFocus(x, y);
        this.focusedNum = t;
        return 1;
    }
    public int pressArea(TextArea t, int x, int y) {
        if (t.hit(x, y) == 0) {
            return 0;
        }
        t.onPress(x, y);
        this.blurAll();
        t.claimFocus(x, y);
        this.focusedArea = t;
        return 1;
    }
    public int pressButton(Button b, int x, int y) {
        if (b.hit(x, y) == 0) {
            return 0;
        }
        b.onPress(x, y);
        this.blurAll();
        b.claimFocus(x, y);
        this.focusedBtn = b;
        return 1;
    }
    public int pressCheck(Checkbox c, int x, int y) {
        if (c.hit(x, y) == 0) {
            return 0;
        }
        c.onPress(x, y);
        this.blurAll();
        c.claimFocus(x, y);
        this.focusedChk = c;
        return 1;
    }
    public int pressSlider(Slider s, int x, int y) {
        if (s.hit(x, y) == 0) {
            return 0;
        }
        s.onPress(x, y);
        this.blurAll();
        s.claimFocus(x, y);
        this.focusedSld = s;
        return 1;
    }
    public int pressDrop(Dropdown d, int x, int y) {
        if (d.claimFocus(x, y) == 0) {
            d.onPress(x, y);
            return 0;
        }
        d.onPress(x, y);
        this.blurAll();
        // Focus stays on the dropdown even though picking an option
        // closed the list (re-testing geometry here would fail).
        d.focus();
        this.focusedDrp = d;
        return 1;
    }
    public int pressRadio(RadioButton r, int x, int y, int slot) {
        if (r.hit(x, y) == 0) {
            return 0;
        }
        r.onPress(x, y);
        this.blurAll();
        r.claimFocus(x, y);
        this.focusedRad = r;
        if (r.selected() == 1) {
            this.clearGroup(r.group(), slot);
        }
        return 1;
    }
    public void dispatchPress(int x, int y) {
        if (this.drop0 != null && this.pressDrop(this.drop0, x, y) == 1) { return; }
        if (this.drop1 != null && this.pressDrop(this.drop1, x, y) == 1) { return; }
        if (this.drop2 != null && this.pressDrop(this.drop2, x, y) == 1) { return; }
        if (this.drop3 != null && this.pressDrop(this.drop3, x, y) == 1) { return; }
        if (this.drop4 != null && this.pressDrop(this.drop4, x, y) == 1) { return; }
        if (this.drop5 != null && this.pressDrop(this.drop5, x, y) == 1) { return; }
        if (this.drop6 != null && this.pressDrop(this.drop6, x, y) == 1) { return; }
        if (this.drop7 != null && this.pressDrop(this.drop7, x, y) == 1) { return; }
        if (this.slider0 != null && this.pressSlider(this.slider0, x, y) == 1) { return; }
        if (this.slider1 != null && this.pressSlider(this.slider1, x, y) == 1) { return; }
        if (this.slider2 != null && this.pressSlider(this.slider2, x, y) == 1) { return; }
        if (this.slider3 != null && this.pressSlider(this.slider3, x, y) == 1) { return; }
        if (this.slider4 != null && this.pressSlider(this.slider4, x, y) == 1) { return; }
        if (this.slider5 != null && this.pressSlider(this.slider5, x, y) == 1) { return; }
        if (this.slider6 != null && this.pressSlider(this.slider6, x, y) == 1) { return; }
        if (this.slider7 != null && this.pressSlider(this.slider7, x, y) == 1) { return; }
        if (this.radio0 != null && this.pressRadio(this.radio0, x, y, 0) == 1) { return; }
        if (this.radio1 != null && this.pressRadio(this.radio1, x, y, 1) == 1) { return; }
        if (this.radio2 != null && this.pressRadio(this.radio2, x, y, 2) == 1) { return; }
        if (this.radio3 != null && this.pressRadio(this.radio3, x, y, 3) == 1) { return; }
        if (this.radio4 != null && this.pressRadio(this.radio4, x, y, 4) == 1) { return; }
        if (this.radio5 != null && this.pressRadio(this.radio5, x, y, 5) == 1) { return; }
        if (this.radio6 != null && this.pressRadio(this.radio6, x, y, 6) == 1) { return; }
        if (this.radio7 != null && this.pressRadio(this.radio7, x, y, 7) == 1) { return; }
        if (this.check0 != null && this.pressCheck(this.check0, x, y) == 1) { return; }
        if (this.check1 != null && this.pressCheck(this.check1, x, y) == 1) { return; }
        if (this.check2 != null && this.pressCheck(this.check2, x, y) == 1) { return; }
        if (this.check3 != null && this.pressCheck(this.check3, x, y) == 1) { return; }
        if (this.check4 != null && this.pressCheck(this.check4, x, y) == 1) { return; }
        if (this.check5 != null && this.pressCheck(this.check5, x, y) == 1) { return; }
        if (this.check6 != null && this.pressCheck(this.check6, x, y) == 1) { return; }
        if (this.check7 != null && this.pressCheck(this.check7, x, y) == 1) { return; }
        if (this.button0 != null && this.pressButton(this.button0, x, y) == 1) { return; }
        if (this.button1 != null && this.pressButton(this.button1, x, y) == 1) { return; }
        if (this.button2 != null && this.pressButton(this.button2, x, y) == 1) { return; }
        if (this.button3 != null && this.pressButton(this.button3, x, y) == 1) { return; }
        if (this.button4 != null && this.pressButton(this.button4, x, y) == 1) { return; }
        if (this.button5 != null && this.pressButton(this.button5, x, y) == 1) { return; }
        if (this.button6 != null && this.pressButton(this.button6, x, y) == 1) { return; }
        if (this.button7 != null && this.pressButton(this.button7, x, y) == 1) { return; }
        if (this.box0 != null && this.pressBox(this.box0, x, y) == 1) { return; }
        if (this.box1 != null && this.pressBox(this.box1, x, y) == 1) { return; }
        if (this.box2 != null && this.pressBox(this.box2, x, y) == 1) { return; }
        if (this.box3 != null && this.pressBox(this.box3, x, y) == 1) { return; }
        if (this.box4 != null && this.pressBox(this.box4, x, y) == 1) { return; }
