        if (this.box6 != null && this.pressBox(this.box6, x, y) == 1) { return; }
        if (this.box7 != null && this.pressBox(this.box7, x, y) == 1) { return; }
        if (this.pass0 != null && this.pressPass(this.pass0, x, y) == 1) { return; }
        if (this.pass1 != null && this.pressPass(this.pass1, x, y) == 1) { return; }
        if (this.pass2 != null && this.pressPass(this.pass2, x, y) == 1) { return; }
        if (this.pass3 != null && this.pressPass(this.pass3, x, y) == 1) { return; }
        if (this.pass4 != null && this.pressPass(this.pass4, x, y) == 1) { return; }
        if (this.pass5 != null && this.pressPass(this.pass5, x, y) == 1) { return; }
        if (this.pass6 != null && this.pressPass(this.pass6, x, y) == 1) { return; }
        if (this.pass7 != null && this.pressPass(this.pass7, x, y) == 1) { return; }
        if (this.num0 != null && this.pressNum(this.num0, x, y) == 1) { return; }
        if (this.num1 != null && this.pressNum(this.num1, x, y) == 1) { return; }
        if (this.num2 != null && this.pressNum(this.num2, x, y) == 1) { return; }
        if (this.num3 != null && this.pressNum(this.num3, x, y) == 1) { return; }
        if (this.num4 != null && this.pressNum(this.num4, x, y) == 1) { return; }
        if (this.num5 != null && this.pressNum(this.num5, x, y) == 1) { return; }
