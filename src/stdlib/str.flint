// std/str — string utilities (import std.Str).
//
// Usage:
//   import std.Str;
//   print(Str.upper("hi"));   // HI
//   print(Str.join([ "a", "b" ], "-"));  // a-b
package std;
class Str {
    // Uppercase the ASCII letters of s.
    static string upper(string s) {
        int n = strlen(s);
        string out = alloc(n + 1);
        int i = 0;
        while (i < n) {
            int c = sys.byteLoad(s + i);
            if (c >= 97 && c <= 122) {
                c = c - 32;
            }
            sys.byteStore(out + i, c);
            i = i + 1;
        }
        sys.byteStore(out + n, 0);
        return out;
    }
    // Lowercase the ASCII letters of s.
    static string lower(string s) {
        int n = strlen(s);
        string out = alloc(n + 1);
        int i = 0;
        while (i < n) {
            int c = sys.byteLoad(s + i);
            if (c >= 65 && c <= 90) {
                c = c + 32;
            }
            sys.byteStore(out + i, c);
            i = i + 1;
        }
        sys.byteStore(out + n, 0);
        return out;
    }
    // Reverse s.
    static string reverse(string s) {
        int n = strlen(s);
        string out = alloc(n + 1);
        int i = 0;
        while (i < n) {
            sys.byteStore(out + (n - 1 - i), sys.byteLoad(s + i));
            i = i + 1;
        }
        sys.byteStore(out + n, 0);
        return out;
    }
    // Strip leading and trailing spaces.
    static string trim(string s) {
        int n = strlen(s);
        int i = 0;
        while (i < n && sys.byteLoad(s + i) == 32) {
            i = i + 1;
        }
        int j = n;
        while (j > i && sys.byteLoad(s + j - 1) == 32) {
            j = j - 1;
        }
        return str.substring(s, i, j - i);
    }
    // Strip leading spaces.
    static string ltrim(string s) {
        int n = strlen(s);
        int i = 0;
        while (i < n && sys.byteLoad(s + i) == 32) {
            i = i + 1;
        }
        return str.substring(s, i, n - i);
    }
    // Strip trailing spaces.
    static string rtrim(string s) {
        int n = strlen(s);
        int j = n;
        while (j > 0 && sys.byteLoad(s + j - 1) == 32) {
            j = j - 1;
        }
        return str.substring(s, 0, j);
    }
    // Number of (non-overlapping) occurrences of sub in s.
    static int count(string s, string sub) {
        int nsub = strlen(sub);
        if (nsub == 0) {
            return 0;
        }
        int c = 0;
        int i = 0;
        int n = strlen(s);
        while (i + nsub <= n) {
            int k = 0;
            int match = 1;
            while (k < nsub) {
                if (sys.byteLoad(s + i + k) != sys.byteLoad(sub + k)) {
                    match = 0;
                }
                k = k + 1;
            }
            if (match == 1) {
                c = c + 1;
                i = i + nsub;
            } else {
                i = i + 1;
            }
        }
        return c;
    }
    // 1 if sub occurs in s, 0 otherwise.
    static int contains(string s, string sub) {
        return str.indexOf(s, sub) >= 0 ? 1 : 0;
    }
    // Index of the last occurrence of sub in s, or -1.
    static int lastIndexOf(string s, string sub) {
        int nsub = strlen(sub);
        int n = strlen(s);
        if (nsub == 0 || nsub > n) {
            return -1;
        }
        int i = n - nsub;
        while (i >= 0) {
            int k = 0;
            int match = 1;
            while (k < nsub) {
                if (sys.byteLoad(s + i + k) != sys.byteLoad(sub + k)) {
                    match = 0;
                }
                k = k + 1;
            }
            if (match == 1) {
                return i;
            }
            i = i - 1;
        }
        return -1;
    }
    // 1 when s starts with prefix p.
    static int startsWith(string s, string p) {
        int np = strlen(p);
        int ns = strlen(s);
        if (np > ns) {
            return 0;
        }
        return str.cmp(str.substring(s, 0, np), p) == 0 ? 1 : 0;
    }
    // 1 when s ends with suffix p.
    static int endsWith(string s, string p) {
        int np = strlen(p);
        int ns = strlen(s);
        if (np > ns) {
            return 0;
        }
        return str.cmp(str.substring(s, ns - np, np), p) == 0 ? 1 : 0;
    }
    // Replace every (non-overlapping) occurrence of from with to.
    // The output buffer assumes a modest size ratio of to to from.
    static string replaceAll(string s, string from, string to) {
        int nfrom = strlen(from);
        if (nfrom == 0) {
            return str.copy(s);
        }
        string out = alloc(strlen(s) + strlen(to) + 16);
        int o = 0;
        int i = 0;
        int n = strlen(s);
        while (i < n) {
            int k = 0;
            int match = 0;
            if (i + nfrom <= n) {
                match = 1;
                while (k < nfrom) {
                    if (sys.byteLoad(s + i + k) != sys.byteLoad(from + k)) {
                        match = 0;
                    }
                    k = k + 1;
                }
            }
            if (match == 1) {
                int j = 0;
                int nto = strlen(to);
                while (j < nto) {
                    sys.byteStore(out + o, sys.byteLoad(to + j));
                    o = o + 1;
                    j = j + 1;
                }
                i = i + nfrom;
            } else {
                sys.byteStore(out + o, sys.byteLoad(s + i));
                o = o + 1;
                i = i + 1;
            }
        }
        sys.byteStore(out + o, 0);
        return out;
    }
    // s repeated n times.
    static string repeat(string s, int n) {
        int ns = strlen(s);
        string out = alloc(ns * n + 1);
        int i = 0;
        int o = 0;
        while (i < n) {
            int j = 0;
            while (j < ns) {
                sys.byteStore(out + o, sys.byteLoad(s + j));
                o = o + 1;
                j = j + 1;
            }
            i = i + 1;
        }
        sys.byteStore(out + o, 0);
        return out;
    }
    // Split s on sep into a list of segments.
    static List split(string s, string sep) {
        List out = new List();
        out.kind = 1;
        int nsep = strlen(sep);
        int n = strlen(s);
        if (nsep == 0) {
            return out;
        }
        int start = 0;
        int i = 0;
        while (i + nsep <= n) {
            int k = 0;
            int match = 1;
            while (k < nsep) {
                if (sys.byteLoad(s + i + k) != sys.byteLoad(sep + k)) {
                    match = 0;
                }
                k = k + 1;
            }
            if (match == 1) {
                out.add(str.substring(s, start, i - start));
                i = i + nsep;
                start = i;
            } else {
                i = i + 1;
            }
        }
        out.add(str.substring(s, start, n - start));
        return out;
    }
    // Join the elements of a string list with sep.
    static string join(List l, string sep) { return l.join(sep); }
    // Pad s on the right with ch up to width w.
    static string ljust(string s, int w, int ch) {
        int ns = strlen(s);
        string out = alloc(w + 1);
        int i = 0;
        while (i < ns) {
            sys.byteStore(out + i, sys.byteLoad(s + i));
            i = i + 1;
        }
        while (i < w) {
            sys.byteStore(out + i, ch);
            i = i + 1;
        }
        sys.byteStore(out + w, 0);
        return out;
    }
    // Pad s on the left with ch up to width w.
    static string rjust(string s, int w, int ch) {
        int ns = strlen(s);
        string out = alloc(w + 1);
        int i = 0;
        while (i < w - ns) {
            sys.byteStore(out + i, ch);
            i = i + 1;
        }
        int j = 0;
        while (j < ns) {
            sys.byteStore(out + i, sys.byteLoad(s + j));
            i = i + 1;
            j = j + 1;
        }
        sys.byteStore(out + w, 0);
        return out;
    }
}
