// std/str — string utilities (import std.Str).
//
// Usage:
//   import std.Str;
//   print(Str.upper("hi"));   // HI
//   print(Str.join([ "a", "b" ], "-"));  // a-b
package std;
class Str {
    // Uppercase the ASCII letters of s.
    static string upper(string s) {
        int n = strlen(s);
        string out = string[n + 1];
        int i = 0;
        while (i < n) {
            int c = s[i];
            if (c >= 97 && c <= 122) {
                c = c - 32;
            }
            out[i] = c;
            i = i + 1;
        }
        out[n] = 0;
        return out;
    }
    // Lowercase the ASCII letters of s.
    static string lower(string s) {
        int n = strlen(s);
        string out = string[n + 1];
        int i = 0;
        while (i < n) {
            int c = s[i];
            if (c >= 65 && c <= 90) {
                c = c + 32;
            }
            out[i] = c;
            i = i + 1;
        }
        out[n] = 0;
        return out;
    }
    // Reverse s.
    static string reverse(string s) {
        int n = strlen(s);
        string out = string[n + 1];
        int i = 0;
        while (i < n) {
            out[(n - 1 - i)] = s[i];
            i = i + 1;
        }
        out[n] = 0;
        return out;
    }
    // Strip leading and trailing spaces.
    static string trim(string s) {
        int n = strlen(s);
        int i = 0;
        while (i < n && s[i] == 32) {
            i = i + 1;
        }
        int j = n;
        while (j > i && s[j - 1] == 32) {
            j = j - 1;
        }
        return str.substring(s, i, j - i);
    }
    // Strip leading spaces.
    static string ltrim(string s) {
        int n = strlen(s);
        int i = 0;
        while (i < n && s[i] == 32) {
            i = i + 1;
        }
        return str.substring(s, i, n - i);
    }
    // Strip trailing spaces.
    static string rtrim(string s) {
        int n = strlen(s);
        int j = n;
        while (j > 0 && s[j - 1] == 32) {
            j = j - 1;
        }
        return str.substring(s, 0, j);
    }
    // Number of (non-overlapping) occurrences of sub in s.
    static int count(string s, string sub) {
        int nsub = strlen(sub);
        if (nsub == 0) {
            return 0;
        }
        int c = 0;
        int i = 0;
        int n = strlen(s);
        while (i + nsub <= n) {
            int k = 0;
            int match = 1;
            while (k < nsub) {
                if (s[i + k] != sub[k]) {
                    match = 0;
                }
                k = k + 1;
            }
            if (match == 1) {
                c = c + 1;
                i = i + nsub;
            } else {
                i = i + 1;
            }
        }
        return c;
    }
    // 1 if sub occurs in s, 0 otherwise.
    static int contains(string s, string sub) {
        return str.indexOf(s, sub) >= 0 ? 1 : 0;
    }
    // Index of the last occurrence of sub in s, or -1.
    static int lastIndexOf(string s, string sub) {
        int nsub = strlen(sub);
        int n = strlen(s);
        if (nsub == 0 || nsub > n) {
            return -1;
        }
        int i = n - nsub;
        while (i >= 0) {
            int k = 0;
            int match = 1;
            while (k < nsub) {
                if (s[i + k] != sub[k]) {
                    match = 0;
                }
                k = k + 1;
            }
            if (match == 1) {
                return i;
            }
            i = i - 1;
        }
        return -1;
    }
    // 1 when s starts with prefix p.
    static int startsWith(string s, string p) {
        int np = strlen(p);
        int ns = strlen(s);
        if (np > ns) {
            return 0;
        }
        return str.cmp(str.substring(s, 0, np), p) == 0 ? 1 : 0;
    }
    // 1 when s ends with suffix p.
    static int endsWith(string s, string p) {
        int np = strlen(p);
        int ns = strlen(s);
        if (np > ns) {
            return 0;
        }
        return str.cmp(str.substring(s, ns - np, np), p) == 0 ? 1 : 0;
    }
    // Replace every (non-overlapping) occurrence of from with to.
    // The output buffer assumes a modest size ratio of to to from.
    static string replaceAll(string s, string from, string to) {
        int nfrom = strlen(from);
        if (nfrom == 0) {
            return str.copy(s);
        }
        string out = string[strlen(s) + strlen(to) + 16];
        int o = 0;
        int i = 0;
        int n = strlen(s);
        while (i < n) {
            int k = 0;
            int match = 0;
            if (i + nfrom <= n) {
                match = 1;
                while (k < nfrom) {
                    if (s[i + k] != from[k]) {
                        match = 0;
                    }
                    k = k + 1;
                }
            }
            if (match == 1) {
                int j = 0;
                int nto = strlen(to);
                while (j < nto) {
                    out[o] = to[j];
                    o = o + 1;
                    j = j + 1;
                }
                i = i + nfrom;
            } else {
                out[o] = s[i];
                o = o + 1;
                i = i + 1;
            }
        }
        out[o] = 0;
        return out;
    }
    // s repeated n times.
    static string repeat(string s, int n) {
        int ns = strlen(s);
        string out = string[ns * n + 1];
        int i = 0;
        int o = 0;
        while (i < n) {
            int j = 0;
            while (j < ns) {
                out[o] = s[j];
                o = o + 1;
                j = j + 1;
            }
            i = i + 1;
        }
        out[o] = 0;
        return out;
    }
    // Split s on sep into a list of segments.
    static List<string> split(string s, string sep) {
        List<string> out = new List<string>();
        int nsep = strlen(sep);
        int n = strlen(s);
        if (nsep == 0) {
            return out;
        }
        int start = 0;
        int i = 0;
        while (i + nsep <= n) {
            int k = 0;
            int match = 1;
            while (k < nsep) {
                if (s[i + k] != sep[k]) {
                    match = 0;
                }
                k = k + 1;
            }
            if (match == 1) {
                out.add(str.substring(s, start, i - start));
                i = i + nsep;
                start = i;
            } else {
                i = i + 1;
            }
        }
        out.add(str.substring(s, start, n - start));
        return out;
    }
    // Join the elements of a string list with sep.
    static string join(List<string> l, string sep) { return l.join(sep); }
    // Pad s on the right with ch up to width w.
    static string ljust(string s, int w, int ch) {
        int ns = strlen(s);
        string out = string[w + 1];
        int i = 0;
        while (i < ns) {
            out[i] = s[i];
            i = i + 1;
        }
        while (i < w) {
            out[i] = ch;
            i = i + 1;
        }
        out[w] = 0;
        return out;
    }
    // Pad s on the left with ch up to width w.
    static string rjust(string s, int w, int ch) {
        int ns = strlen(s);
        string out = string[w + 1];
        int i = 0;
        while (i < w - ns) {
            out[i] = ch;
            i = i + 1;
        }
        int j = 0;
        while (j < ns) {
            out[i] = s[j];
            i = i + 1;
            j = j + 1;
        }
        out[w] = 0;
        return out;
    }
}
