// std/window — an on-screen canvas with two backends: the Linux framebuffer
// (no X server required) and an X11 window over a unix socket.
//
// Draw onto the internal RGBA canvas (the same pixel model as std.Image),
// then call `refresh()` to push it to the screen.
//
// Usage:
//   import std.Window;
//   import std.Image;
//   Window w = new Window(320, 200, 0);   // backend 0 = framebuffer, 1 = X11
//   if (w.ok()) {
//       w.clear();
//       w.blit(0, 0, myImage);           // draw an Image
//       w.text(10, 10, "hello", 0xFFFFFF);
//       w.refresh();                     // push to the screen
//       w.wait(5);                       // keep the window up for 5 seconds
//       w.close();
//   }
//
// On failure (no /dev/fbN, no X server, ...), `ok()` is 0 and `err()` is
// negative (the failing step). Drawing methods are no-ops until a backend
// has opened, so a program can always construct and check.
package std;
class Window {
    // ----------------------------------------------------------- constants
    // Backend ids: 0 = Linux framebuffer (/dev/fbN), 1 = X11 unix socket.
    // Syscall/protocol constants used below (inlined, as Flint fields have no
    // initializers):
    //   O_RDWR = 2, AF_UNIX = 1, SOCK_STREAM = 1, SYS_IOCTL = 16
    //   FBIOGET_VSCREENINFO = 0x4600, FBIOGET_FSCREENINFO = 0x4602
    //   X11 major opcodes: CreateWindow = 1, CreateGC = 56, MapWindow = 26,
    //                     PutImage = 72
    // ------------------------------------------------------------- fields
    int backend;
    int alive;      // 1 = a backend opened successfully
    int code;       // 0 = ok, negative = which step failed
    int cw;         // canvas width
    int ch;         // canvas height
    string canvas;  // cw*ch*4 bytes, RGBA, row-major
    // framebuffer state
    int fb_fd;
    string fb;       // mmap()ed framebuffer
    int fb_pitch;   // bytes per row (line_length)
    int fb_bpp;     // bits per pixel
    int fb_w;       // screen width
    int fb_h;       // screen height
    int ro_off; int ro_len;
    int go_off; int go_len;
    int bo_off; int bo_len;
    // x11 state
    int x_fd;
    int x_win;
    int x_gc;
    int x_root;
    int x_depth;
    int x_lsb;      // 1 = server image byte order is LSBFirst
    int x_idbase;   // resource-id-base from the connection setup
    static string font;   // 95*7 bytes, the 5x7 font (lazy init)

    // -------------------------------------------------------- constructor
    public Window(int w, int h, int backend) {
        this.backend = backend;
        this.alive = 0;
        this.code = 0;
        this.cw = w;
        this.ch = h;
        this.canvas = alloc(w * h * 4);
        this.fb_fd = -1;
        this.fb = null;
        this.fb_pitch = 0;
        this.fb_bpp = 32;
        this.x_fd = -1;
        this.x_win = 0;
        this.x_gc = 0;
        this.x_root = 0;
        this.x_depth = 24;
        this.x_lsb = 1;
        this.x_idbase = 0;
        if (backend == 0) {
            this.code = this.fb_open();
        } else {
            this.code = this.x11_open();
        }
        if (this.code == 0) {
            this.alive = 1;
        }
    }
    public int ok() { return this.alive; }
    public int err() { return this.code; }
    public int width() { return this.cw; }
    public int height() { return this.ch; }

    // ------------------------------------------------- big-endian helpers
    // The X11 protocol and the xauth file use network byte order, but
    // sys.short/int load/store are little-endian, so read/write these
    // multi-byte values byte by byte.
    static int be16(int p) {
        return (sys.byte_load(p) << 8) + sys.byte_load(p + 1);
    }
    static int be32(int p) {
        return (sys.byte_load(p) << 24) + (sys.byte_load(p + 1) << 16)
             + (sys.byte_load(p + 2) << 8) + sys.byte_load(p + 3);
    }
    static void be16w(int p, int v) {
        sys.byte_store(p, (v >> 8) & 255);
        sys.byte_store(p + 1, v & 255);
    }
    static void be32w(int p, int v) {
        sys.byte_store(p, (v >> 24) & 255);
        sys.byte_store(p + 1, (v >> 16) & 255);
        sys.byte_store(p + 2, (v >> 8) & 255);
        sys.byte_store(p + 3, v & 255);
    }

    // --------------------------------------------------- canvas primitives
    // Store a packed 0xAARRGGBB pixel (no-op out of range).
    public void set(int x, int y, int c) {
        if (x < 0 || y < 0 || x >= this.cw || y >= this.ch) {
            return;
        }
        int o = (y * this.cw + x) * 4;
        sys.byte_store(this.canvas + o, c & 255);
        sys.byte_store(this.canvas + o + 1, (c >> 8) & 255);
        sys.byte_store(this.canvas + o + 2, (c >> 16) & 255);
        sys.byte_store(this.canvas + o + 3, (c >> 24) & 255);
    }
    // Packed 0xAARRGGBB at (x, y); 0 out of range.
    public int get(int x, int y) {
        if (x < 0 || y < 0 || x >= this.cw || y >= this.ch) {
            return 0;
        }
        int o = (y * this.cw + x) * 4;
        int b = sys.byte_load(this.canvas + o);
        int g = sys.byte_load(this.canvas + o + 1);
        int r = sys.byte_load(this.canvas + o + 2);
        int a = sys.byte_load(this.canvas + o + 3);
        return (a << 24) | (r << 16) | (g << 8) | b;
    }
    // Fill the whole canvas with a packed color.
    public void fill(int c) {
        int r = Image.cr(c);
        int g = Image.cg(c);
        int b = Image.cb(c);
        int a = Image.ca(c);
        int i = 0;
        int n = this.cw * this.ch;
        while (i < n) {
            int o = i * 4;
            sys.byte_store(this.canvas + o, b);
            sys.byte_store(this.canvas + o + 1, g);
            sys.byte_store(this.canvas + o + 2, r);
            sys.byte_store(this.canvas + o + 3, a);
            i = i + 1;
        }
    }
    // Fill with black (opaque).
    public void clear() { this.fill(0); }
    public void pixel(int x, int y, int c) { this.set(x, y, c); }
    // Rectangle outline of size (w, h) from the top-left (x, y).
    public void rect(int x, int y, int w, int h, int c) {
        this.hline(x, y, x + w - 1, c);
        this.hline(x, y + h - 1, x + w - 1, c);
        this.vline(x, y, y + h - 1, c);
        this.vline(x + w - 1, y, y + h - 1, c);
    }
    public void fill_rect(int x, int y, int w, int h, int c) {
        int dy = 0;
        while (dy < h) {
            int dx = 0;
            while (dx < w) {
                this.set(x + dx, y + dy, c);
                dx = dx + 1;
            }
            dy = dy + 1;
        }
    }
    public void hline(int x0, int y, int x1, int c) {
        if (x0 > x1) {
            int t = x0;
            x0 = x1;
            x1 = t;
        }
        int x = x0;
        while (x <= x1) {
            this.set(x, y, c);
            x = x + 1;
        }
    }
    public void vline(int x, int y0, int y1, int c) {
        if (y0 > y1) {
            int t = y0;
            y0 = y1;
            y1 = t;
        }
        int y = y0;
        while (y <= y1) {
            this.set(x, y, c);
            y = y + 1;
        }
    }
    // Bresenham line.
    public void line(int x0, int y0, int x1, int y1, int c) {
        int dx = x1 - x0;
        int dy = y1 - y0;
        int adx = Math.abs(dx);
        int ady = Math.abs(dy);
        int sx = dx > 0 ? 1 : -1;
        int sy = dy > 0 ? 1 : -1;
        int err = adx - ady;
        int x = x0;
        int y = y0;
        while (1) {
            this.set(x, y, c);
            if (x == x1 && y == y1) {
                break;
            }
            int e2 = err * 2;
            if (e2 >= -ady) {
                err = err - ady;
                x = x + sx;
            }
            if (e2 <= adx) {
                err = err + adx;
                y = y + sy;
            }
        }
    }
    // Circle outline (midpoint algorithm).
    public void circle(int cx, int cy, int r, int c) {
        int x = r;
        int y = 0;
        int err = 0;
        while (x >= y) {
            this.set(cx + x, cy + y, c);
            this.set(cx + y, cy + x, c);
            this.set(cx - y, cy + x, c);
            this.set(cx - x, cy + y, c);
            this.set(cx - x, cy - y, c);
            this.set(cx - y, cy - x, c);
            this.set(cx + y, cy - x, c);
            this.set(cx + x, cy - y, c);
            if (err <= 0) {
                x = x - 1;
                err = err + 2 * x + 1;
            }
            if (err > 0) {
                y = y + 1;
                err = err - 2 * y + 1;
            }
        }
    }
    public void fill_circle(int cx, int cy, int r, int c) {
        int y = -r;
        while (y <= r) {
            int xr = Math.sqrt(r * r - y * y);
            this.hline(cx - xr, cy + y, cx + xr, c);
            y = y + 1;
        }
    }
    // Draw an Image at (x, y), skipping fully-transparent source pixels.
    public void blit(int x, int y, Image im) {
        int dy = 0;
        while (dy < im.h) {
            int dx = 0;
            while (dx < im.w) {
                int c = im.get(dx, dy);
                if (Image.ca(c) > 0) {
                    this.set(x + dx, y + dy, c);
                }
                dx = dx + 1;
            }
            dy = dy + 1;
        }
    }
    // Draw a string with the 5x7 font (1 px spacing). Returns the width
    // in pixels. Lower-case letters render as their upper-case glyph.
    public int text(int x, int y, string s, int c) {
        if (Window.font == null) {
            Window.font_init();
        }
        int n = strlen(s);
        int i = 0;
        while (i < n) {
            int ch = sys.byte_load(s + i);
            if (ch >= 97 && ch <= 122) {
                ch = ch - 32;     // a-z -> A-Z
            }
            if (ch >= 32 && ch < 127) {
                this.draw_glyph(x + i * 6, y, ch - 32, c);
            }
            i = i + 1;
        }
        return n * 6;
    }
    private void draw_glyph(int x, int y, int idx, int c) {
        int row = 0;
        while (row < 7) {
            int bits = sys.byte_load(Window.font + idx * 7 + row);
            int col = 0;
            while (col < 5) {
                if ((bits >> (4 - col)) & 1) {
                    this.set(x + col, y + row, c);
                }
                col = col + 1;
            }
            row = row + 1;
        }
    }

    // ---------------------------------------------------------- backends
    // Push the canvas to the screen. Returns 0 on success.
    public int refresh() {
        if (this.alive == 0) {
            return -1;
        }
        if (this.backend == 0) {
            return this.fb_refresh();
        }
        return this.x11_refresh();
    }
    // Render once, then hold the window open for `seconds` seconds.
    public void wait(int seconds) {
        if (this.alive == 0) {
            return;
        }
        this.refresh();
        int i = 0;
        while (i < seconds) {
            sys.nanosleep(1, 0);
            i = i + 1;
        }
    }
    public void close() {
        if (this.backend == 0) {
            if (this.fb != null) {
                int size = this.fb_h * this.fb_pitch;
                sys.munmap(this.fb, size);
            }
            if (this.fb_fd >= 0) {
                sys.close(this.fb_fd);
            }
        } else {
            if (this.x_fd >= 0) {
                sys.close(this.x_fd);
            }
        }
        this.alive = 0;
    }

    // ------------------------------------------------- framebuffer backend
    private int fb_open() {
        int fd = -1;
        int i = 0;
        while (i < 4) {
            string p = "/dev/fb" + str.itoa(i);
            fd = sys.open(p, 2, 0);
            if (fd >= 0) {
                break;
            }
            i = i + 1;
        }
        if (fd < 0) {
            return -1;    // no framebuffer device
        }
        this.fb_fd = fd;
        // struct fb_var_screeninfo: red/green/blue bitfields + bpp.
        string vi = alloc(128);
        if (sys.syscall(16, fd, 0x4600, vi, 0, 0) < 0) {
            sys.close(fd);
            return -2;
        }
        this.fb_w = sys.int_load(vi + 0);
        this.fb_h = sys.int_load(vi + 4);
        this.ro_off = sys.short_load(vi + 24);
        this.ro_len = sys.short_load(vi + 26);
        this.go_off = sys.short_load(vi + 28);
        this.go_len = sys.short_load(vi + 30);
        this.bo_off = sys.short_load(vi + 32);
        this.bo_len = sys.short_load(vi + 34);
        this.fb_bpp = sys.short_load(vi + 40);
        if (this.fb_bpp < 8) {
            this.fb_bpp = 32;
        }
        // struct fb_fix_screeninfo: line_length at offset 44.
        string fi = alloc(80);
        if (sys.syscall(16, fd, 0x4602, fi, 0, 0) < 0) {
            sys.close(fd);
            return -3;
        }
        this.fb_pitch = sys.int_load(fi + 44);
        if (this.fb_pitch < 1) {
            this.fb_pitch = this.fb_w * (this.fb_bpp / 8);
        }
        int size = this.fb_h * this.fb_pitch;
        // mmap(NULL, size, PROT_READ|PROT_WRITE, MAP_SHARED, fd, 0)
        string m = sys.mmap(0, size, 3, 1, fd, 0);
        int addr = m;
        if (addr < 0) {
            sys.close(fd);
            return -4;
        }
        this.fb = m;
        return 0;
    }
    private int fb_refresh() {
        int y = 0;
        while (y < this.ch) {
            int x = 0;
            while (x < this.cw) {
                this.fb_put(x, y, this.get(x, y));
                x = x + 1;
            }
            y = y + 1;
        }
        return 0;
    }
    // Write one packed pixel into the framebuffer honouring its bitfields.
    private void fb_put(int x, int y, int c) {
        int off = y * this.fb_pitch + x * (this.fb_bpp / 8);
        if (this.fb_bpp < 8) {
            return;
        }
        int r = Image.cr(c);
        int g = Image.cg(c);
        int b = Image.cb(c);
        int val = 0;
        int rl = this.ro_len; if (rl > 8) { rl = 8; } if (rl < 1) { rl = 1; }
        int gl = this.go_len; if (gl > 8) { gl = 8; } if (gl < 1) { gl = 1; }
        int bl = this.bo_len; if (bl > 8) { bl = 8; } if (bl < 1) { bl = 1; }
        val = val | (((r >> (8 - rl)) & ((1 << rl) - 1)) << this.ro_off);
        val = val | (((g >> (8 - gl)) & ((1 << gl) - 1)) << this.go_off);
        val = val | (((b >> (8 - bl)) & ((1 << bl) - 1)) << this.bo_off);
        int n = this.fb_bpp / 8;
        int i = 0;
        while (i < n) {
            sys.byte_store(this.fb + off + i, val & 255);
            val = val >> 8;
            i = i + 1;
        }
    }

    // -------------------------------------------------------- X11 backend
    // Connect to the local X server, do the handshake, and create + map
    // a window of canvas size. Returns 0 on success.
    private int x11_open() {
        int idx = 0;
        string d = env.get("DISPLAY");
        if (d != null) {
            int n = strlen(d);
            int i = 0;
            while (i < n) {
                if (sys.byte_load(d + i) == 58) {   // ':'
                    int j = i + 1;
                    int v = 0;
                    int any = 0;
                    while (j < n) {
                        int b = sys.byte_load(d + j);
                        if (b >= 48 && b <= 57) {
                            v = v * 10 + (b - 48);
                            any = 1;
                        } else {
                            break;
                        }
                        j = j + 1;
                    }
                    if (any == 1) {
                        idx = v;
                    }
                    break;
                }
                i = i + 1;
            }
        }
        string sock = "/tmp/.X11-unix/X" + str.itoa(idx);
        string sa = alloc(120);
        sys.byte_store(sa, 1);        // sun_family
        int n = strlen(sock);
        int i = 0;
        while (i < n) {
            sys.byte_store(sa + 2 + i, sys.byte_load(sock + i));
            i = i + 1;
        }
        sys.byte_store(sa + 2 + n, 0);   // NUL-terminate the path
        int sa_len = 2 + n + 1;          // family + path + NUL (< 110)
        int s = sys.socket(1, 1, 0);
        if (s < 0) {
            return -1;
        }
        this.x_fd = s;
        if (sys.connect(s, sa, sa_len) < 0) {
            sys.close(s);
            return -2;
        }
        // Connection setup request (LSB byte order, version 11.0). If an
        // xauth cookie is available for this display, present it as
        // MIT-MAGIC-COOKIE-1 (name 20 bytes + cookie 16 bytes); otherwise
        // send with no auth, which only works against unauthenticated
        // servers.
        string req = alloc(46);
        sys.byte_store(req + 0, 0x6C);     // 'l' = least significant byte first
        sys.byte_store(req + 1, 0);
        sys.short_store(req + 2, 11);      // protocol-major-version
        sys.short_store(req + 4, 0);       // protocol-minor-version
        int reqlen = 12;
        string cookie = alloc(16);
        int found = this.x11_find_cookie(idx, cookie);
        if (found == 1) {
            sys.short_store(req + 6, 18);   // auth protocol name length
            sys.short_store(req + 8, 16);   // auth protocol data length
            string mit = "MIT-MAGIC-COOKIE-1";
            int k = 0;
            while (k < 18) {
                sys.byte_store(req + 12 + k, sys.byte_load(mit + k));
                k = k + 1;
            }
            int m = 0;
            while (m < 16) {
                sys.byte_store(req + 30 + m, sys.byte_load(cookie + m));
                m = m + 1;
            }
            reqlen = 46;
        } else {
            sys.short_store(req + 6, 0);
            sys.short_store(req + 8, 0);
        }
        if (this.x11_write(req, reqlen) < 0) {
            sys.close(s);
            return -3;
        }
        int r = this.x11_handshake();
        if (r < 0) {
            sys.close(s);
            return r;
        }
        // CreateGC (opcode 56), no attributes.
        this.x_gc = this.x_idbase + 1;
        this.x_win = this.x_idbase + 2;
        string gc = alloc(16);
        sys.byte_store(gc + 0, 56);
        sys.byte_store(gc + 1, 0);
        sys.short_store(gc + 2, 4);        // length = 16/4
        sys.int_store(gc + 4, this.x_gc);
        sys.int_store(gc + 8, this.x_win); // drawable
        sys.int_store(gc + 12, 0);         // value-mask = 0
        if (this.x11_write(gc, 16) < 0) {
            sys.close(s);
            return -5;
        }
        // CreateWindow (opcode 1): background-pixel + event-mask.
        int mask = 0x10 | 0x200;
        string cw = alloc(40);
        sys.byte_store(cw + 0, 1);
        sys.byte_store(cw + 1, this.x_depth);
        sys.short_store(cw + 2, 10);       // length = 40/4
        sys.int_store(cw + 4, this.x_win);
        sys.int_store(cw + 8, this.x_root);
        sys.short_store(cw + 12, 0);       // x
        sys.short_store(cw + 14, 0);       // y
        sys.short_store(cw + 16, this.cw);
        sys.short_store(cw + 18, this.ch);
        sys.short_store(cw + 20, 0);       // border-width
        sys.short_store(cw + 22, 1);       // class = InputOutput
        sys.int_store(cw + 24, 0);         // visual = CopyFromParent
        sys.int_store(cw + 28, mask);
        sys.int_store(cw + 32, 0);         // background-pixel (black)
        sys.int_store(cw + 36, 0x80 | 0x200);  // event-mask
        if (this.x11_write(cw, 40) < 0) {
            sys.close(s);
            return -6;
        }
        // MapWindow (opcode 26).
        string mw = alloc(12);
        sys.byte_store(mw + 0, 26);
        sys.byte_store(mw + 1, 0);
        sys.short_store(mw + 2, 3);        // length = 12/4
        sys.int_store(mw + 4, this.x_win);
        sys.byte_store(mw + 8, 1);         // map-mode = Map
        if (this.x11_write(mw, 12) < 0) {
            sys.close(s);
            return -7;
        }
        return 0;
    }
    // Read exactly n bytes from the X socket; -1 on EOF/error.
    private int x11_read_n(string buf, int n) {
        int got = 0;
        while (got < n) {
            int r = sys.read(this.x_fd, buf + got, n - got);
            if (r <= 0) {
                return -1;
            }
            got = got + r;
        }
        return 0;
    }
    private int x11_write(string buf, int n) {
        int sent = 0;
        while (sent < n) {
            int w = sys.write(this.x_fd, buf + sent, n - sent);
            if (w <= 0) {
                return -1;
            }
            sent = sent + w;
        }
        return 0;
    }
    // Read the xauth file (from $XAUTHORITY, else $HOME/.Xauthority) and
    // extract the 16-byte MIT-MAGIC-COOKIE-1 cookie for display ":idx"
    // into `out` (a 16-byte buffer). Returns 1 on success, 0 otherwise.
    // Record layout (big-endian 16-bit lengths):
    //   [family(2)][host_len][host][disp_len][disp][name_len][name]
    //   [cookie_len][cookie]
    private int x11_find_cookie(int idx, string out) {
        string path = env.get("XAUTHORITY");
        if (path == null) {
            string home = env.get("HOME");
            if (home == null) {
                return 0;
            }
            path = home + "/.Xauthority";
        }
        int fd = sys.open(path, 0, 0);   // O_RDONLY
        if (fd < 0) {
            return 0;
        }
        string buf = alloc(8192);
        int total = 0;
        while (true) {
            int r = sys.read(fd, buf + total, 8192 - total);
            if (r <= 0) {
                break;
            }
            total = total + r;
        }
        sys.close(fd);
        string mit = "MIT-MAGIC-COOKIE-1";
        string w1 = ":" + str.itoa(idx);   // e.g. ":0"
        string w2 = str.itoa(idx);          // e.g. "0"
        int pos = 0;
        while (pos + 2 <= total) {
            pos = pos + 2;                   // family (fixed 2 bytes)
            if (pos + 2 > total) { return 0; }
            int host_len = Window.be16(buf + pos);
            pos = pos + 2;
            if (pos + host_len > total) { return 0; }
            pos = pos + host_len;
            if (pos + 2 > total) { return 0; }
            int disp_len = Window.be16(buf + pos);
            pos = pos + 2;
            if (pos + disp_len > total) { return 0; }
            int disp = pos;
            pos = pos + disp_len;
            if (pos + 2 > total) { return 0; }
            int name_len = Window.be16(buf + pos);
            pos = pos + 2;
            if (pos + name_len + 2 > total) { return 0; }
            int name = pos;
            pos = pos + name_len;
            int cookie_len = Window.be16(buf + pos);
            pos = pos + 2;
            if (pos + cookie_len > total) { return 0; }
            int cookie = pos;
            // name == "MIT-MAGIC-COOKIE-1" (18 bytes)
            int nameok = (name_len == 18);
            int j = 0;
            while (j < 18) {
                if (sys.byte_load(name + j) != sys.byte_load(mit + j)) {
                    nameok = 0;
                }
                j = j + 1;
            }
            // display == ":idx" or "idx"
            int dispok = 0;
            if (disp_len == strlen(w1)) {
                int da = 0;
                dispok = 1;
                while (da < disp_len) {
                    if (sys.byte_load(buf + disp + da) != sys.byte_load(w1 + da)) {
                        dispok = 0;
                    }
                    da = da + 1;
                }
            }
            if (dispok == 0 && disp_len == strlen(w2)) {
                int db = 0;
                dispok = 1;
                while (db < disp_len) {
                    if (sys.byte_load(buf + disp + db) != sys.byte_load(w2 + db)) {
                        dispok = 0;
                    }
                    db = db + 1;
                }
            }
            if (nameok == 1 && dispok == 1) {
                int m = 0;
                while (m < 16) {
                    sys.byte_store(out + m, sys.byte_load(buf + cookie + m));
                    m = m + 1;
                }
                return 1;
            }
            pos = pos + cookie_len;
        }
        return 0;
    }
    // Parse the connection setup reply: an 8-byte prefix (checked first),
    // then 28 more bytes to complete the 36-byte fixed part, then the
    // vendor string, the pixmap formats, then the screens. Multi-byte
    // values are little-endian (the byte-order byte is 'l').
    private int x11_handshake() {
        string b = alloc(64);
        if (this.x11_read_n(b, 8) < 0) {
            return -1;
        }
        int success = sys.byte_load(b);
        if (success == 0) {
            // Connection refused (auth failed or no matching protocol).
            // The reason string follows the 8-byte prefix; we do not drain
            // it because the caller closes the socket.
            return -2;
        }
        if (success != 1) {
            return -3;
        }
        if (this.x11_read_n(b, 28) < 0) {
            return -4;
        }
        // Fixed part (little-endian): 8-9 vendor length, 10-11 number of
        // screens, 12-13 number of pixmap formats, 15 max bit depth,
        // 16 image byte order.
        int nv = sys.short_load(b + 8);
        int nr = sys.short_load(b + 10);
        int nf = sys.short_load(b + 12);
        int max_depth = sys.byte_load(b + 15);
        this.x_lsb = (sys.byte_load(b + 16) == 0) ? 1 : 0;
        // Resource IDs are assigned by the client; pick a high base.
        this.x_idbase = 268435456;   // 0x01000000
        int i = 0;
        while (i < nv) {
            if (this.x11_read_n(b, 1) < 0) {
                return -5;
            }
            i = i + 1;
        }
        int f = 0;
        while (f < nf) {
            if (this.x11_read_n(b, 8) < 0) {
                return -6;
            }
            f = f + 1;
        }
        if (nr < 1) {
            return -7;
        }
        if (this.x11_read_n(b, 40) < 0) {
            return -8;
        }
        this.x_root = sys.int_load(b);
        // Use the server's maximum bit depth (our canvas is RGBA32).
        this.x_depth = (max_depth >= 8) ? max_depth : 24;
        i = 1;
        while (i < nr) {
            if (this.x11_read_n(b, 40) < 0) {
                return -9;
            }
            i = i + 1;
        }
        return 0;
    }
    // Send a PutImage (opcode 72) of the whole canvas as a ZPixmap.
    private int x11_refresh() {
        int depth = this.x_depth;
        int bpp = depth / 8;
        if (bpp < 1) {
            bpp = 1;
        }
        int npix = this.cw * this.ch;
        string img = alloc(npix * 4);
        int i = 0;
        while (i < npix) {
            int o = i * 4;
            int b = sys.byte_load(this.canvas + o);
            int g = sys.byte_load(this.canvas + o + 1);
            int r = sys.byte_load(this.canvas + o + 2);
            int val = (r << 16) | (g << 8) | b;    // 0x00RRGGBB
            int k = 0;
            while (k < bpp) {
                int shift = this.x_lsb == 1 ? (8 * k) : (8 * (bpp - 1 - k));
                int bv = (val >> shift) & 255;
                sys.byte_store(img + i * bpp + k, bv);
                k = k + 1;
            }
            i = i + 1;
        }
        int nbytes = npix * bpp;
        int total = 24 + nbytes;
        string req = alloc(total);
        sys.byte_store(req + 0, 72);
        sys.byte_store(req + 1, 2);              // format = ZPixmap
        sys.short_store(req + 2, total / 4);    // length in 4-byte units
        sys.int_store(req + 4, this.x_win);     // drawable
        sys.int_store(req + 8, this.x_gc);
        sys.short_store(req + 12, this.cw);
        sys.short_store(req + 14, this.ch);
        sys.short_store(req + 16, 0);           // dst-x
        sys.short_store(req + 18, 0);           // dst-y
        sys.byte_store(req + 20, 0);            // left-pad
        sys.byte_store(req + 21, depth);
        int j = 0;
        while (j < nbytes) {
            sys.byte_store(req + 24 + j, sys.byte_load(img + j));
            j = j + 1;
        }
        int r = this.x11_write(req, total);
        free(img);
        return r;
    }

    // ------------------------------------------------------------- font
    static void font_init() {
        Window.font = alloc(95 * 7);
        int i = 0;
        while (i < 95 * 7) {
            sys.byte_store(Window.font + i, 0);
            i = i + 1;
        }
        // digits
        Window.g0(16, 14, 17, 19, 21);
        Window.g4(16, 25, 17, 14);   // 0
        Window.g0(17, 4, 12, 4, 4);
        Window.g4(17, 4, 4, 14);       // 1
        Window.g0(18, 14, 17, 1, 6);
        Window.g4(18, 8, 16, 31);     // 2
        Window.g0(19, 30, 1, 1, 14);
        Window.g4(19, 1, 1, 30);      // 3
        Window.g0(20, 2, 6, 10, 18);
        Window.g4(20, 31, 2, 2);      // 4
        Window.g0(21, 31, 16, 30, 1);
        Window.g4(21, 1, 16, 30);    // 5
        Window.g0(22, 6, 8, 16, 30);
        Window.g4(22, 17, 17, 14);    // 6
        Window.g0(23, 31, 1, 2, 4);
        Window.g4(23, 8, 8, 8);        // 7
        Window.g0(24, 14, 17, 17, 14);
        Window.g4(24, 17, 17, 14); // 8
        Window.g0(25, 14, 17, 17, 15);
        Window.g4(25, 1, 6, 4);    // 9
        // upper-case
        Window.g0(33, 14, 17, 17, 31);
        Window.g4(33, 17, 17, 17); // A
        Window.g0(34, 30, 17, 17, 30);
        Window.g4(34, 17, 17, 30); // B
        Window.g0(35, 14, 17, 16, 16);
        Window.g4(35, 16, 17, 14); // C
        Window.g0(36, 28, 18, 17, 17);
        Window.g4(36, 17, 18, 28); // D
        Window.g0(37, 31, 16, 16, 30);
        Window.g4(37, 16, 16, 31); // E
        Window.g0(38, 31, 16, 16, 30);
        Window.g4(38, 16, 16, 16); // F
        Window.g0(39, 14, 17, 16, 23);
        Window.g4(39, 17, 17, 15); // G
        Window.g0(40, 17, 17, 17, 31);
        Window.g4(40, 17, 17, 17); // H
        Window.g0(41, 14, 4, 4, 4);
        Window.g4(41, 4, 4, 14);      // I
        Window.g0(42, 7, 2, 2, 2);
        Window.g4(42, 2, 18, 12);      // J
        Window.g0(43, 17, 18, 20, 24);
        Window.g4(43, 20, 18, 17); // K
        Window.g0(44, 16, 16, 16, 16);
        Window.g4(44, 16, 16, 31); // L
        Window.g0(45, 17, 27, 21, 21);
        Window.g4(45, 17, 17, 17); // M
        Window.g0(46, 17, 25, 21, 19);
        Window.g4(46, 17, 17, 17); // N
        Window.g0(47, 14, 17, 17, 17);
        Window.g4(47, 17, 17, 14); // O
        Window.g0(48, 30, 17, 17, 30);
        Window.g4(48, 16, 16, 16); // P
        Window.g0(49, 14, 17, 17, 17);
        Window.g4(49, 21, 18, 13); // Q
        Window.g0(50, 30, 17, 17, 30);
        Window.g4(50, 20, 18, 17); // R
        Window.g0(51, 15, 16, 16, 14);
        Window.g4(51, 1, 1, 30);   // S
        Window.g0(52, 31, 4, 4, 4);
        Window.g4(52, 4, 4, 4);       // T
        Window.g0(53, 17, 17, 17, 17);
        Window.g4(53, 17, 17, 14); // U
        Window.g0(54, 17, 17, 17, 17);
        Window.g4(54, 10, 10, 4);  // V
        Window.g0(55, 17, 17, 17, 21);
        Window.g4(55, 21, 27, 17); // W
        Window.g0(56, 17, 17, 10, 4);
        Window.g4(56, 10, 17, 17);  // X
        Window.g0(57, 17, 17, 10, 4);
        Window.g4(57, 4, 4, 4);     // Y
        Window.g0(58, 31, 1, 2, 4);
        Window.g4(58, 8, 16, 31);     // Z
        // symbols
        Window.g0(1, 4, 4, 4, 4);
        Window.g4(1, 4, 0, 4);         // !
        Window.g0(2, 10, 10, 0, 0);
        Window.g4(2, 0, 0, 0);       // "
        Window.g0(3, 10, 10, 31, 10);
        Window.g4(3, 31, 10, 0);   // #
        Window.g0(4, 4, 15, 20, 14);
        Window.g4(4, 5, 30, 4);     // $
        Window.g0(5, 25, 25, 2, 4);
        Window.g4(5, 8, 17, 17);     // %
        Window.g0(6, 8, 20, 18, 8);
        Window.g4(6, 21, 10, 20);    // &
        Window.g0(7, 4, 4, 0, 0);
        Window.g4(7, 0, 0, 0);         // '
        Window.g0(8, 2, 4, 8, 8);
        Window.g4(8, 8, 4, 2);         // (
        Window.g0(9, 8, 4, 2, 2);
        Window.g4(9, 2, 4, 8);         // )
        Window.g0(10, 0, 21, 14, 31);
        Window.g4(10, 14, 21, 0);  // *
        Window.g0(11, 0, 4, 4, 31);
        Window.g4(11, 4, 4, 0);      // +
        Window.g0(12, 0, 0, 0, 0);
        Window.g4(12, 0, 4, 6);       // ,
        Window.g0(13, 0, 0, 0, 31);
        Window.g4(13, 0, 0, 0);      // -
        Window.g0(14, 0, 0, 0, 0);
        Window.g4(14, 0, 12, 12);     // .
        Window.g0(15, 1, 1, 2, 4);
        Window.g4(15, 8, 8, 16);      // /
        Window.g0(26, 0, 12, 12, 0);
        Window.g4(26, 12, 12, 0);   // :
        Window.g0(27, 0, 12, 12, 0);
        Window.g4(27, 12, 4, 6);    // ;
        Window.g0(28, 2, 4, 8, 16);
        Window.g4(28, 8, 4, 2);      // <
        Window.g0(29, 0, 0, 31, 0);
        Window.g4(29, 31, 0, 0);     // =
        Window.g0(30, 8, 4, 2, 1);
        Window.g4(30, 2, 4, 8);       // >
        Window.g0(31, 14, 17, 1, 6);
        Window.g4(31, 4, 0, 4);     // ?
        Window.g0(59, 14, 8, 8, 8);
        Window.g4(59, 8, 8, 14);      // [
        Window.g0(60, 16, 8, 8, 4);
        Window.g4(60, 2, 1, 1);      // \
        Window.g0(61, 14, 2, 2, 2);
        Window.g4(61, 2, 2, 14);     // ]
        Window.g0(62, 4, 10, 17, 0);
        Window.g4(62, 0, 0, 0);     // ^
        Window.g0(63, 0, 0, 0, 0);
        Window.g4(63, 0, 0, 31);      // _
    }
    // Store rows 0-3 (each 0..31) for glyph index `c` (0 = space, 1 = '!', ...).
    static void g0(int c, int r0, int r1, int r2, int r3) {
        int o = c * 7;
        sys.byte_store(Window.font + o, r0);
        sys.byte_store(Window.font + o + 1, r1);
        sys.byte_store(Window.font + o + 2, r2);
        sys.byte_store(Window.font + o + 3, r3);
    }
    // Store rows 4-6 (each 0..31) for glyph index `c`.
    static void g4(int c, int r4, int r5, int r6) {
        int o = c * 7;
        sys.byte_store(Window.font + o + 4, r4);
        sys.byte_store(Window.font + o + 5, r5);
        sys.byte_store(Window.font + o + 6, r6);
    }
}
