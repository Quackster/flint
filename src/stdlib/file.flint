// std/file — file I/O over the raw syscall builtins.
//
// Usage:
//   import std.File;
//   File.writeAll("/tmp/hello.txt", "hi");
//   string data = File.readAll("/tmp/hello.txt");
//
// x86_64 syscalls: open=2 read=0 write=1 close=3 fstat=5
//                  pread=17 pwrite=1 unlink=87
package std;
class File {
    // O_RDWR
    static int open(string path) { return sys.open(path, 2, 0); }
    // O_WRONLY | O_CREAT | O_TRUNC, mode 0644
    static int openForWrite(string path) {
        return sys.open(path, 0x241, 0x1a4);
    }
    static int close(int fd) { return sys.close(fd); }
    static int size(string path) {
        int fd = sys.open(path, 0, 0);
        if (fd < 0) {
            return -1;
        }
        // Ownership: `st` is a fresh buffer (single owner); it frees
        // itself when it goes out of scope.
        string st = string[280];
        int r = sys.syscall(5, fd, st, 0, 0, 0);
        sys.close(fd);
        if (r < 0) {
            return -1;
        }
        int sz = st[6];  // struct stat: st_size at offset 48
        return sz;
    }
    // NUL-terminated copy of the whole file, or null if it cannot be
    // opened. Reads in 4KB chunks — files like /proc/self/statm report
    // size 0, so no pre-sized buffer — doubling the buffer as needed (the
    // old one frees itself on reassignment).
    static string readAll(string path) {
        int fd = sys.open(path, 0, 0);
        if (fd < 0) {
            return null;
        }
        int cap = 4096;
        string out = string[cap];
        int off = 0;
        while (true) {
            if (off >= cap) {
                int ncap = cap * 2;
                string nb = string[ncap];
                int k = 0;
                while (k < off) {
                    nb[k] = out[k];
                    k = k + 1;
                }
                out = nb;
                cap = ncap;
            }
            int n = sys.syscall(17, fd, out + off, 4096, off, 0);
            if (n <= 0) {
                break;
            }
            off = off + n;
        }
        sys.close(fd);
        out[off] = 0;
        return out;
    }
    // O_WRONLY | O_CREAT | O_TRUNC; returns the fd or a negative errno.
    static int writeAll(string path, string data) {
        int fd = sys.open(path, 0x241, 0x1a4);
        if (fd < 0) {
            return fd;
        }
        int n = sys.write(fd, data, strlen(data));
        sys.close(fd);
        return n;
    }
    // 1 if the path opens for reading, 0 otherwise.
    static int exists(string path) {
        int fd = sys.open(path, 0, 0);
        if (fd < 0) {
            return 0;
        }
        sys.close(fd);
        return 1;
    }
    // unlink is syscall 87 in this toolchain's kernel (not 37).
    static int delete(string path) {
        return sys.syscall(87, path, 0, 0, 0, 0);
    }
    // O_WRONLY | O_CREAT | O_APPEND (0x441), mode 0644.
    static int append(string path, string data) {
        int fd = sys.open(path, 0x441, 0x1a4);
        if (fd < 0) {
            return fd;
        }
        int n = sys.write(fd, data, strlen(data));
        sys.close(fd);
        return n;
    }
    // Copy the whole file src to dst; -1 if src cannot be read.
    static int copy(string src, string dst) {
        string data = File.readAll(src);
        if (data == null) {
            return -1;
        }
        return File.writeAll(dst, data);
    }
    // rename is syscall 82 on this toolchain's kernel.
    static int rename(string path, string newpath) {
        return sys.syscall(82, path, newpath, 0, 0, 0);
    }
    // First newline-terminated line of the file (else the whole file, or null).
    static string readLine(string path) {
        string data = File.readAll(path);
        if (data == null) {
            return null;
        }
        int i = 0;
        int n = strlen(data);
        while (i < n) {
            if (data[i] == 10) {
                return str.substring(data, 0, i);
            }
            i = i + 1;
        }
        return str.copy(data);
    }
}
