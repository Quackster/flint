// std/coll — the collections as ordinary generic classes over raw 8-byte
// slot arrays: `Collection` (the base), `List<T>`, `Queue<T>`,
// `HashSet<T>`, `HashMap<K, V>`, and `CopyOnWriteList<T>`.
//
// Every collection stores its elements in a `Mem.intArray` of 8-byte
// slots that it manipulates itself: `List` grows by doubling and
// copying, `Queue` is a FIFO ring over its slots, and the hash family
// uses open addressing (linear probing, tombstones) over slot pairs.
//
// The element flavour is fixed by the type parameter (the compiler bakes
// it into the `kind` field when the class is monomorphized):
//   int / bool / enum / pointer / array   -> 0  compared/hashed by value
//   string                                -> 1  compared by content, FNV-1a
//   a class type                          -> 2  refcounted — retained on
//                                              store, released on
//                                              clear/destroy; by pointer
// A `HashMap<K, V>` carries `kkind`/`vkind` for its keys and values.
//
// The element-facing API is typed: `add(T)`, `T get(i)`,
// `T set(i, T)` (returns the displaced element), `T remove(i)`
// (returns the removed element), `contains(T)`, … For
// `List<string>` the methods take and return `string`; for
// `List<Foo>` they take and return `Foo`. The compiler resolves
// `T` to the concrete element type when the class is monomorphized;
// the internals still move raw 8-byte slots and dispatch on `kind`.
//
// Common API: `size()`, `isEmpty()`, `clear()`. `destroy()` runs when
// the last reference drops (it drops the element references and frees
// the slot array) — do not call it manually.
//
// `CopyOnWriteList` is the concurrent member: every mutator
// (add / insert / set / remove / removeObject / clear) builds a fresh
// slot array (retaining the copied object elements) and swaps it in
// under a lock; readers (get / contains / indexOf / …) and `snapshot()`
// (the COW "iterator", a plain `List<T>`) never lock, and a snapshot
// is not affected by later mutations.
//
// Usage:
//   import std.List;
//   import std.HashMap;
//   List<int> xs = new List<int>();
//   xs.add(41);
//   printi(xs.get(0));
//   HashMap<string, int> m = new HashMap<string, int>();
//   m.put("a", 1);
//   printi(m.get("a"));
package std;
abstract class Collection {
    *int slots;
    int cap;
    int count;
    int kind;
    public Collection() {
        this.kind = 0;
        this.cap = 16;
        this.count = 0;
        this.slots = Mem.intArray(16);
    }
    int size() {
        return this.count;
    }
    boolean isEmpty() {
        return this.count == 0;
    }
    // Swap in a fresh slot array; the old one is released.
    void replaceSlots(*int ns, int newCap) {
        Mem.freeInt(this.slots);
        this.slots = ns;
        this.cap = newCap;
    }
    // splitmix64 finalizer for int keys.
    static int hashInt(int v) {
        int h = v + 0x9E3779B97F4A7C15;
        h = (h ^ (h >> 30)) * 0xBF58476D1CE4E5B9;
        h = (h ^ (h >> 27)) * 0x94D049BB133111EB;
        return h ^ (h >> 31);
    }
    // FNV-1a 64 over the string's bytes.
    static int hashStr(string s) {
        int h = 0xcbf29ce484222325;
        int n = strlen(s);
        int i = 0;
        while (i < n) {
            h = (h ^ sys.byteLoad(s + i)) * 0x100000001b3;
            i = i + 1;
        }
        return h;
    }
    static int hash(int kind, int v) {
        if (kind == 1) {
            return Collection.hashStr(v);
        }
        return Collection.hashInt(v);
    }
    // Equality by flavour: strings by content, ints and objects by value.
    static int eq(int kind, int a, int b) {
        if (kind == 1) {
            return strcmp(a, b) == 0;
        }
        return a == b;
    }
    // Signed less-than by flavour (sort order).
    static int lt(int kind, int a, int b) {
        if (kind == 1) {
            return strcmp(a, b) < 0;
        }
        return a < b;
    }
    // Retain / release an element reference (no-op for non-object kinds).
    static void retainElem(int kind, int v) {
        if (kind == 2 && v != 0) {
            Mem.retain(v);
        }
    }
    static void releaseElem(int kind, int v) {
        if (kind == 2 && v != 0) {
            Mem.release(v);
        }
    }
    abstract void clear();
    // destroy(): the compiler calls this when the last reference drops.
    // Drops the elements' references and releases the slot array.
    void destroy() {
        this.clear();
        Mem.freeInt(this.slots);
    }
}
class List<T> extends Collection {
    public List() {
        super();
        this.kind = 0; // baked by the compiler from T
    }
    void add(T v) {
        if (this.count >= this.cap) {
            *int ns = Mem.intArray(this.cap * 2);
            Mem.copy(ns, this.slots, this.count * 8);
            this.replaceSlots(ns, this.cap * 2);
        }
        Collection.retainElem(this.kind, v);
        this.slots[this.count] = v;
        this.count = this.count + 1;
    }
    // The stored element (0 when out of range; object elements get a
    // fresh reference).
    T get(int i) {
        int v = this.slots[i];
        Collection.retainElem(this.kind, v);
        return v;
    }
    // Write the slot; returns the displaced element (released here,
    // retained for the caller).
    T set(int i, T v) {
        int old = this.slots[i];
        Collection.releaseElem(this.kind, old);
        Collection.retainElem(this.kind, v);
        this.slots[i] = v;
        return old;
    }
    // Insert at i (the tail shifts right; i >= size appends).
    void insert(int i, T v) {
        if (i >= this.count) {
            i = this.count;
        }
        if (this.count + 1 > this.cap) {
            *int ns = Mem.intArray(this.cap * 2);
            Mem.copy(ns, this.slots, this.count * 8);
            this.replaceSlots(ns, this.cap * 2);
        }
        int j = this.count - 1;
        while (j >= i) {
            this.slots[j + 1] = this.slots[j];
            j = j - 1;
        }
        Collection.retainElem(this.kind, v);
        this.slots[i] = v;
        this.count = this.count + 1;
    }
    // The removed element (0 when i >= size; object elements get a
    // fresh reference).
    T remove(int i) {
        if (i >= this.count) {
            return 0;
        }
        int v = this.slots[i];
        int j = i + 1;
        while (j < this.count) {
            this.slots[j - 1] = this.slots[j];
            j = j + 1;
        }
        this.count = this.count - 1;
        Collection.retainElem(this.kind, v);
        return v;
    }
    int contains(T v) {
        int i = 0;
        while (i < this.count) {
            if (Collection.eq(this.kind, this.slots[i], v) == 1) {
                return 1;
            }
            i = i + 1;
        }
        return 0;
    }
    void clear() {
        int i = 0;
        while (i < this.count) {
            Collection.releaseElem(this.kind, this.slots[i]);
            i = i + 1;
        }
        this.count = 0;
    }
    // Insertion sort: ints signed ascending, strings by content.
    void sort() {
        int i = 1;
        while (i < this.count) {
            int j = i - 1;
            while (j >= 0) {
                int a = this.slots[j];
                int b = this.slots[j + 1];
                if (Collection.lt(this.kind, a, b) == 1) {
                    j = j - 1;
                } else {
                    this.slots[j + 1] = a;
                    this.slots[j] = b;
                    j = j - 1;
                }
            }
            i = i + 1;
        }
    }
    void reverse() {
        int i = 0;
        int j = this.count - 1;
        while (i < j) {
            int t = this.slots[i];
            this.slots[i] = this.slots[j];
            this.slots[j] = t;
            i = i + 1;
            j = j - 1;
        }
    }
    // Elements joined by sep: strings verbatim, the rest via itoa.
    string join(string sep) {
        string out = "";
        int i = 0;
        while (i < this.count) {
            int v = this.slots[i];
            if (i > 0) {
                out = str.concat(out, sep);
            }
            if (this.kind == 1) {
                out = str.concat(out, v);
            } else {
                out = str.concat(out, str.itoa(v));
            }
            i = i + 1;
        }
        return out;
    }
}
class Queue<T> extends Collection {
    int head;
    public Queue() {
        super();
        this.kind = 0; // baked by the compiler from T
        this.head = 0;
    }
    void push(T v) {
        if (this.count >= this.cap) {
            int i = 0;
            while (i < this.count) {
                this.slots[i] = this.slots[(this.head + i) % this.cap];
                i = i + 1;
            }
            this.head = 0;
            *int ns = Mem.intArray(this.cap * 2);
            Mem.copy(ns, this.slots, this.count * 8);
            this.replaceSlots(ns, this.cap * 2);
        }
        Collection.retainElem(this.kind, v);
        this.slots[(this.head + this.count) % this.cap] = v;
        this.count = this.count + 1;
    }
    // The front element (0 when empty; the stored reference transfers
    // to the caller).
    T pop() {
        if (this.count == 0) {
            return 0;
        }
        int v = this.slots[this.head % this.cap];
        this.head = (this.head + 1) % this.cap;
        this.count = this.count - 1;
        return v;
    }
    T peek() {
        if (this.count == 0) {
            return 0;
        }
        int v = this.slots[this.head % this.cap];
        Collection.retainElem(this.kind, v);
        return v;
    }
    void clear() {
        int i = 0;
        while (i < this.count) {
            Collection.releaseElem(this.kind, this.slots[(this.head + i) % this.cap]);
            i = i + 1;
        }
        this.count = 0;
        this.head = 0;
    }
}
class HashSet<T> extends Collection {
    // 2 slots per bucket: [value, flag]; flag 0 empty, 1 occupied,
    // 2 tombstone. Bucket count is a power of two; rehash at load 0.5.
    public HashSet() {
        super();
        this.kind = 0; // baked by the compiler from T
        this.slots = Mem.intArray(32);
    }
    // 1 inserted, 0 already present.
    int add(T v) {
        if (this.count * 2 >= this.cap) {
            this.rehash();
        }
        int mask = this.cap - 1;
        int i = Collection.hash(this.kind, v) & mask;
        int tries = 0;
        while (true) {
            int flag = this.slots[2 * i + 1];
            if (flag == 0) {
                this.slots[2 * i] = v;
                this.slots[2 * i + 1] = 1;
                Collection.retainElem(this.kind, v);
                this.count = this.count + 1;
                return 1;
            }
            if (flag == 1 && Collection.eq(this.kind, this.slots[2 * i], v) == 1) {
                return 0;
            }
            tries = tries + 1;
            if (tries == this.cap) {
                this.rehash();
                mask = this.cap - 1;
                i = Collection.hash(this.kind, v) & mask;
                tries = 0;
            }
            i = (i + 1) & mask;
        }
    }
    int contains(T v) {
        int mask = this.cap - 1;
        int i = Collection.hash(this.kind, v) & mask;
        while (true) {
            int flag = this.slots[2 * i + 1];
            if (flag == 0) {
                return 0;
            }
            if (flag == 1 && Collection.eq(this.kind, this.slots[2 * i], v) == 1) {
                return 1;
            }
            i = (i + 1) & mask;
        }
    }
    // 1 removed, 0 absent (the bucket becomes a tombstone).
    int remove(T v) {
        int mask = this.cap - 1;
        int i = Collection.hash(this.kind, v) & mask;
        while (true) {
            int flag = this.slots[2 * i + 1];
            if (flag == 0) {
                return 0;
            }
            if (flag == 1 && Collection.eq(this.kind, this.slots[2 * i], v) == 1) {
                Collection.releaseElem(this.kind, this.slots[2 * i]);
                this.slots[2 * i + 1] = 2;
                this.count = this.count - 1;
                return 1;
            }
            i = (i + 1) & mask;
        }
    }
    void clear() {
        int i = 0;
        while (i < this.cap) {
            if (this.slots[2 * i + 1] == 1) {
                Collection.releaseElem(this.kind, this.slots[2 * i]);
            }
            this.slots[2 * i + 1] = 0;
            i = i + 1;
        }
        this.count = 0;
    }
    void rehash() {
        int oldCap = this.cap;
        *int old = this.slots;
        // size the new cap so the re-adds cannot trigger further rehashes
        int newCap = this.cap * 2;
        while (this.count * 2 >= newCap) {
            newCap = newCap * 2;
        }
        this.cap = newCap;
        this.slots = Mem.intArray(this.cap * 2);
        this.count = 0;
        int i = 0;
        while (i < oldCap) {
            if (old[2 * i + 1] == 1) {
                this.add(old[2 * i]);
            }
            i = i + 1;
        }
        // drop the old array's element references before freeing it
        i = 0;
        while (i < oldCap) {
            if (old[2 * i + 1] == 1) {
                Collection.releaseElem(this.kind, old[2 * i]);
            }
            i = i + 1;
        }
        Mem.freeInt(old);
    }
}
class HashMap<K, V> extends Collection {
    int kkind;
    int vkind;
    // 3 slots per entry: [key, flag, value]; flag 0 empty, 1 occupied,
    // 2 tombstone. Entry count is a power of two; rehash at load 0.5.
    public HashMap() {
        super();
        this.kkind = 0; // baked by the compiler from K
        this.vkind = 0; // baked by the compiler from V
        this.slots = Mem.intArray(48);
    }
    // 1 inserted, 0 updated (the old value reference is dropped; the
    // key reference is retained on insert).
    int put(K k, V v) {
        if (this.count * 2 >= this.cap) {
            this.rehash();
        }
        int mask = this.cap - 1;
        int i = Collection.hash(this.kkind, k) & mask;
        int tries = 0;
        while (true) {
            int flag = this.slots[3 * i + 1];
            if (flag == 0) {
                this.slots[3 * i] = k;
                this.slots[3 * i + 1] = 1;
                this.slots[3 * i + 2] = v;
                Collection.retainElem(this.kkind, k);
                Collection.retainElem(this.vkind, v);
                this.count = this.count + 1;
                return 1;
            }
            if (flag == 1 && Collection.eq(this.kkind, this.slots[3 * i], k) == 1) {
                Collection.releaseElem(this.vkind, this.slots[3 * i + 2]);
                this.slots[3 * i + 2] = v;
                Collection.retainElem(this.vkind, v);
                return 0;
            }
            tries = tries + 1;
            if (tries == this.cap) {
                this.rehash();
                mask = this.cap - 1;
                i = Collection.hash(this.kkind, k) & mask;
                tries = 0;
            }
            i = (i + 1) & mask;
        }
    }
    // The stored value (0 when absent; object values get a fresh
    // reference).
    V get(K k) {
        int mask = this.cap - 1;
        int i = Collection.hash(this.kkind, k) & mask;
        while (true) {
            int flag = this.slots[3 * i + 1];
            if (flag == 0) {
                return 0;
            }
            if (flag == 1 && Collection.eq(this.kkind, this.slots[3 * i], k) == 1) {
                int v = this.slots[3 * i + 2];
                Collection.retainElem(this.vkind, v);
                return v;
            }
            i = (i + 1) & mask;
        }
    }
    int contains(K k) {
        int mask = this.cap - 1;
        int i = Collection.hash(this.kkind, k) & mask;
        while (true) {
            int flag = this.slots[3 * i + 1];
            if (flag == 0) {
                return 0;
            }
            if (flag == 1 && Collection.eq(this.kkind, this.slots[3 * i], k) == 1) {
                return 1;
            }
            i = (i + 1) & mask;
        }
    }
    // 1 removed, 0 absent (the entry becomes a tombstone).
    int remove(K k) {
        int mask = this.cap - 1;
        int i = Collection.hash(this.kkind, k) & mask;
        while (true) {
            int flag = this.slots[3 * i + 1];
            if (flag == 0) {
                return 0;
            }
            if (flag == 1 && Collection.eq(this.kkind, this.slots[3 * i], k) == 1) {
                Collection.releaseElem(this.kkind, this.slots[3 * i]);
                Collection.releaseElem(this.vkind, this.slots[3 * i + 2]);
                this.slots[3 * i + 1] = 2;
                this.count = this.count - 1;
                return 1;
            }
            i = (i + 1) & mask;
        }
    }
    void clear() {
        int i = 0;
        while (i < this.cap) {
            if (this.slots[3 * i + 1] == 1) {
                Collection.releaseElem(this.kkind, this.slots[3 * i]);
                Collection.releaseElem(this.vkind, this.slots[3 * i + 2]);
            }
            this.slots[3 * i + 1] = 0;
            i = i + 1;
        }
        this.count = 0;
    }
    // The stored keys (insertion order) as a fresh List<K>.
    List<K> keys() {
        List<K> out = new List<K>();
        int i = 0;
        while (i < this.cap) {
            if (this.slots[3 * i + 1] == 1) {
                out.add(this.slots[3 * i]);
            }
            i = i + 1;
        }
        return out;
    }
    // The stored values (insertion order) as a fresh List<V>.
    List<V> values() {
        List<V> out = new List<V>();
        int i = 0;
        while (i < this.cap) {
            if (this.slots[3 * i + 1] == 1) {
                out.add(this.slots[3 * i + 2]);
            }
            i = i + 1;
        }
        return out;
    }
    void rehash() {
        int oldCap = this.cap;
        *int old = this.slots;
        // size the new cap so the re-puts cannot trigger further rehashes
        int newCap = this.cap * 2;
        while (this.count * 2 >= newCap) {
            newCap = newCap * 2;
        }
        this.cap = newCap;
        this.slots = Mem.intArray(this.cap * 3);
        this.count = 0;
        int i = 0;
        while (i < oldCap) {
            if (old[3 * i + 1] == 1) {
                this.put(old[3 * i], old[3 * i + 2]);
            }
            i = i + 1;
        }
        // drop the old array's element references before freeing it
        i = 0;
        while (i < oldCap) {
            if (old[3 * i + 1] == 1) {
                Collection.releaseElem(this.kkind, old[3 * i]);
                Collection.releaseElem(this.vkind, old[3 * i + 2]);
            }
            i = i + 1;
        }
        Mem.freeInt(old);
    }
}
class CopyOnWriteList<T> extends Collection {
    // The write lock; readers (get, contains, indexOf, …) never lock.
    int mutex;
    public CopyOnWriteList() {
        super();
        this.kind = 0; // baked by the compiler from T
        this.mutex = 0;
    }
    // Install a fresh array: the array pointer goes first, then count
    // and cap (readers load the count before the array, and x86-64
    // never reorders stores, so a concurrent mutation cannot expose an
    // inconsistent pair). The old array's element references are
    // dropped and the old array freed afterwards.
    void install(*int ns, int oldCount, int newCount) {
        *int old = this.slots;
        this.slots = ns;
        this.count = newCount;
        this.cap = newCount;
        int i = 0;
        while (i < oldCount) {
            Collection.releaseElem(this.kind, old[i]);
            i = i + 1;
        }
        Mem.freeInt(old);
    }
    // A fresh array of `cap` slots holding the first `n` elements;
    // object elements are retained (the old array's references are
    // dropped by `install`).
    *int copyOf(int cap, int n) {
        *int ns = Mem.intArray(cap);
        int i = 0;
        while (i < n) {
            ns[i] = this.slots[i];
            Collection.retainElem(this.kind, ns[i]);
            i = i + 1;
        }
        return ns;
    }
    void addLocked(T v) {
        int n = this.count;
        *int ns = this.copyOf(n + 1, n);
        Collection.retainElem(this.kind, v);
        ns[n] = v;
        this.install(ns, n, n + 1);
    }
    void insertLocked(int i, T v) {
        int n = this.count;
        if (i >= n) {
            i = n;
        }
        *int ns = this.copyOf(n + 1, n);
        int j = n - 1;
        while (j >= i) {
            ns[j + 1] = ns[j];
            j = j - 1;
        }
        Collection.retainElem(this.kind, v);
        ns[i] = v;
        this.install(ns, n, n + 1);
    }
    // The displaced element (0 when i >= size): the extra retain for it
    // is what the caller keeps once `install` drops the slot's
    // reference.
    int setLocked(int i, T v) {
        int n = this.count;
        if (i >= n) {
            return 0;
        }
        *int ns = this.copyOf(n, n);
        int old = ns[i];
        Collection.retainElem(this.kind, old);
        Collection.retainElem(this.kind, v);
        ns[i] = v;
        this.install(ns, n, n);
        return old;
    }
    // The removed element (0 when i >= size).
    int removeLocked(int i) {
        int n = this.count;
        if (i >= n) {
            return 0;
        }
        *int ns = this.copyOf(n, n);
        int old = ns[i];
        Collection.retainElem(this.kind, old);
        int j = i;
        while (j < n - 1) {
            ns[j] = ns[j + 1];
            j = j + 1;
        }
        this.install(ns, n, n - 1);
        return old;
    }
    int indexOfLocked(T v) {
        int n = this.count;
        int i = 0;
        while (i < n) {
            if (Collection.eq(this.kind, this.slots[i], v) == 1) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }
    // Append (Java `add(E)`): readers keep working on the old array
    // while the fresh one is built.
    void add(T v) {
        Sync.lock(&this.mutex);
        this.addLocked(v);
        Sync.unlock(&this.mutex);
    }
    // Insert at i (Java `add(int, E)`; the tail shifts right,
    // i >= size appends).
    void insert(int i, T v) {
        Sync.lock(&this.mutex);
        this.insertLocked(i, v);
        Sync.unlock(&this.mutex);
    }
    // Write the slot; returns the displaced element (0 when i >= size).
    T set(int i, T v) {
        Sync.lock(&this.mutex);
        int old = this.setLocked(i, v);
        Sync.unlock(&this.mutex);
        return old;
    }
    // Remove at i; returns the removed element (0 when i >= size).
    T remove(int i) {
        Sync.lock(&this.mutex);
        int old = this.removeLocked(i);
        Sync.unlock(&this.mutex);
        return old;
    }
    // Java `remove(Object)`: drop the first occurrence of v. 1 removed,
    // 0 absent.
    int removeObject(T v) {
        Sync.lock(&this.mutex);
        int i = this.indexOfLocked(v);
        int r = 0;
        if (i != -1) {
            this.removeLocked(i);
            r = 1;
        }
        Sync.unlock(&this.mutex);
        return r;
    }
    // Override of the base in-place clear: install a fresh empty array.
    void clear() {
        Sync.lock(&this.mutex);
        int n = this.count;
        *int ns = Mem.intArray(16);
        this.install(ns, n, 0);
        Sync.unlock(&this.mutex);
    }
    T get(int i) {
        int n = this.count;
        if (i >= n) {
            return 0;
        }
        *int a = this.slots;
        int v = a[i];
        Collection.retainElem(this.kind, v);
        return v;
    }
    int contains(T v) {
        int n = this.count;
        *int a = this.slots;
        int i = 0;
        while (i < n) {
            if (Collection.eq(this.kind, a[i], v) == 1) {
                return 1;
            }
            i = i + 1;
        }
        return 0;
    }
    // The first index of v, or -1 when absent.
    int indexOf(T v) {
        int n = this.count;
        *int a = this.slots;
        int i = 0;
        while (i < n) {
            if (Collection.eq(this.kind, a[i], v) == 1) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }
    // The last index of v, or -1 when absent.
    int lastIndexOf(T v) {
        int n = this.count;
        *int a = this.slots;
        int i = n - 1;
        while (i >= 0) {
            if (Collection.eq(this.kind, a[i], v) == 1) {
                return i;
            }
            i = i - 1;
        }
        return -1;
    }
    // The COW "iterator": a fresh List<T> holding the elements as of
    // now; later mutations install new arrays and do not affect it.
    List<T> snapshot() {
        int n = this.count;
        *int a = this.slots;
        List<T> out = new List<T>();
        int i = 0;
        while (i < n) {
            out.add(a[i]);
            i = i + 1;
        }
        return out;
    }
    // Elements joined by sep: strings verbatim, the rest via itoa.
    string join(string sep) {
        int n = this.count;
        *int a = this.slots;
        string out = "";
        int i = 0;
        while (i < n) {
            int v = a[i];
            if (i > 0) {
                out = str.concat(out, sep);
            }
            if (this.kind == 1) {
                out = str.concat(out, v);
            } else {
                out = str.concat(out, str.itoa(v));
            }
            i = i + 1;
        }
        return out;
    }
}
