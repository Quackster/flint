// std/mem — reference-count helpers for the collections' unsafe core
// (import std.Mem).
//
// Buffers are declared with typed syntax now (`int buf[n]`, `byte buf[n]`,
// `string s[n]`): each declaration owns a fresh zero-filled heap value
// that frees itself when it goes out of scope. There is no `alloc` or
// `free` anymore; ownership (`T x = y` moves, calls borrow, `x.move()`
// clones) is checked at compile time — see the Memory model docs.
//
// Usage:
//   import std.Mem;
//   int fib[10];          // owns 10 zero-filled slots
//   fib[0] = 0; fib[1] = 1;
//   ...                   // freed automatically at scope end
package std;
class Mem {
    // Bump the refcount of a class object (the caller keeps its own
    // reference; the object now survives one extra drop).
    static int retain(int o) { return mem.retain(o); }
    // Drop one reference to a class object (a plain refcount decrement).
    static void release(int o) { mem.release(o); }
}
