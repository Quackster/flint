// std/rand — a xorshift64 PRNG seeded from the `rand.next()` builtin.
//
// Usage:
//   import std.Rand;
//   Rand.init(42);
//   int x = Rand.range(10, 20);   // in [10, 20)
package std;
class Rand {
    static int state;
    static void init(int s) {
        Rand.state = s == 0 ? 88172645463325252 : s;
    }
    // xorshift64; lazily seeds from the hardware builtin on first use.
    static int next() {
        int x = Rand.state;
        if (x == 0) {
            x = rand.next();
        }
        x = x ^ (x << 13);
        x = x ^ (x >> 7);
        x = x ^ (x << 17);
        Rand.state = x;
        return x;
    }
    // Uniform in [lo, hi).
    static int range(int lo, int hi) {
        if (lo >= hi) {
            return lo;
        }
        int span = hi - lo;
        int r = Rand.next() % span;
        if (r < 0) {
            r = r + span;
        }
        return lo + r;
    }
    // 0 or 1.
    static int coin() { return Rand.next() & 1; }
    // Fisher-Yates shuffle (in place).
    static void shuffle(int a[]) {
        int n = len(a);
        int i = n - 1;
        while (i > 0) {
            int j = Rand.range(0, i + 1);
            int t = a[i];
            a[i] = a[j];
            a[j] = t;
            i = i - 1;
        }
    }
    // A uniformly random element of a (0 for an empty array).
    static int pick(int a[]) {
        int n = len(a);
        if (n == 0) {
            return 0;
        }
        return a[Rand.range(0, n)];
    }
    // n random bytes, NUL-terminated.
    static string bytes(int n) {
        string out = alloc(n + 1);
        int i = 0;
        while (i < n) {
            sys.byteStore(out + i, Rand.next() & 255);
            i = i + 1;
        }
        sys.byteStore(out + n, 0);
        return out;
    }
    // n random lowercase hex characters.
    static string hexId(int n) {
        string out = "";
        int i = 0;
        while (i < n) {
            out = out + str.substring("0123456789abcdef", Rand.range(0, 16), 1);
            i = i + 1;
        }
        return out;
    }
    // n random lowercase letters.
    static string randString(int n) {
        string out = "";
        int i = 0;
        while (i < n) {
            out = out + str.substring("abcdefghijklmnopqrstuvwxyz", Rand.range(0, 26), 1);
            i = i + 1;
        }
        return out;
    }
}
